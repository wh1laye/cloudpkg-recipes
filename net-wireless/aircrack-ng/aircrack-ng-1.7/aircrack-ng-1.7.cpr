PACKAGE=aircrack-ng
VERSION=1.7
CATEGORY=net-wireless
DESCRIPTION="Wireless security auditing tools"
HOMEPAGE="https://example.com/aircrack-ng"
LICENSE="GPL-2"
SRC_URI="https://example.com/aircrack-ng/aircrack-ng-1.7.tar.gz -> aircrack-ng-1.7.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
