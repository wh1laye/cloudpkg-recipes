PACKAGE=xz
VERSION=5.4.5
CATEGORY=.
DESCRIPTION="XZ compression utilities"
HOMEPAGE="https://tukaani.org/xz/"
LICENSE="LGPL-2.1"
SRC_URI="https://tukaani.org/xz/xz-5.4.5.tar.gz -> xz-5.4.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}