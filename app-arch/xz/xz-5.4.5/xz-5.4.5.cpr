PACKAGE=xz
VERSION=5.4.5
CATEGORY=app-arch
DESCRIPTION="XZ compression"
HOMEPAGE="https://xz.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://downloads.xz.org/xz-5.4.5.tar.gz -> xz-5.4.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
