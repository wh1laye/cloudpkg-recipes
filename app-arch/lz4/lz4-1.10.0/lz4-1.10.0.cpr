PACKAGE=lz4
VERSION=1.10.0
CATEGORY=.
DESCRIPTION="LZ4 compression"
HOMEPAGE="https://lz4.github.io/lz4/"
LICENSE="BSD-3"
SRC_URI="https://github.com/lz4/lz4/archive/refs/tags/v1.10.0.tar.gz -> lz4-1.10.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
