PACKAGE=tar
VERSION=1.35
CATEGORY=.
DESCRIPTION="GNU tar archive utility"
HOMEPAGE="https://www.gnu.org/software/tar/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/tar/tar-1.35.tar.gz -> tar-1.35.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}