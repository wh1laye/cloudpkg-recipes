PACKAGE=p7zip
VERSION=17.05
CATEGORY=app-arch
DESCRIPTION="File archiver with high compression ratio (7z format)"
HOMEPAGE="https://www.7-zip.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://downloads.sourceforge.net/project/p7zip/p7zip/${VERSION}/p7zip_${VERSION}_src_all.tar.bz2 -> ${P}-${VERSION}.tar.bz2"
DEPEND="dev-lang/yasm"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_compile() {
    cd CPP/7zip && make -j$(nproc) all3 || die "Compilation failed"
    cd ../..
}
src_install() {
    cd CPP/7zip && make DEST_HOME="${D}/usr" install || die "Installation failed"
    cd ../..
    insinto /usr/share/man/man1
    doins man/7z.1 man/7za.1 man/7zr.1
    dodoc README DOC/License.txt
}
pkg_postinst() {
    einfo "p7zip installed"
    einfo "Available commands: 7z, 7za, 7zr"
}
