PACKAGE=apk-tools
VERSION=2.14.4
CATEGORY=.
DESCRIPTION="Alpine package tools"
HOMEPAGE="https://gitlab.alpinelinux.org/alpine/apk-tools"
LICENSE="GPL-2"
SRC_URI="https://gitlab.alpinelinux.org/alpine/apk-tools/-/archive/v2.14.4/apk-tools-v2.14.4.tar.gz -> apk-tools-2.14.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
