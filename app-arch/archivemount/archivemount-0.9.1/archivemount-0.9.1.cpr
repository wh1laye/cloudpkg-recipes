PACKAGE=archivemount
VERSION=0.9.1
CATEGORY=app-arch
DESCRIPTION="Mount archive files as filesystem"
HOMEPAGE="https://example.com/archivemount"
LICENSE="GPL-3"
SRC_URI="https://example.com/archivemount/archivemount-0.9.1.tar.gz -> archivemount-0.9.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
