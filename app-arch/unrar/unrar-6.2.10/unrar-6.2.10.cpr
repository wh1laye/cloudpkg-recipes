PACKAGE=unrar
VERSION=6.2.10
CATEGORY=.
DESCRIPTION="RAR file extractor"
HOMEPAGE="https://www.rarlab.com/"
LICENSE="Freeware"
SRC_URI="https://www.rarlab.com/rar/unrarsrc-6.2.10.tar.gz -> unrar-6.2.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
