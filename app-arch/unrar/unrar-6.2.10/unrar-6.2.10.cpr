PACKAGE=unrar
VERSION=6.2.10
CATEGORY=app-arch
DESCRIPTION="Extract files from RAR archives"
HOMEPAGE="https://www.rarlab.com/"
LICENSE="UnRAR"
SRC_URI="https://www.rarlab.com/rar/unrarsrc-${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
RESTRICT="strip"
src_compile() {
    make -j$(nproc) -f makefile.unix || die "Compilation failed"
}
src_install() {
    dobin unrar
    insinto /usr/share/man/man1
    doins unrar.1
    dodoc license.txt readme.txt
}
pkg_postinst() {
    einfo "unrar installed"
    einfo "Usage: unrar x archive.rar"
}
