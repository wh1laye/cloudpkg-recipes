PACKAGE=fossil
VERSION=2.22
CATEGORY=dev-vcs
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://fossil-scm.org/"
LICENSE="BSD-2"
SRC_URI="https://fossil-scm.org/home/uv/fossil-src-2.22.tar.gz -> fossil-2.22.tar.gz"
DEPEND="sys-libs/zlib sys-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl --with-zlib"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
