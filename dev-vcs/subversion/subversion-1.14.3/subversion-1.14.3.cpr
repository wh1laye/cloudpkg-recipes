PACKAGE=subversion
VERSION=1.14.3
CATEGORY=dev-vcs
DESCRIPTION="Subversion version control system"
HOMEPAGE="https://subversion.apache.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.apache.org/subversion/subversion-1.14.3.tar.bz2 -> subversion-1.14.3.tar.bz2"
DEPEND="dev-libs/apr dev-libs/apr-util sys-libs/sqlite"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
