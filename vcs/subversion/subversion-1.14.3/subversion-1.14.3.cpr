PACKAGE=subversion
VERSION=1.14.3
CATEGORY=.
DESCRIPTION="Subversion version control system"
HOMEPAGE="https://subversion.apache.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.apache.org/subversion/subversion-1.14.3.tar.bz2 -> subversion-1.14.3.tar.bz2"
DEPEND="dev-libs/apr dev-libs/apr-util sys-libs/sqlite"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
