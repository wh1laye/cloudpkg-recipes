PACKAGE=caddy
VERSION=2.7.6
CATEGORY=www-servers
DESCRIPTION="Fast, cross-platform HTTP/2 web server"
HOMEPAGE="https://caddyserver.com/"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/caddyserver/caddy/releases/download/v2.7.6/caddy_2.7.6_linux_amd64.tar.gz -> caddy-2.7.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "caddy installed successfully"
}
