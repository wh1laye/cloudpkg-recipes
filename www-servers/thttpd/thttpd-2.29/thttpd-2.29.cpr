PACKAGE=thttpd
VERSION=2.29
CATEGORY=www-servers
DESCRIPTION="Tiny/turbo/throttling HTTP server"
HOMEPAGE="https://acme.com/software/thttpd/"
LICENSE="BSD-4"
SRC_URI="https://acme.com/software/thttpd/thttpd-2.29.tar.gz -> thttpd-2.29.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "thttpd installed successfully"
}
