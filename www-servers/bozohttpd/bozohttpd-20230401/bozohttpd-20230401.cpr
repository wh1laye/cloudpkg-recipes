PACKAGE=bozohttpd
VERSION=20230401
CATEGORY=www-servers
DESCRIPTION="Single-tasking HTTP server"
HOMEPAGE="https://www.eterna.com.ar/bozohttpd/"
LICENSE="BSD-2"
SRC_URI="https://www.eterna.com.ar/bozohttpd/bozohttpd-20230401.tar.gz -> bozohttpd-20230401.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "bozohttpd installed successfully"
}
