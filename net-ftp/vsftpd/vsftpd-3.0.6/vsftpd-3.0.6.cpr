PACKAGE=vsftpd
VERSION=3.0.6
CATEGORY=net-ftp
DESCRIPTION="Very Secure FTP Daemon"
HOMEPAGE="https://security.appspot.com/vsftpd.html"
LICENSE="GPL-2"
SRC_URI="https://security.appspot.com/downloads/vsftpd-3.0.6.tar.gz -> vsftpd-3.0.6.tar.gz"
DEPEND="sys-libs/pam dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
