PACKAGE=cdrtools
VERSION=1.5.0
CATEGORY=app-cdr
DESCRIPTION="CD/DVD recording tools"
HOMEPAGE="https://example.com/cdrtools"
LICENSE=""CDDL-1.0""
SRC_URI="https://example.com/cdrtools/cdrtools-1.5.0.tar.gz -> cdrtools-1.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
