PACKAGE=cdrtools
VERSION=3.02a09
CATEGORY=app-cdr
DESCRIPTION="CD/DVD recording tools"
HOMEPAGE="https://cdrtools.sourceforge.io/"
LICENSE="CDDL-1.0"
SRC_URI="https://downloads.sourceforge.net/project/cdrtools/aoe/cdrtools-3.02a09.tar.gz -> cdrtools-3.02a09.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "cdrtools installed successfully"
}
