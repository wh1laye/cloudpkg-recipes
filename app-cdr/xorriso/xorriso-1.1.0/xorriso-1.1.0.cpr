PACKAGE=xorriso
VERSION=1.1.0
CATEGORY=app-cdr
DESCRIPTION="ISO9660 Rock Ridge filesystem manipulator"
HOMEPAGE="https://example.com/xorriso"
LICENSE=""GPL-3""
SRC_URI="https://example.com/xorriso/xorriso-1.1.0.tar.gz -> xorriso-1.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
