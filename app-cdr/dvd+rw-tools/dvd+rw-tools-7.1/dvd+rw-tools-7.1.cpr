PACKAGE=dvd+rw-tools
VERSION=7.1
CATEGORY=app-cdr
DESCRIPTION="DVD+RW tools"
HOMEPAGE="https://fy.chalmers.se/~appro/linux/DVD+RW/"
LICENSE="GPL-2"
SRC_URI="https://fy.chalmers.se/~appro/linux/DVD+RW/dvd+rw-tools-7.1.tar.gz -> dvd+rw-tools-7.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "dvd+rw-tools installed successfully"
}
