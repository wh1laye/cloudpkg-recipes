PACKAGE=openvpn
VERSION=2.6.9
CATEGORY=net-vpn
DESCRIPTION="Open source VPN solution"
HOMEPAGE="https://openvpn.net/"
LICENSE="GPL-2"
SRC_URI="https://swupdate.openvpn.org/community/releases/openvpn-2.6.9.tar.gz -> openvpn-2.6.9.tar.gz"
DEPEND="dev-libs/openssl sys-libs/pam"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
