PACKAGE=wireguard
VERSION=1.0.20210914
CATEGORY=net-vpn
DESCRIPTION="Fast and modern VPN"
HOMEPAGE="https://www.wireguard.com/"
LICENSE="GPL-2"
SRC_URI="https://git.zx2c4.com/wireguard-tools/snapshot/wireguard-tools-1.0.20210914.tar.xz -> wireguard-1.0.20210914.tar.xz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
