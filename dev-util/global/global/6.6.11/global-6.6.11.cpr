PACKAGE=global
VERSION=6.6.11
CATEGORY=.
DESCRIPTION="Source code tagging system"
HOMEPAGE="https://www.gnu.org/software/global/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/global/global-6.6.11.tar.gz -> global-6.6.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
