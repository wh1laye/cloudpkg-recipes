PACKAGE=autoconf
VERSION=2.71
CATEGORY=dev-util
DESCRIPTION="GNU autoconf"
HOMEPAGE="https://example.com/autoconf"
LICENSE="GPL-3"
SRC_URI="https://example.com/autoconf/autoconf-2.71.tar.gz -> autoconf-2.71.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
