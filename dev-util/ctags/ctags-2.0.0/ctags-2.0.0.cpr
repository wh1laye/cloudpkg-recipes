PACKAGE=ctags
VERSION=2.0.0
CATEGORY=dev-util
DESCRIPTION="Generate tag files for source code"
HOMEPAGE="https://example.com/ctags"
LICENSE=""GPL-2""
SRC_URI="https://example.com/ctags/ctags-2.0.0.tar.gz -> ctags-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
