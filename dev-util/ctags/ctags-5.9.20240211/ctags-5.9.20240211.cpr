PACKAGE=ctags
VERSION=5.9.20240211
CATEGORY=dev-util
DESCRIPTION="Generate tag files for source code"
HOMEPAGE="https://ctags.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/ctags/ctags/5.9.20240211/ctags-5.9.20240211.tar.gz -> ctags-5.9.20240211.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
