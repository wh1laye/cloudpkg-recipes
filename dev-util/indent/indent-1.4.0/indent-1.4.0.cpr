PACKAGE=indent
VERSION=1.4.0
CATEGORY=dev-util
DESCRIPTION="C code formatter"
HOMEPAGE="https://example.com/indent"
LICENSE=""GPL-3""
SRC_URI="https://example.com/indent/indent-1.4.0.tar.gz -> indent-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
