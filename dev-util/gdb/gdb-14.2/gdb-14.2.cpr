PACKAGE=gdb
VERSION=14.2
CATEGORY=dev-util
DESCRIPTION="GNU Debugger"
HOMEPAGE="https://www.gnu.org/software/gdb/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/gdb/gdb-14.2.tar.xz -> gdb-14.2.tar.xz"
DEPEND="sys-libs/ncurses dev-libs/expat"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-python=python3"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
