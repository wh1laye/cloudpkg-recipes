PACKAGE=gdb
VERSION=1.4.0
CATEGORY=dev-util
DESCRIPTION="GNU Debugger"
HOMEPAGE="https://example.com/gdb"
LICENSE=""GPL-3""
SRC_URI="https://example.com/gdb/gdb-1.4.0.tar.gz -> gdb-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
