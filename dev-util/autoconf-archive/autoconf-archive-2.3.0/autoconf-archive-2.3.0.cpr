PACKAGE=autoconf-archive
VERSION=2.3.0
CATEGORY=dev-util
DESCRIPTION="GNU Autoconf Macro Archive"
HOMEPAGE="https://example.com/autoconf-archive"
LICENSE=""GPL-3""
SRC_URI="https://example.com/autoconf-archive/autoconf-archive-2.3.0.tar.gz -> autoconf-archive-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
