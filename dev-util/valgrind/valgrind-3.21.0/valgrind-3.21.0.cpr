PACKAGE=valgrind
VERSION=3.21.0
CATEGORY=dev-util
DESCRIPTION="Memory debugging and profiling tool"
HOMEPAGE="https://www.valgrind.org/"
LICENSE="GPL-2"
SRC_URI="https://sourceware.org/pub/valgrind/valgrind-3.21.0.tar.bz2 -> valgrind-3.21.0.tar.bz2"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
