PACKAGE=ltrace
VERSION=2.3.0
CATEGORY=dev-util
DESCRIPTION="Library call tracer"
HOMEPAGE="https://example.com/ltrace"
LICENSE=""GPL-2""
SRC_URI="https://example.com/ltrace/ltrace-2.3.0.tar.gz -> ltrace-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
