PACKAGE=ltrace
VERSION=0.7.3
CATEGORY=dev-util
DESCRIPTION="Library call tracer"
HOMEPAGE="https://www.ltrace.org/"
LICENSE="GPL-2"
SRC_URI="https://www.ltrace.org/files/ltrace-0.7.3.tar.gz -> ltrace-0.7.3.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
