PACKAGE=strace
VERSION=1.3.0
CATEGORY=dev-util
DESCRIPTION="System call tracer"
HOMEPAGE="https://example.com/strace"
LICENSE=""LGPL-2.1""
SRC_URI="https://example.com/strace/strace-1.3.0.tar.gz -> strace-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
