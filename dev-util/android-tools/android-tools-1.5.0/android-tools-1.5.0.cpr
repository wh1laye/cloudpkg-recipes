PACKAGE=android-tools
VERSION=1.5.0
CATEGORY=dev-util
DESCRIPTION="Android SDK tools"
HOMEPAGE="https://example.com/android-tools"
LICENSE=""Apache-2.0""
SRC_URI="https://example.com/android-tools/android-tools-1.5.0.tar.gz -> android-tools-1.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
