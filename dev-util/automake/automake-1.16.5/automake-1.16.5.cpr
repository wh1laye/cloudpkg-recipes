PACKAGE=automake
VERSION=1.16.5
CATEGORY=dev-util
DESCRIPTION="GNU automake"
HOMEPAGE="https://example.com/automake"
LICENSE="GPL-2"
SRC_URI="https://example.com/automake/automake-1.16.5.tar.gz -> automake-1.16.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
