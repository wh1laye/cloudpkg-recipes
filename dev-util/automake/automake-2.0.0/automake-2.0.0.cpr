PACKAGE=automake
VERSION=2.0.0
CATEGORY=dev-util
DESCRIPTION="GNU automake"
HOMEPAGE="https://example.com/automake"
LICENSE=""GPL-2""
SRC_URI="https://example.com/automake/automake-2.0.0.tar.gz -> automake-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
