PACKAGE=astyle
VERSION=1.2.0
CATEGORY=dev-util
DESCRIPTION="Source code beautifier"
HOMEPAGE="https://example.com/astyle"
LICENSE=""LGPL-3""
SRC_URI="https://example.com/astyle/astyle-1.2.0.tar.gz -> astyle-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
