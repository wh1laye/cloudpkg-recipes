PACKAGE=atf
VERSION=2.3.0
CATEGORY=dev-util
DESCRIPTION="Automated Testing Framework"
HOMEPAGE="https://example.com/atf"
LICENSE=""BSD-2""
SRC_URI="https://example.com/atf/atf-2.3.0.tar.gz -> atf-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
