PACKAGE=atf
VERSION=0.21
CATEGORY=dev-util
DESCRIPTION="Automated Testing Framework"
HOMEPAGE="https://example.com/atf"
LICENSE="BSD-2"
SRC_URI="https://example.com/atf/atf-0.21.tar.gz -> atf-0.21.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
