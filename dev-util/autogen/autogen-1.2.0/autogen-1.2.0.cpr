PACKAGE=autogen
VERSION=1.2.0
CATEGORY=dev-util
DESCRIPTION="Automated text file generator"
HOMEPAGE="https://example.com/autogen"
LICENSE=""GPL-3""
SRC_URI="https://example.com/autogen/autogen-1.2.0.tar.gz -> autogen-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
