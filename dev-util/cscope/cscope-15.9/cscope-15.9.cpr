PACKAGE=cscope
VERSION=15.9
CATEGORY=dev-util
DESCRIPTION="Interactive C symbol cross-reference"
HOMEPAGE="http://cscope.sourceforge.net/"
LICENSE="BSD-3"
SRC_URI="https://downloads.sourceforge.net/project/cscope/cscope/15.9/cscope-15.9.tar.gz -> cscope-15.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
