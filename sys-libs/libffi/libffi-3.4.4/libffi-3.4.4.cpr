PACKAGE=libffi
VERSION=3.4.4
CATEGORY=.
DESCRIPTION="Foreign Function Interface library"
HOMEPAGE="https://sourceware.org/libffi/"
LICENSE="MIT"
SRC_URI="https://github.com/libffi/libffi/releases/download/v3.4.4/libffi-3.4.4.tar.gz -> libffi-3.4.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}