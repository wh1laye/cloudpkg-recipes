PACKAGE=libacl
VERSION=2.3.1
CATEGORY=.
DESCRIPTION="ACL library"
HOMEPAGE="https://savannah.nongnu.org/projects/acl"
LICENSE="LGPL-2.1"
SRC_URI="https://download.savannah.gnu.org/releases/acl/libacl-2.3.1.tar.gz -> libacl-2.3.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
