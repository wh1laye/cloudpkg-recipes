PACKAGE=libidn2
VERSION=2.3.4
CATEGORY=.
DESCRIPTION="Internationalized Domain Names library"
HOMEPAGE="https://www.gnu.org/software/libidn/"
LICENSE="LGPL-3"
SRC_URI="https://ftp.gnu.org/gnu/libidn/libidn2-2.3.4.tar.gz -> libidn2-2.3.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
