PACKAGE=cracklib
VERSION=2.9.11
CATEGORY=.
DESCRIPTION="Password checking library"
HOMEPAGE="https://github.com/cracklib/cracklib"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/cracklib/cracklib/archive/refs/tags/v2.9.11.tar.gz -> cracklib-2.9.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
