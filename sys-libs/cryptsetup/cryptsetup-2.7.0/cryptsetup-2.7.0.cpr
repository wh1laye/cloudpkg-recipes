PACKAGE=cryptsetup
VERSION=2.7.0
CATEGORY=.
DESCRIPTION="Disk encryption support - LUKS"
HOMEPAGE="https://gitlab.com/cryptsetup/cryptsetup"
LICENSE="GPL-2"
SRC_URI="https://kernel.org/pub/linux/utils/cryptsetup/v2.7/cryptsetup-2.7.0.tar.gz -> cryptsetup-2.7.0.tar.gz"
DEPEND="sys-libs/libdevmapper sys-libs/popt"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --with-crypto-backend=openssl
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}