PACKAGE=libpsl
VERSION=0.21.2
CATEGORY=.
DESCRIPTION="Public Suffix List library"
HOMEPAGE="https://github.com/rockdaboot/libpsl"
LICENSE="MIT"
SRC_URI="https://github.com/rockdaboot/libpsl/releases/download/libpsl-0.21.2/libpsl-0.21.2.tar.gz -> libpsl-0.21.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
