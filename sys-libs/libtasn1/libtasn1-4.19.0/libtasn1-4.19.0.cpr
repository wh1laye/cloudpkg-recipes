PACKAGE=libtasn1
VERSION=4.19.0
CATEGORY=.
DESCRIPTION="ASN.1 library"
HOMEPAGE="https://www.gnu.org/software/libtasn1/"
LICENSE="LGPL-2.1"
SRC_URI="https://ftp.gnu.org/gnu/libtasn1/libtasn1-4.19.0.tar.gz -> libtasn1-4.19.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
