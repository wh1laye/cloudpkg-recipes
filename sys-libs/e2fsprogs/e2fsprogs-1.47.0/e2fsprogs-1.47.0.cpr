PACKAGE=e2fsprogs
VERSION=1.47.0
CATEGORY=.
DESCRIPTION="Ext2/3/4 filesystem utilities"
HOMEPAGE="https://e2fsprogs.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v1.47.0/e2fsprogs-1.47.0.tar.gz -> e2fsprogs-1.47.0.tar.gz"
DEPEND="sys-libs/blkid"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --with-root-prefix=""
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}