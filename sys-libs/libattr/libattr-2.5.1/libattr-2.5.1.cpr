PACKAGE=libattr
VERSION=2.5.1
CATEGORY=.
DESCRIPTION="Extended attributes library"
HOMEPAGE="https://savannah.nongnu.org/projects/attr"
LICENSE="LGPL-2.1"
SRC_URI="https://download.savannah.gnu.org/releases/attr/libattr-2.5.1.tar.gz -> libattr-2.5.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
