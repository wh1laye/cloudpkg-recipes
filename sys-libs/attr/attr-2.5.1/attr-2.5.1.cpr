PACKAGE=attr
VERSION=2.5.1
CATEGORY=sys-libs
DESCRIPTION="Extended attribute support"
HOMEPAGE="https://example.com/attr"
LICENSE="LGPL-2.1"
SRC_URI="https://example.com/attr/attr-2.5.1.tar.gz -> attr-2.5.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
