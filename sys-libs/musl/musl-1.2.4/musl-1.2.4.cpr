PACKAGE=musl
VERSION=1.2.4
CATEGORY=sys-libs
DESCRIPTION="Lightweight C standard library"
HOMEPAGE="https://musl.libc.org/"
LICENSE="MIT"
SRC_URI="https://musl.libc.org/releases/musl-1.2.4.tar.gz -> musl-1.2.4.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
