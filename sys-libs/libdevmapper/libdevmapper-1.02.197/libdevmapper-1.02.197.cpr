PACKAGE=libdevmapper
VERSION=1.02.197
CATEGORY=.
DESCRIPTION="Device mapper library"
HOMEPAGE="https://git.kernel.org/pub/scm/linux/storage/multipath-tools/libdevmapper.git"
LICENSE="LGPL-2.1"
SRC_URI="https://www.kernel.org/pub/linux/storage/multipath-tools/libdevmapper-1.02.197.tar.gz -> libdevmapper-1.02.197.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
