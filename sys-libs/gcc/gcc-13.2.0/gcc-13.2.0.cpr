PACKAGE=gcc
VERSION=13.2.0
CATEGORY=.
DESCRIPTION="GNU Compiler Collection"
HOMEPAGE="https://gcc.gnu.org/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/gcc/gcc-13.2.0/gcc-13.2.0.tar.gz -> gcc-13.2.0.tar.gz"
DEPEND="sys-libs/binutils sys-libs/glibc"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --with-sysroot=/ --enable-languages=c,c++
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}