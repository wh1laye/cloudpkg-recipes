PACKAGE=libsepol
VERSION=3.5
CATEGORY=.
DESCRIPTION="SELinux policy library"
HOMEPAGE="https://github.com/SELinuxProject/selinux"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/SELinuxProject/selinux/releases/download/3.5/libsepol-3.5.tar.gz -> libsepol-3.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
