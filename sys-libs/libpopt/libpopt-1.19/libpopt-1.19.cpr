PACKAGE=libpopt
VERSION=1.19
CATEGORY=.
DESCRIPTION="Command line parsing library"
HOMEPAGE="http://rpm5.org/files/popt/"
LICENSE="MIT"
SRC_URI="https://rpm5.org/files/popt/popt-1.19.tar.gz -> libpopt-1.19.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
