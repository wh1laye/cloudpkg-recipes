PACKAGE=libpopt
VERSION=popt-1.19
CATEGORY=.
DESCRIPTION="Command line parsing library"
HOMEPAGE="http"
LICENSE="//rpm5.org/files/popt/"
SRC_URI="MIT -> libpopt-popt-1.19.tar.gz"
DEPEND="https://rpm5.org/files/popt/popt-1.19.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
