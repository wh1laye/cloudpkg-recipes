PACKAGE=libnftnl
VERSION=1.2.6
CATEGORY=.
DESCRIPTION="Netfilter library"
HOMEPAGE="https://netfilter.org/projects/libnftnl/"
LICENSE="GPL-2"
SRC_URI="https://netfilter.org/projects/libnftnl/files/libnftnl-1.2.6.tar.gz -> libnftnl-1.2.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
