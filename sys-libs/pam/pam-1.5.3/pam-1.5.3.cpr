PACKAGE=pam
VERSION=1.5.3
CATEGORY=.
DESCRIPTION="Pluggable Authentication Modules"
HOMEPAGE="http://www.linux-pam.org/"
LICENSE="BSD-3"
SRC_URI="https://github.com/linux-pam/linux-pam/releases/download/v1.5.3/Linux-PAM-1.5.3.tar.gz -> Linux-PAM-1.5.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --libdir=/usr/lib64
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}