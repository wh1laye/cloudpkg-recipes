PACKAGE=libaudit
VERSION=3.1.2
CATEGORY=.
DESCRIPTION="Audit library"
HOMEPAGE="https://github.com/linux-audit/audit-userspace"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/linux-audit/audit-userspace/archive/refs/tags/v3.1.2.tar.gz -> libaudit-3.1.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
