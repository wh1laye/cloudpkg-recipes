PACKAGE=libnfnetlink
VERSION=1.0.2
CATEGORY=.
DESCRIPTION="Netfilter netlink library"
HOMEPAGE="https://netfilter.org/projects/libnfnetlink/"
LICENSE="GPL-2"
SRC_URI="https://netfilter.org/projects/libnfnetlink/files/libnfnetlink-1.0.2.tar.gz -> libnfnetlink-1.0.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
