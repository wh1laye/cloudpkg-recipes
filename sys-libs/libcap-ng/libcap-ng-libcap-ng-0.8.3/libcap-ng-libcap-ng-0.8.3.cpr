PACKAGE=libcap-ng
VERSION=libcap-ng-0.8.3
CATEGORY=.
DESCRIPTION="Capabilities library"
HOMEPAGE="https"
LICENSE="//github.com/stevegrubb/libcap-ng"
SRC_URI="LGPL-2.1 -> libcap-ng-libcap-ng-0.8.3.tar.gz"
DEPEND="https://github.com/stevegrubb/libcap-ng/archive/refs/tags/v0.8.3.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
