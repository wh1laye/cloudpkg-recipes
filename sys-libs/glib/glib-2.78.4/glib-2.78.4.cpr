PACKAGE=glib
VERSION=2.78.4
CATEGORY=.
DESCRIPTION="GLib library"
HOMEPAGE="https://wiki.gnome.org/Projects/GLib"
LICENSE="LGPL-2.1"
SRC_URI="https://download.gnome.org/sources/glib/2.78/glib-2.78.4.tar.gz -> glib-2.78.4.tar.gz"
DEPEND="sys-libs/libffi"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    meson setup build --prefix=/usr
}
src_compile() {
    ninja -C build -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    DESTDIR="${D}" ninja -C build install || exit 1
}