PACKAGE=libmnl
VERSION=1.0.5
CATEGORY=.
DESCRIPTION="Minimalist Netlink library"
HOMEPAGE="https://netfilter.org/projects/libmnl/"
LICENSE="LGPL-2.1"
SRC_URI="https://netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.gz -> libmnl-1.0.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
