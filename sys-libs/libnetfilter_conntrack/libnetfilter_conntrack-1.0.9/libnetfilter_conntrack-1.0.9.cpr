PACKAGE=libnetfilter_conntrack
VERSION=1.0.9
CATEGORY=.
DESCRIPTION="Netfilter conntrack library"
HOMEPAGE="https://netfilter.org/projects/libnetfilter_conntrack/"
LICENSE="GPL-2"
SRC_URI="https://netfilter.org/projects/libnetfilter_conntrack/files/libnetfilter_conntrack-1.0.9.tar.gz -> libnetfilter_conntrack-1.0.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
