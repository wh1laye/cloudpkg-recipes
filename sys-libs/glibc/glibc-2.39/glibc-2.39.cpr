PACKAGE=glibc
VERSION=2.39
CATEGORY=sys-libs
DESCRIPTION="GNU C Library"
HOMEPAGE="https://www.gnu.org/software/libc/"
LICENSE="LGPL-2.1"
SRC_URI="https://ftp.gnu.org/gnu/libc/glibc-2.39.tar.gz -> glibc-2.39.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
