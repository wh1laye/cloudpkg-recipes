PACKAGE=npth
VERSION=1.6
CATEGORY=app-crypt
DESCRIPTION="New GNU Portable Threads Library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/download/GNUPG/npth/npth-1.6.tar.bz2 -> npth-1.6.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
