PACKAGE=gpgme
VERSION=1.23.2
CATEGORY=app-crypt
DESCRIPTION="GnuPG Made Easy library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/download/GNUPG/gpgme/gpgme-1.23.2.tar.bz2 -> gpgme-1.23.2.tar.bz2"
DEPEND="dev-libs/libgpg-error"
RDEPEND="dev-libs/libgpg-error"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
