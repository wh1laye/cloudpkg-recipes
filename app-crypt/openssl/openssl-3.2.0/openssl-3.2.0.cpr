PACKAGE=openssl
VERSION=3.2.0
CATEGORY=app-crypt
DESCRIPTION="SSL/TLS toolkit"
HOMEPAGE="https://openssl.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.openssl.org/openssl-3.2.0.tar.gz -> openssl-3.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
