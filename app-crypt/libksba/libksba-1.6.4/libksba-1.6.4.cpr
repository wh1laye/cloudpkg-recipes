PACKAGE=libksba
VERSION=1.6.4
CATEGORY=app-crypt
DESCRIPTION="X.509 library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-3"
SRC_URI="https://www.gnupg.org/download/GNUPG/libksba/libksba-1.6.4.tar.bz2 -> libksba-1.6.4.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
