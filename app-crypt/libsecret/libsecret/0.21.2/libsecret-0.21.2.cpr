PACKAGE=libsecret
VERSION=0.21.2
CATEGORY=.
DESCRIPTION="Library for storing and retrieving passwords"
HOMEPAGE="https://wiki.gnome.org/Projects/Libsecret"
LICENSE="LGPL-2.1"
SRC_URI="https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.2.tar.xz -> libsecret-0.21.2.tar.xz"
DEPEND="dev-libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
