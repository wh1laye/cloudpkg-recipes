PACKAGE=libgcrypt
VERSION=1.10.2
CATEGORY=app-crypt
DESCRIPTION="General purpose cryptographic library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/download/GNUPG/libgcrypt/libgcrypt-1.10.2.tar.bz2 -> libgcrypt-1.10.2.tar.bz2"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
