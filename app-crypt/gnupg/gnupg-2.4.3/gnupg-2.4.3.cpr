PACKAGE=gnupg
VERSION=2.4.3
CATEGORY=app-crypt
DESCRIPTION="GNU Privacy Guard - encryption software"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="GPL-3"
SRC_URI="https://www.gnupg.org/download/GNUPG/gpg-2.4.3.tar.bz2 -> gnupg-2.4.3.tar.bz2"
DEPEND="dev-libs/libgpg-error dev-libs/libgcrypt dev-libs/libassuan"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
