PACKAGE=iproute2
VERSION=6.7.0
CATEGORY=net-misc
DESCRIPTION="IP routing utilities"
HOMEPAGE="https://wiki.linuxfoundation.org/networking/iproute2"
LICENSE="GPL-2"
SRC_URI="https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-6.7.0.tar.gz -> iproute2-6.7.0.tar.gz"
DEPEND="sys-libs/db dev-libs/elfutils"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
