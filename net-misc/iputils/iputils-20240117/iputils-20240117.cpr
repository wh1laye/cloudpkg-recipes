PACKAGE=iputils
VERSION=20240117
CATEGORY=net-misc
DESCRIPTION="IP utilities (ping, arping, etc.)"
HOMEPAGE="https://github.com/iputils/iputils"
LICENSE="GPL-2"
SRC_URI="https://github.com/iputils/iputils/archive/refs/tags/20240117.tar.gz -> iputils-20240117.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
