PACKAGE=aws-cli
VERSION=2.15.0
CATEGORY=net-misc
DESCRIPTION="AWS Command Line Interface"
HOMEPAGE="https://example.com/aws-cli"
LICENSE="Apache-2.0"
SRC_URI="https://example.com/aws-cli/aws-cli-2.15.0.tar.gz -> aws-cli-2.15.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
