PACKAGE=tcpdump
VERSION=4.99.4
CATEGORY=net-misc
DESCRIPTION="Network packet analyzer"
HOMEPAGE="https://www.tcpdump.org/"
LICENSE="BSD-3"
SRC_URI="https://www.tcpdump.org/release/tcpdump-4.99.4.tar.gz -> tcpdump-4.99.4.tar.gz"
DEPEND="dev-libs/libpcap"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
