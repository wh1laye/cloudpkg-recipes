PACKAGE=telnet
VERSION=0.17
CATEGORY=net-misc
DESCRIPTION="Telnet client"
HOMEPAGE="https://tracker.debian.org/pkg/telnet"
LICENSE="BSD-3"
SRC_URI="https://downloads.sourceforge.net/project/telnet/telnet/0.17/telnet-0.17.tar.gz -> telnet-0.17.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
