PACKAGE=netcat
VERSION=1.22
CATEGORY=net-misc
DESCRIPTION="Network utility for reading/writing network connections"
HOMEPAGE="https://netcat.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/netcat/netcat/1.22/netcat-1.22.tar.gz -> netcat-1.22.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
