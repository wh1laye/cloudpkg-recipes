PACKAGE=net-tools
VERSION=2.10
CATEGORY=net-misc
DESCRIPTION="Network utilities (ifconfig, netstat, etc.)"
HOMEPAGE="https://net-tools.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/net-tools/net-tools-2.10.tar.gz -> net-tools-2.10.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
