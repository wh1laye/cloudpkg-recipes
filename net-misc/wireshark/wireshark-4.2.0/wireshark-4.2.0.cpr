PACKAGE=wireshark
VERSION=4.2.0
CATEGORY=net-misc
DESCRIPTION="Network protocol analyzer"
HOMEPAGE="https://www.wireshark.org/"
LICENSE="GPL-2"
SRC_URI="https://www.wireshark.org/download/src/all-versions/wireshark-4.2.0.tar.xz -> wireshark-4.2.0.tar.xz"
DEPEND="dev-libs/glib dev-libs/libpcap dev-libs/c-ares"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--disable-qt --disable-gui"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
