PACKAGE=arping
VERSION=2.21
CATEGORY=net-misc
DESCRIPTION="ARP level ping utility"
HOMEPAGE="https://example.com/arping"
LICENSE="GPL-2"
SRC_URI="https://example.com/arping/arping-2.21.tar.gz -> arping-2.21.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
