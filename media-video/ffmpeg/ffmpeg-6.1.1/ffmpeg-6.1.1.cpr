PACKAGE=ffmpeg
VERSION=6.1.1
CATEGORY=media-video
DESCRIPTION="Complete solution to record, convert and stream audio and video"
HOMEPAGE="https://ffmpeg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://ffmpeg.org/releases/ffmpeg-6.1.1.tar.gz -> ffmpeg-6.1.1.tar.gz"
DEPEND="dev-libs/libx264 dev-libs/libx265 dev-libs/libvpx"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-gpl --enable-libx264 --enable-libx265 --enable-libvpx"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
