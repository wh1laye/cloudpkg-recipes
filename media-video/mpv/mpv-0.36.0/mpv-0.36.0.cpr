PACKAGE=mpv
VERSION=0.36.0
CATEGORY=media-video
DESCRIPTION="Video player based on MPlayer/mplayer2"
HOMEPAGE="https://mpv.io/"
LICENSE="GPL-2"
SRC_URI="https://github.com/mpv-player/mpv/archive/refs/tags/v0.36.0.tar.gz -> mpv-0.36.0.tar.gz"
DEPEND="dev-libs/libass dev-libs/ffmpeg"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
