PACKAGE=vlc
VERSION=3.0.20
CATEGORY=.
DESCRIPTION="VLC media player"
HOMEPAGE="https://www.videolan.org/vlc/"
LICENSE="GPL-2"
SRC_URI="https://get.videolan.org/vlc/3.0.20/vlc-3.0.20.tar.xz -> vlc-3.0.20.tar.xz"
DEPEND="media-libs/ffmpeg dev-libs/qt5"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
