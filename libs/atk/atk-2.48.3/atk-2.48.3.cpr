PACKAGE=atk
VERSION=2.48.3
CATEGORY=.
DESCRIPTION="Accessibility Toolkit"
HOMEPAGE="https://example.com/atk"
LICENSE="LGPL-2"
SRC_URI="https://example.com/atk/atk-2.48.3.tar.gz -> atk-2.48.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
