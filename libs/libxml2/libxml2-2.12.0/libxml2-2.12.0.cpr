PACKAGE=libxml2
VERSION=2.12.0
CATEGORY=.
DESCRIPTION="XML parser library"
HOMEPAGE="https://gitlab.gnome.org/GNOME/libxml2"
LICENSE="MIT"
SRC_URI="https://download.gnome.org/sources/libxml2/2.12/libxml2-2.12.0.tar.xz -> libxml2-2.12.0.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --without-python --disable-static
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
