PACKAGE=readline
VERSION=8.2
CATEGORY=.
DESCRIPTION="GNU Readline library - command line editing"
HOMEPAGE="https://tiswww.cwru.edu/php/chet/readline/rltop.html"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/readline/readline-8.2.tar.gz -> readline-8.2.tar.gz"
DEPEND="libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --disable-static
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}