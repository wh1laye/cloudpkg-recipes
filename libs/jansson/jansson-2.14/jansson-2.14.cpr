PACKAGE=jansson
VERSION=2.14
CATEGORY=.
DESCRIPTION="C library for encoding, decoding and manipulating JSON"
HOMEPAGE="https://jansson.readthedocs.io/"
LICENSE="MIT"
SRC_URI="https://github.com/akheron/jansson/releases/download/v2.14/jansson-2.14.tar.gz -> jansson-2.14.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DJANSSON_BUILD_DOCS=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5
}

src_compile() {
    cmake --build build -j"${JOBS:-1}"
}

src_install() {
    DESTDIR="${D}" cmake --install build
}
