PACKAGE=zlib
VERSION=1.3
CATEGORY=.
DESCRIPTION="Compression library"
HOMEPAGE="https://zlib.net/"
LICENSE="ZLIB"
SRC_URI="https://zlib.net/zlib-1.3.tar.gz -> zlib-1.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}