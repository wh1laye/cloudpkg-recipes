PACKAGE=json-c
VERSION=0.17
CATEGORY=.
DESCRIPTION="JSON manipulation library"
HOMEPAGE="https://github.com/json-c/json-c"
LICENSE="MIT"
SRC_URI="https://github.com/json-c/json-c/archive/refs/tags/json-c-0.17-20230511.tar.gz -> json-c-0.17.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
