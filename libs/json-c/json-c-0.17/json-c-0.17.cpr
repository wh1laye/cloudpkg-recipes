PACKAGE=json-c
VERSION=0.17
CATEGORY=.
DESCRIPTION="JSON manipulation library"
HOMEPAGE="https://github.com/json-c/json-c"
LICENSE="MIT"
SRC_URI="https://s3.amazonaws.com/json-c_releases/releases/json-c-0.17.tar.gz -> json-c-0.17.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DCMAKE_POLICY_VERSION_MINIMUM=3.5
}

src_compile() {
    cmake --build build -j"${JOBS:-1}"
}

src_install() {
    DESTDIR="${D}" cmake --install build
}
