PACKAGE=nss
VERSION=3.98
CATEGORY=.
DESCRIPTION="Mozilla Network Security Services"
HOMEPAGE="https://developer.mozilla.org/en-US/docs/Mozilla/Projects/NSS"
LICENSE="MPL-2.0"
SRC_URI="https://archive.mozilla.org/pub/security/nss/releases/NSS_3_98_RELEASE/src/nss-3.98.tar.gz -> nss-3.98.tar.gz"
DEPEND="libs/nspr"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    cd nss && make -f Makefile NSS_ENABLE_WERROR=0 BUILD_OPT=1
}
src_compile() {
    cd nss && make -j"${JOBS:-$(nproc)}" BUILD_OPT=1 || exit 1
}
src_install() {
    cd nss && make DESTDIR="${D}" BUILD_OPT=1 install || exit 1
}