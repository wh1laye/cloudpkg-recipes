PACKAGE=asio
VERSION=1.28.0
CATEGORY=.
DESCRIPTION="Asynchronous I/O library"
HOMEPAGE="https://example.com/asio"
LICENSE="BSL-1.0"
SRC_URI="https://example.com/asio/asio-1.28.0.tar.gz -> asio-1.28.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
