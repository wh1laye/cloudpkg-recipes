PACKAGE=libxslt
VERSION=1.1.38
CATEGORY=.
DESCRIPTION="XSLT library"
HOMEPAGE="https://gitlab.gnome.org/GNOME/libxslt"
LICENSE="MIT"
SRC_URI="https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.38.tar.xz -> libxslt-1.1.38.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --without-python --disable-static
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
