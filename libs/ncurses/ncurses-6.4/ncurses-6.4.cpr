PACKAGE=ncurses
VERSION=6.4
CATEGORY=.
DESCRIPTION="New curses library - terminal handling"
HOMEPAGE="https://www.gnu.org/software/ncurses/"
LICENSE="MIT"
SRC_URI="https://ftp.gnu.org/pub/gnu/ncurses/ncurses-6.4.tar.gz -> ncurses-6.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --with-shared --enable-widec --enable-pc-files
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}