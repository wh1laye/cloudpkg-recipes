PACKAGE=apr
VERSION=1.7.4
CATEGORY=.
DESCRIPTION="Apache Portable Runtime"
HOMEPAGE="https://example.com/apr"
LICENSE="Apache-2.0"
SRC_URI="https://example.com/apr/apr-1.7.4.tar.gz -> apr-1.7.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
