PACKAGE=gettext
VERSION=0.22
CATEGORY=.
DESCRIPTION="GNU Gettext - internationalization tools"
HOMEPAGE="https://www.gnu.org/software/gettext/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/gettext/gettext-0.22.tar.gz -> gettext-0.22.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --disable-static
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}