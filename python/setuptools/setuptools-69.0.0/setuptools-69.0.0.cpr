PACKAGE=setuptools
VERSION=69.0.0
CATEGORY=.
DESCRIPTION="Python package build and distribution tool"
HOMEPAGE="https://pypi.org/project/setuptools/"
LICENSE="MIT"
SRC_URI="https://files.pythonhosted.org/packages/source/s/setuptools/setuptools-69.0.0.tar.gz -> setuptools-69.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    python3 setup.py build
}

src_install() {
    python3 setup.py install --root="${D}" --prefix=/usr --single-version-externally-managed --record=/dev/null
}
