PACKAGE=pip
VERSION=24.0
CATEGORY=.
DESCRIPTION="Python package installer"
HOMEPAGE="https://pip.pypa.io/"
LICENSE="MIT"
SRC_URI="https://files.pythonhosted.org/packages/source/p/pip/pip-24.0.tar.gz -> pip-24.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    python3 setup.py build
}

src_install() {
    python3 setup.py install --root="${D}" --prefix=/usr --single-version-externally-managed --record=/dev/null
}
