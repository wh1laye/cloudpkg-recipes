PACKAGE=bioperl
VERSION=1.7.8
CATEGORY=.
DESCRIPTION="Perl tools for bioinformatics"
HOMEPAGE="https://bioperl.org/"
LICENSE="Artistic-2.0"
SRC_URI="https://github.com/bioperl/bioperl-live/archive/refs/tags/release-1-7-8.tar.gz -> bioperl-1.7.8.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
