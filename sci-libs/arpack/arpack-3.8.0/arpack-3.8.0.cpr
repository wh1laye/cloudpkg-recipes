PACKAGE=arpack
VERSION=3.8.0
CATEGORY=sci-libs
DESCRIPTION="Fortran subroutines for eigenvalue problems"
HOMEPAGE="https://example.com/arpack"
LICENSE="BSD-3"
SRC_URI="https://example.com/arpack/arpack-3.8.0.tar.gz -> arpack-3.8.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
