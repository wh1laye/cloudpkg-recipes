PACKAGE=ruby
VERSION=3.3.0
CATEGORY=dev-ruby
DESCRIPTION="Ruby programming language interpreter"
HOMEPAGE="https://www.ruby-lang.org/"
LICENSE="BSD-2"
SRC_URI="https://cache.ruby-lang.org/pub/ruby/${VERSION%.*}/ruby-${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="sys-libs/zlib sys-libs/readline dev-libs/openssl dev-libs/libyaml"
RDEPEND="${DEPEND}"
SLOT=3.3
KEYWORDS="amd64"
BUILD_FLAGS="--enable-shared --disable-install-doc --with-openssl-dir=/usr"
src_configure() {
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib/ruby/${SLOT} \
        --includedir=/usr/include/ruby-${SLOT} \
        --datarootdir=/usr/share \
        --docdir=/usr/share/doc/ruby-${SLOT} \
        --with-sitedir=/usr/lib/ruby/${SLOT}/site_ruby \
        --with-vendordir=/usr/lib/ruby/${SLOT}/vendor_ruby \
        ${BUILD_FLAGS}
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dosym ruby${VERSION%.*} /usr/bin/ruby
    dodoc README.md COPYING
}
pkg_postinst() {
    einfo "Ruby ${VERSION} installed"
    einfo "Symlink: ruby -> ruby${VERSION%.*}"
}
