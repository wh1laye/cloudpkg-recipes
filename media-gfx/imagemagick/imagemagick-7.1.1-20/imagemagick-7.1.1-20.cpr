PACKAGE=imagemagick
VERSION=7.1.1-20
CATEGORY=media-gfx
DESCRIPTION="Image manipulation suite"
HOMEPAGE="https://imagemagick.org/"
LICENSE="Apache-2.0"
SRC_URI="https://imagemagick.org/archive/ImageMagick-7.1.1-20.tar.gz -> ImageMagick-7.1.1-20.tar.gz"
DEPEND="dev-libs/libjpeg dev-libs/libpng sys-libs/zlib"
RDEPEND="
SLOT=7
KEYWORDS="amd64"
BUILD_FLAGS="--with-jpeg --with-png --with-zlib"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
