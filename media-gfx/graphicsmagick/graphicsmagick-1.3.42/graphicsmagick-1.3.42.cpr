PACKAGE=graphicsmagick
VERSION=1.3.42
CATEGORY=media-gfx
DESCRIPTION="Graphics manipulation suite"
HOMEPAGE="http://www.graphicsmagick.org/"
LICENSE="MIT"
SRC_URI="https://downloads.sourceforge.net/project/graphicsmagick/graphicsmagick/1.3.42/GraphicsMagick-1.3.42.tar.gz -> GraphicsMagick-1.3.42.tar.gz"
DEPEND="dev-libs/libjpeg dev-libs/libpng sys-libs/zlib"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
