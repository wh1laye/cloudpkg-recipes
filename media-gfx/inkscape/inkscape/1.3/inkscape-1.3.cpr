PACKAGE=inkscape
VERSION=1.3
CATEGORY=.
DESCRIPTION="Vector graphics editor"
HOMEPAGE="https://inkscape.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/inkscape/inkscape/archive/refs/tags/inkscape-1.3.tar.gz -> inkscape-1.3.tar.gz"
DEPEND="dev-libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
