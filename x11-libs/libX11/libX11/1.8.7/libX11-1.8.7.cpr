PACKAGE=libX11
VERSION=1.8.7
CATEGORY=.
DESCRIPTION="X11 client-side library"
HOMEPAGE="https://www.x.org/wiki/"
LICENSE="MIT"
SRC_URI="https://www.x.org/releases/individual/lib/libX11-1.8.7.tar.gz -> libX11-1.8.7.tar.gz"
DEPEND="x11-proto/xproto"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
