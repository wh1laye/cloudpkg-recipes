PACKAGE=libXext
VERSION=1.3.5
CATEGORY=.
DESCRIPTION="X11 miscellaneous extensions library"
HOMEPAGE="https://www.x.org/wiki/"
LICENSE="MIT"
SRC_URI="https://www.x.org/releases/individual/lib/libXext-1.3.5.tar.gz -> libXext-1.3.5.tar.gz"
DEPEND="x11-libs/libX11"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
