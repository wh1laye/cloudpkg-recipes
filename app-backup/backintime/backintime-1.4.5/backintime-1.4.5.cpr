PACKAGE=backintime
VERSION=1.4.5
CATEGORY=app-backup
DESCRIPTION="Backup tool"
HOMEPAGE="https://example.com/backintime"
LICENSE="GPL-2"
SRC_URI="https://example.com/backintime/backintime-1.4.5.tar.gz -> backintime-1.4.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
