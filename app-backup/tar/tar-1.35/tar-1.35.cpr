PACKAGE=tar
VERSION=1.35
CATEGORY=app-backup
DESCRIPTION="GNU tar archiver"
HOMEPAGE="https://www.gnu.org/software/tar/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/tar/tar-1.35.tar.gz -> tar-1.35.tar.gz"
DEPEND="sys-libs/acl sys-libs/selinux"
RDEPEND="sys-libs/acl sys-libs/selinux"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "tar installed successfully"
}
