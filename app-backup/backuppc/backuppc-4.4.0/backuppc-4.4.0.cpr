PACKAGE=backuppc
VERSION=4.4.0
CATEGORY=app-backup
DESCRIPTION="High-performance backup system"
HOMEPAGE="https://example.com/backuppc"
LICENSE="GPL-2"
SRC_URI="https://example.com/backuppc/backuppc-4.4.0.tar.gz -> backuppc-4.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
