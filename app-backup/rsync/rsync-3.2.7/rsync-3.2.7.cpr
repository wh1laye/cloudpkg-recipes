PACKAGE=rsync
VERSION=3.2.7
CATEGORY=app-backup
DESCRIPTION="Fast and versatile file copying tool"
HOMEPAGE="https://rsync.samba.org/"
LICENSE="GPL-3"
SRC_URI="https://download.samba.org/pub/rsync/src/rsync-3.2.7.tar.gz -> rsync-3.2.7.tar.gz"
DEPEND="sys-libs/acl sys-libs/xxhash"
RDEPEND="sys-libs/acl sys-libs/xxhash"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "rsync installed successfully"
}
