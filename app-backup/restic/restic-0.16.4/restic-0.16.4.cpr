PACKAGE=restic
VERSION=0.16.4
CATEGORY=app-backup
DESCRIPTION="Backup program with deduplication"
HOMEPAGE="https://restic.net/"
LICENSE="BSD-2"
SRC_URI="https://github.com/restic/restic/releases/download/v0.16.4/restic-0.16.4.tar.gz -> restic-0.16.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "restic installed successfully"
}
