PACKAGE=backupninja
VERSION=1.3.0
CATEGORY=app-backup
DESCRIPTION="Lightweight backup tool"
HOMEPAGE="https://example.com/backupninja"
LICENSE="GPL-2"
SRC_URI="https://example.com/backupninja/backupninja-1.3.0.tar.gz -> backupninja-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
