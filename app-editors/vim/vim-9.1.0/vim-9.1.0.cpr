PACKAGE=vim
VERSION=9.1.0
CATEGORY=app-editors
DESCRIPTION="Vi IMproved text editor"
HOMEPAGE="https://www.vim.org/"
LICENSE="Vim"
SRC_URI="https://github.com/vim/vim/archive/refs/tags/v9.1.0.tar.gz -> vim-9.1.0.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/libtermcap"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-features=huge"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
