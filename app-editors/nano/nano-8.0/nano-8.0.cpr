PACKAGE=nano
VERSION=8.0
CATEGORY=app-editors
DESCRIPTION="GNU nano editor"
HOMEPAGE="https://nano.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.nano.org/nano-8.0.tar.gz -> nano-8.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
