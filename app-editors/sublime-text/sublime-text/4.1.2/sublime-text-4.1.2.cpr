PACKAGE=sublime-text
VERSION=4.1.2
CATEGORY=.
DESCRIPTION="Sophisticated text editor"
HOMEPAGE="https://www.sublimetext.com/"
LICENSE="Proprietary"
SRC_URI="https://download.sublimetext.com/sublime_text_build_4126.tar.xz -> sublime-text-4.1.2.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
