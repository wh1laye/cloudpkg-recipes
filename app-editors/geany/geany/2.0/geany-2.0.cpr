PACKAGE=geany
VERSION=2.0
CATEGORY=.
DESCRIPTION="Lightweight GTK+ text editor"
HOMEPAGE="https://www.geany.org/"
LICENSE="GPL-2"
SRC_URI="https://download.geany.org/geany-2.0.tar.gz -> geany-2.0.tar.gz"
DEPEND="dev-libs/gtk"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
