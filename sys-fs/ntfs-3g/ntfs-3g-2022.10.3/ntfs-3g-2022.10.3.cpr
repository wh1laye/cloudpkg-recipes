PACKAGE=ntfs-3g
VERSION=2022.10.3
CATEGORY=sys-fs
DESCRIPTION="NTFS filesystem driver and utilities"
HOMEPAGE="https://tuxera.com/opensource/ntfs-3g/"
LICENSE="GPL-2"
SRC_URI="https://tuxera.com/opensource/ntfs-3g_ntfsprogs-2022.10.3.tgz -> ntfs-3g-2022.10.3.tgz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
