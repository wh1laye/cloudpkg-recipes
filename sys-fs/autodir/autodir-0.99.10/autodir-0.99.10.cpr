PACKAGE=autodir
VERSION=0.99.10
CATEGORY=sys-fs
DESCRIPTION="Automount directories on demand"
HOMEPAGE="https://example.com/autodir"
LICENSE="GPL-2"
SRC_URI="https://example.com/autodir/autodir-0.99.10.tar.gz -> autodir-0.99.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
