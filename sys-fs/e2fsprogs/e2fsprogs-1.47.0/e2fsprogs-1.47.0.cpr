PACKAGE=e2fsprogs
VERSION=1.47.0
CATEGORY=sys-fs
DESCRIPTION="Ext2/3/4 filesystem utilities"
HOMEPAGE="https://e2fsprogs.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v1.47.0/e2fsprogs-1.47.0.tar.gz -> e2fsprogs-1.47.0.tar.gz"
DEPEND="sys-libs/util-linux"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-htree-dir --enable-largefile"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
