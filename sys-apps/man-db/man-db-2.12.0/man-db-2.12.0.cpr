PACKAGE=man-db
VERSION=2.12.0
CATEGORY=.
DESCRIPTION="Manual page database and viewer"
HOMEPAGE="https://www.nongnu.org/man-db/"
LICENSE="GPL-2"
SRC_URI="https://download.savannah.gnu.org/releases/man-db/man-db-2.12.0.tar.gz -> man-db-2.12.0.tar.gz"
DEPEND="libs/gdbm"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --with-systemdtmpfilesdir=/usr/lib/tmpfiles.d
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}