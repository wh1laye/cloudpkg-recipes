PACKAGE=less
VERSION=643
CATEGORY=.
DESCRIPTION="GNU pager - opposite of more"
HOMEPAGE="https://www.greenwoodsoftware.com/less/"
LICENSE="GPL-3"
SRC_URI="https://www.greenwoodsoftware.com/less/less-643.tar.gz -> less-643.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}