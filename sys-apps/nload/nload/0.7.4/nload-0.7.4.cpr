PACKAGE=nload
VERSION=0.7.4
CATEGORY=.
DESCRIPTION="Network traffic monitor"
HOMEPAGE="https://github.com/rolandriegel/nload"
LICENSE="GPL-2"
SRC_URI="https://github.com/rolandriegel/nload/archive/refs/tags/v0.7.4.tar.gz -> nload-0.7.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
