PACKAGE=util-linux
VERSION=2.39.3
CATEGORY=.
DESCRIPTION="Various Linux utilities"
HOMEPAGE="https://www.kernel.org/pub/linux/utils/util-linux/"
LICENSE="GPL-2"
SRC_URI="https://www.kernel.org/pub/linux/utils/util-linux/v2.39/util-linux-2.39.3.tar.gz -> util-linux-2.39.3.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --enable-widec
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}