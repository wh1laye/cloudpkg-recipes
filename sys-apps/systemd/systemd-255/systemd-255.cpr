PACKAGE=systemd
VERSION=255
CATEGORY=.
DESCRIPTION="System and service manager"
HOMEPAGE="https://systemd.io/"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/systemd/systemd/archive/refs/tags/v255.tar.gz -> systemd-255.tar.gz"
DEPEND="sys-libs/glibc libs/libcap"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    meson setup build --prefix=/usr -Drootprefix=/usr
}
src_compile() {
    ninja -C build -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    DESTDIR="${D}" ninja -C build install || exit 1
}