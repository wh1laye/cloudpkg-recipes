PACKAGE=grep
VERSION=3.11
CATEGORY=sys-apps
DESCRIPTION="Text search utility"
HOMEPAGE="https://grep.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.grep.org/grep-3.11.tar.gz -> grep-3.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
