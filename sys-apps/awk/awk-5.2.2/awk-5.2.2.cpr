PACKAGE=awk
VERSION=5.2.2
CATEGORY=sys-apps
DESCRIPTION="Pattern scanning language"
HOMEPAGE="https://awk.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.awk.org/awk-5.2.2.tar.gz -> awk-5.2.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
