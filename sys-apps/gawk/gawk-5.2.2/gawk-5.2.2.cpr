PACKAGE=gawk
VERSION=5.2.2
CATEGORY=.
DESCRIPTION="GNU Awk pattern matching language"
HOMEPAGE="https://www.gnu.org/software/gawk/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/gawk/gawk-5.2.2.tar.gz -> gawk-5.2.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}