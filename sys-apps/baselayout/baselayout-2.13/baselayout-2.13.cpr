PACKAGE=baselayout
VERSION=2.13
CATEGORY=sys-apps
DESCRIPTION="Filesystem baseline layout"
HOMEPAGE="https://baselayout.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.baselayout.org/baselayout-2.13.tar.gz -> baselayout-2.13.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
