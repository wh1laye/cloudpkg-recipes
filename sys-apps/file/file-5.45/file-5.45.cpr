PACKAGE=file
VERSION=5.45
CATEGORY=.
DESCRIPTION="File type identification utility"
HOMEPAGE="https://www.darwinsys.com/file/"
LICENSE="BSD-2"
SRC_URI="https://astron.com/pub/file/file-5.45.tar.gz -> file-5.45.tar.gz"
DEPEND="libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}