PACKAGE=usbutils
VERSION=015
CATEGORY=.
DESCRIPTION="USB utilities"
HOMEPAGE="https"
LICENSE="//github.com/gregkh/usbutils"
SRC_URI="GPL-2 -> usbutils-015.tar.gz"
DEPEND="https://www.kernel.org/pub/linux/utils/usb/usbutils/usbutils-015.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
