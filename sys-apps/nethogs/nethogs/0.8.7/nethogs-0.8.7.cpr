PACKAGE=nethogs
VERSION=0.8.7
CATEGORY=.
DESCRIPTION="Net top tool grouping bandwidth per process"
HOMEPAGE="https://github.com/raboof/nethogs"
LICENSE="GPL-2"
SRC_URI="https://github.com/raboof/nethogs/archive/refs/tags/v0.8.7.tar.gz -> nethogs-0.8.7.tar.gz"
DEPEND="dev-libs/libpcap"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
