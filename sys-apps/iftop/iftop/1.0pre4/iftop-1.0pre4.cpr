PACKAGE=iftop
VERSION=1.0pre4
CATEGORY=.
DESCRIPTION="Bandwidth monitoring tool"
HOMEPAGE="http://www.ex-parrot.com/pdw/iftop/"
LICENSE="GPL-2"
SRC_URI="http://www.ex-parrot.com/pdw/iftop/download/iftop-1.0pre4.tar.gz -> iftop-1.0pre4.tar.gz"
DEPEND="dev-libs/libpcap"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
