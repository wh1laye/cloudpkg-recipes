PACKAGE=whereis
VERSION=2.21
CATEGORY=sys-apps
DESCRIPTION="Locate binaries"
HOMEPAGE="https://whereis.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.whereis.org/whereis-2.21.tar.gz -> whereis-2.21.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
