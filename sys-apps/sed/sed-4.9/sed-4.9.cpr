PACKAGE=sed
VERSION=4.9
CATEGORY=.
DESCRIPTION="GNU sed - stream editor"
HOMEPAGE="https://www.gnu.org/software/sed/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/sed/sed-4.9.tar.gz -> sed-4.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}