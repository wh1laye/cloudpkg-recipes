PACKAGE=sed
VERSION=4.9
CATEGORY=sys-apps
DESCRIPTION="Stream editor"
HOMEPAGE="https://sed.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.sed.org/sed-4.9.tar.gz -> sed-4.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
