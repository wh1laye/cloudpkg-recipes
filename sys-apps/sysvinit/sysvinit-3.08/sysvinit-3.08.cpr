PACKAGE=sysvinit
VERSION=3.08
CATEGORY=.
DESCRIPTION="System V init utilities"
HOMEPAGE="https"
LICENSE="//savannah.nongnu.org/projects/sysvinit"
SRC_URI="GPL-2 -> sysvinit-3.08.tar.gz"
DEPEND="https://download.savannah.gnu.org/releases/sysvinit/sysvinit-3.08.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
