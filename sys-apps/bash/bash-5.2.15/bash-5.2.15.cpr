PACKAGE=bash
VERSION=5.2.15
CATEGORY=.
DESCRIPTION="GNU Bourne Again Shell"
HOMEPAGE="https://www.gnu.org/software/bash/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/bash/bash-5.2.15.tar.gz -> bash-5.2.15.tar.gz"
DEPEND="sys-libs/readline sys-libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --with-curses
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}