PACKAGE=acl
VERSION=2.3.1
CATEGORY=.
DESCRIPTION="GNU Access Control Lists"
HOMEPAGE="https"
LICENSE="//savannah.nongnu.org/projects/acl"
SRC_URI="LGPL-2.1 -> acl-2.3.1.tar.gz"
DEPEND="https://download.savannah.gnu.org/releases/acl/acl-2.3.1.tar.gz:sys-libs/attr"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
