PACKAGE=findutils
VERSION=4.10.0
CATEGORY=sys-apps
DESCRIPTION="File searching utilities"
HOMEPAGE="https://findutils.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.findutils.org/findutils-4.10.0.tar.gz -> findutils-4.10.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
