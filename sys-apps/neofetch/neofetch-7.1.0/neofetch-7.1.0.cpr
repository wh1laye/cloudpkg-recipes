PACKAGE=neofetch
VERSION=7.1.0
CATEGORY=sys-apps
DESCRIPTION="Fast, highly customizable system info script"
HOMEPAGE="https://github.com/dylanaraps/neofetch"
LICENSE="MIT"
SRC_URI="https://github.com/dylanaraps/neofetch/archive/refs/tags/${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_compile() {
    : 
}
src_install() {
    dobin neofetch
    insinto /usr/share/neofetch
    doins -r ascii images
    dodoc README.md LICENSE.md
}
