PACKAGE=procps
VERSION=4.0.4
CATEGORY=.
DESCRIPTION="Process utilities"
HOMEPAGE="https"
LICENSE="//gitlab.com/procps-ng/procps"
SRC_URI="GPL-2 -> procps-4.0.4.tar.gz"
DEPEND="https://gitlab.com/procps-ng/procps/-/archive/v4.0.4/procps-v4.0.4.tar.gz:sys-libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
