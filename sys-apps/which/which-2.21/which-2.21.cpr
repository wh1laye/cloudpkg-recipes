PACKAGE=which
VERSION=2.21
CATEGORY=sys-apps
DESCRIPTION="Shows full path of commands"
HOMEPAGE="https://which.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.which.org/which-2.21.tar.gz -> which-2.21.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
