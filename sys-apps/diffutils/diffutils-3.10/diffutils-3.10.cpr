PACKAGE=diffutils
VERSION=3.10
CATEGORY=sys-apps
DESCRIPTION="File comparison utilities"
HOMEPAGE="https://diffutils.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.diffutils.org/diffutils-3.10.tar.gz -> diffutils-3.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
