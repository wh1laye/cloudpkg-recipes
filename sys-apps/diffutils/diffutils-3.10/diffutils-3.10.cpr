PACKAGE=diffutils
VERSION=3.10
CATEGORY=.
DESCRIPTION="GNU diff utilities"
HOMEPAGE="https://www.gnu.org/software/diffutils/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/diffutils/diffutils-3.10.tar.gz -> diffutils-3.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}