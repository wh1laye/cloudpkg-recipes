PACKAGE=pciutils
VERSION=3.11.1
CATEGORY=.
DESCRIPTION="PCI utilities"
HOMEPAGE="https"
LICENSE="//at.ua.pw/pciutils/"
SRC_URI="GPL-2 -> pciutils-3.11.1.tar.gz"
DEPEND="https://www.kernel.org/pub/software/utils/pciutils/pciutils-3.11.1.tar.gz:sys-libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
