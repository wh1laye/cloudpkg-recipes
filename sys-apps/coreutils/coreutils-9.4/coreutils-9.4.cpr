PACKAGE=coreutils
VERSION=9.4
CATEGORY=sys-apps
DESCRIPTION="GNU core utilities"
HOMEPAGE="https://coreutils.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.coreutils.org/coreutils-9.4.tar.gz -> coreutils-9.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
