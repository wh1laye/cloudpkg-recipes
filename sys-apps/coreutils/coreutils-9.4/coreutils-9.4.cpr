PACKAGE=coreutils
VERSION=9.4
CATEGORY=.
DESCRIPTION="GNU Core Utilities"
HOMEPAGE="https://www.gnu.org/software/coreutils/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/coreutils/coreutils-9.4.tar.gz -> coreutils-9.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --enable-no-install-program=kill,uptime
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}