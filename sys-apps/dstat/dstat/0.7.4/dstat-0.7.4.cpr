PACKAGE=dstat
VERSION=0.7.4
CATEGORY=.
DESCRIPTION="Versatile resource statistics tool"
HOMEPAGE="https://github.com/dagwieers/dstat"
LICENSE="GPL-2"
SRC_URI="https://github.com/dagwieers/dstat/archive/refs/tags/v0.7.4.tar.gz -> dstat-0.7.4.tar.gz"
DEPEND="dev-lang/python"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
