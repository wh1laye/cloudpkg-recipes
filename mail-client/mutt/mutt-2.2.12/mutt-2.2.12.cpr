PACKAGE=mutt
VERSION=2.2.12
CATEGORY=mail-client
DESCRIPTION="Text-based mail client"
HOMEPAGE="https://www.mutt.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/mutt/mutt/stable/mutt-2.2.12.tar.gz -> mutt-2.2.12.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/openssl"
RDEPEND="sys-libs/ncurses dev-libs/openssl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "mutt installed successfully"
}
