PACKAGE=mutt
VERSION=2.0.0
CATEGORY=mail-client
DESCRIPTION="Text-based mail client"
HOMEPAGE="https://example.com/mutt"
LICENSE=""GPL-2""
SRC_URI="https://example.com/mutt/mutt-2.0.0.tar.gz -> mutt-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
