PACKAGE=claws-mail
VERSION=4.2.0
CATEGORY=mail-client
DESCRIPTION="Lightweight GTK-based email client"
HOMEPAGE="https://www.claws-mail.org/"
LICENSE="GPL-3"
SRC_URI="https://www.claws-mail.org/downloads.php?file=claws-mail-4.2.0.tar.gz -> claws-mail-4.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "claws-mail installed successfully"
}
