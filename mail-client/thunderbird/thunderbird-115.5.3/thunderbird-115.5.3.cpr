PACKAGE=thunderbird
VERSION=115.5.3
CATEGORY=mail-client
DESCRIPTION="Mozilla Thunderbird mail client"
HOMEPAGE="https://www.thunderbird.net/"
LICENSE="MPL-2.0"
SRC_URI="https://download-installer.cdn.mozilla.net/pub/thunderbird/releases/115.5.3/linux-x86_64/en-US/thunderbird-115.5.3.tar.bz2 -> thunderbird-115.5.3.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "thunderbird installed successfully"
}
