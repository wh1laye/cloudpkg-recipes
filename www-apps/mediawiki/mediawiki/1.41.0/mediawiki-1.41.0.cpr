PACKAGE=mediawiki
VERSION=1.41.0
CATEGORY=.
DESCRIPTION="Wiki software"
HOMEPAGE="https://www.mediawiki.org/"
LICENSE="GPL-2"
SRC_URI="https://releases.wikimedia.org/mediawiki/1.41/mediawiki-1.41.0.tar.gz -> mediawiki-1.41.0.tar.gz"
DEPEND="dev-lang/php"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
