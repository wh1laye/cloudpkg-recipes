PACKAGE=postgresql
VERSION=16.2
CATEGORY=dev-db
DESCRIPTION="PostgreSQL database server"
HOMEPAGE="https://www.postgresql.org/"
LICENSE="PostgreSQL"
SRC_URI="https://ftp.postgresql.org/pub/source/v16.2/postgresql-16.2.tar.gz -> postgresql-16.2.tar.gz"
DEPEND="sys-libs/zlib dev-libs/openssl"
RDEPEND="sys-libs/zlib dev-libs/openssl"
SLOT=16
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "postgresql installed successfully"
}
