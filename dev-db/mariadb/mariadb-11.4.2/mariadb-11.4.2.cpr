PACKAGE=mariadb
VERSION=11.4.2
CATEGORY=dev-db
DESCRIPTION="MariaDB database server"
HOMEPAGE="https://mariadb.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.mariadb.org/f/mariadb-11.4.2/source/mariadb-11.4.2.tar.gz -> mariadb-11.4.2.tar.gz"
DEPEND="sys-libs/zlib dev-libs/openssl"
RDEPEND="sys-libs/zlib dev-libs/openssl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "mariadb installed successfully"
}
