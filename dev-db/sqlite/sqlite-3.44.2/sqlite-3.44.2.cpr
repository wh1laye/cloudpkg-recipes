PACKAGE=sqlite
VERSION=3.44.2
CATEGORY=dev-db
DESCRIPTION="SQL database engine in a C library"
HOMEPAGE="https://www.sqlite.org/"
LICENSE="Public-Domain"
SRC_URI="https://www.sqlite.org/2024/sqlite-autoconf-3440200.tar.gz -> sqlite-3.44.2.tar.gz"
DEPEND="dev-libs/readline"
RDEPEND="dev-libs/readline"
SLOT=3
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "sqlite installed successfully"
}
