PACKAGE=redis
VERSION=7.2.4
CATEGORY=dev-db
DESCRIPTION="In-memory data structure store"
HOMEPAGE="https://redis.io/"
LICENSE="BSD-3"
SRC_URI="https://download.redis.io/releases/redis-7.2.4.tar.gz -> redis-7.2.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "redis installed successfully"
}
