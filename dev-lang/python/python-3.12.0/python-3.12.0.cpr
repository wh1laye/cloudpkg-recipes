PACKAGE=python
VERSION=3.12.0
CATEGORY=dev-lang
DESCRIPTION="Python programming language interpreter"
HOMEPAGE="https://www.python.org/"
LICENSE="PSF-2"
SRC_URI="https://www.python.org/ftp/python/${VERSION}/Python-${VERSION}.tar.xz -> ${P}-${VERSION}.tar.xz"
DEPEND="dev-libs/openssl dev-libs/libffi sys-libs/zlib sys-libs/readline dev-libs/expat sys-libs/bzip2"
RDEPEND="${DEPEND}"
SLOT=3.12
KEYWORDS="amd64"
BUILD_FLAGS="--enable-optimizations --enable-shared --with-lto --with-system-expat --with-system-ffi --with-system-libmpdec"
src_configure() {
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib/python${SLOT} \
        --includedir=/usr/include/python${SLOT} \
        --datarootdir=/usr/share \
        --mandir=/usr/share/man \
        --docdir=/usr/share/doc/python-${SLOT} \
        --with-platlibdir=/usr/lib/python${SLOT}/site-packages \
        ${BUILD_FLAGS}
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dosym python${VERSION%.*} /usr/bin/python3
    dosym python3 /usr/bin/python
    ensure_pip_install() {
        local pip_ver="24.0"
        local pip_url="https://github.com/pypa/pip/archive/refs/tags/${pip_ver}.tar.gz"
        curl -L "${pip_url}" | tar xz
        cd pip-${pip_ver}
        python${VERSION%.*} setup.py install --root="${D}" --prefix=/usr || die "pip install failed"
        cd ..
        rm -rf pip-${pip_ver}
    }
    rm -f "${D}"/usr/lib/python${SLOT}/_sysconfigdata__linux_*
    rm -f "${D}"/usr/lib/python${SLOT}/config-${SLOT}*/Makefile
    dodoc README.rst LICENSE
}
pkg_postinst() {
    einfo "Python ${VERSION} installed"
    einfo "Symlinks: python -> python3 -> python${VERSION%.*}"
    einfo "pip available: pip3"
}
