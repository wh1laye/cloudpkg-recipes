PACKAGE=python
VERSION=3.12.0
CATEGORY=.
DESCRIPTION="Python programming language"
HOMEPAGE="https://www.python.org/"
LICENSE="PSF-2.0"
SRC_URI="https://www.python.org/ftp/python/3.12.0/Python-3.12.0.tar.gz -> Python-3.12.0.tar.gz"
DEPEND="sys-libs/zlib libs/bzip2 libs/openssl libs/readline"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --enable-optimizations
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}