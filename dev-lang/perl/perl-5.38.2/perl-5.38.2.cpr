PACKAGE=perl
VERSION=5.38.2
CATEGORY=.
DESCRIPTION="Practical Extraction and Report Language"
HOMEPAGE="https://www.perl.org/"
LICENSE="Artistic-1.0"
SRC_URI="https://www.cpan.org/src/5.0/perl-5.38.2.tar.gz -> perl-5.38.2.tar.gz"
DEPEND="sys-libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./Configure -des -Dprefix=/usr -Duseshrplib
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}