PACKAGE=alglib
VERSION=3.19.0
CATEGORY=sci-mathematics
DESCRIPTION="Numerical analysis library"
HOMEPAGE="https://example.com/alglib"
LICENSE="GPL-2"
SRC_URI="https://example.com/alglib/alglib-3.19.0.tar.gz -> alglib-3.19.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
