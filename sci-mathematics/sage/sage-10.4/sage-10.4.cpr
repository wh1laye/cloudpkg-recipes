PACKAGE=sage
VERSION=10.4
CATEGORY=sci-mathematics
DESCRIPTION="Mathematics software system"
HOMEPAGE="https://www.sagemath.org/"
LICENSE="GPL-3"
SRC_URI="https://github.com/sagemath/sage/archive/refs/tags/10.4.tar.gz -> sage-10.4.tar.gz"
DEPEND="dev-lang/python"
RDEPEND="dev-lang/python"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "sage installed successfully"
}
