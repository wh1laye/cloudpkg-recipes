PACKAGE=r
VERSION=4.3.3
CATEGORY=sci-mathematics
DESCRIPTION="R programming language for statistical computing"
HOMEPAGE="https://www.r-project.org/"
LICENSE="GPL-2"
SRC_URI="https://cran.r-project.org/src/base/R-4/R-4.3.3.tar.gz -> R-4.3.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "r installed successfully"
}
