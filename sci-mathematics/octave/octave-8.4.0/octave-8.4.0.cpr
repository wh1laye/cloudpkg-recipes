PACKAGE=octave
VERSION=8.4.0
CATEGORY=sci-mathematics
DESCRIPTION="GNU Octave - high-level language for numerical computations"
HOMEPAGE="https://www.gnu.org/software/octave/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/octave/octave-8.4.0.tar.gz -> octave-8.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "octave installed successfully"
}
