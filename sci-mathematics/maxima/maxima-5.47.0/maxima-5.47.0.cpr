PACKAGE=maxima
VERSION=5.47.0
CATEGORY=sci-mathematics
DESCRIPTION="Computer algebra system"
HOMEPAGE="https://maxima.sourceforge.io/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/maxima/Maxima-source/5.47.0/maxima-5.47.0.tar.gz -> maxima-5.47.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "maxima installed successfully"
}
