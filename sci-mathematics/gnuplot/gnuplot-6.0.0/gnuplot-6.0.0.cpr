PACKAGE=gnuplot
VERSION=6.0.0
CATEGORY=sci-mathematics
DESCRIPTION="Portable command-line driven graphing utility"
HOMEPAGE="http://www.gnuplot.info/"
LICENSE="GPL-3"
SRC_URI="https://downloads.sourceforge.net/project/gnuplot/gnuplot/6.0.0/gnuplot-6.0.0.tar.gz -> gnuplot-6.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "gnuplot installed successfully"
}
