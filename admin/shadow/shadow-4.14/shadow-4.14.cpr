PACKAGE=shadow
VERSION=4.14
CATEGORY=.
DESCRIPTION="Password management"
HOMEPAGE="https://shadow.org/"
LICENSE="BSD-3"
SRC_URI="https://downloads.shadow.org/shadow-4.14.tar.gz -> shadow-4.14.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
