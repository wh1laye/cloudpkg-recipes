PACKAGE=aide
VERSION=0.18.2
CATEGORY=.
DESCRIPTION="Advanced Intrusion Detection Environment"
HOMEPAGE="https://example.com/aide"
LICENSE="GPL-2"
SRC_URI="https://example.com/aide/aide-0.18.2.tar.gz -> aide-0.18.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
