PACKAGE=busybox
VERSION=1.36.1
CATEGORY=.
DESCRIPTION="Multi-call binary"
HOMEPAGE="https://busybox.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.busybox.org/busybox-1.36.1.tar.gz -> busybox-1.36.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make CONFIG_PREFIX="${D}" install || exit 1
}
