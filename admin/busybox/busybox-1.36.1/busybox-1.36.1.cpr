PACKAGE=busybox
VERSION=1.36.1
CATEGORY=.
DESCRIPTION="Multi-call binary"
HOMEPAGE="https://busybox.org/"
LICENSE="GPL-2"
SRC_URI="https://busybox.net/downloads/busybox-1.36.1.tar.bz2 -> busybox-1.36.1.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    make defconfig && sed -i "s/^CONFIG_TC=y/# CONFIG_TC is not set/" .config
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make CONFIG_PREFIX="${D}" install
}
