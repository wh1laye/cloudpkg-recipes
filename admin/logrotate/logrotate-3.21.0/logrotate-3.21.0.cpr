PACKAGE=logrotate
VERSION=3.21.0
CATEGORY=.
DESCRIPTION="Log file rotation utility"
HOMEPAGE="https://github.com/logrotate/logrotate"
LICENSE="MIT"
SRC_URI="https://github.com/logrotate/logrotate/releases/download/3.21.0/logrotate-3.21.0.tar.gz -> logrotate-3.21.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --with-state-file-path=/var/lib/logrotate/status
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
