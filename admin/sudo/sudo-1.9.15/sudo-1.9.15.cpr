PACKAGE=sudo
VERSION=1.9.15
CATEGORY=.
DESCRIPTION="Execute commands with elevated privileges"
HOMEPAGE="https://www.sudo.ws/"
LICENSE="ISC"
SRC_URI="https://www.sudo.ws/dist/sudo-1.9.15.tar.gz -> sudo-1.9.15.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib/sudo --with-env-editor --with-rundir=/run/sudo --disable-openssl
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
