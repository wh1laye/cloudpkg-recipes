PACKAGE=sudo
VERSION=1.9.15
CATEGORY=.
DESCRIPTION="Execute commands with elevated privileges"
HOMEPAGE="https://www.sudo.ws/"
LICENSE="ISC"
SRC_URI="https://www.sudo.ws/dist/sudo-1.9.15.tar.gz -> sudo-1.9.15.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--without-pam --without-audit --with-logging=syslog --with-env-editor --disable-static"

src_configure() {
    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib/sudo \
        --with-rundir=/run/sudo \
        --with-vardir=/var/db/sudo \
        ${BUILD_FLAGS}
}

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
    install -d -m 750 "${D}/etc/sudoers.d"
}

pkg_postinst() {
    echo "sudo installed"
    echo "edit /etc/sudoers with visudo"
}
