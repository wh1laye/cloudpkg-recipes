PACKAGE=laravel
VERSION=10.48.12
CATEGORY=.
DESCRIPTION="PHP web application framework"
HOMEPAGE="https://laravel.com/"
LICENSE="MIT"
SRC_URI="https://github.com/laravel/laravel/archive/refs/tags/v10.48.12.tar.gz -> laravel-10.48.12.tar.gz"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "laravel installed successfully"
}
