PACKAGE=phpunit
VERSION=10.5.12
CATEGORY=.
DESCRIPTION="PHP testing framework"
HOMEPAGE="https://phpunit.de/"
LICENSE="BSD-3"
SRC_URI="https://phpunit.de/get/phpunit-10.5.12.phar -> phpunit-10.5.12.phar"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "phpunit installed successfully"
}
