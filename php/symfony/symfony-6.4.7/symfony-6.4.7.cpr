PACKAGE=symfony
VERSION=6.4.7
CATEGORY=.
DESCRIPTION="PHP framework for web projects"
HOMEPAGE="https://symfony.com/"
LICENSE="MIT"
SRC_URI="https://github.com/symfony/symfony/archive/refs/tags/v6.4.7.tar.gz -> symfony-6.4.7.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    true
}

src_install() {
    install -d "${D}/usr/share/php/symfony" && cp -a . "${D}/usr/share/php/symfony/"
}
