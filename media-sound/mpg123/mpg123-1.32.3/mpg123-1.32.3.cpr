PACKAGE=mpg123
VERSION=1.32.3
CATEGORY=.
DESCRIPTION="MPEG audio player"
HOMEPAGE="https://www.mpg123.de/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.mpg123.de/downloads/mpg123-1.32.3.tar.bz2 -> mpg123-1.32.3.tar.bz2"
DEPEND="dev-libs/libaudiofile"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
