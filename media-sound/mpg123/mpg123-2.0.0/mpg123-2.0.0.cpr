PACKAGE=mpg123
VERSION=2.0.0
CATEGORY=.
DESCRIPTION="MPEG audio player"
HOMEPAGE="https://example.com/mpg123"
LICENSE=""LGPL-2.1""
SRC_URI="https://example.com/mpg123/mpg123-2.0.0.tar.gz -> mpg123-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
