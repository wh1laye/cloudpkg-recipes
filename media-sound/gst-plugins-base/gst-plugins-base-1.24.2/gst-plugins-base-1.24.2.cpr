PACKAGE=gst-plugins-base
VERSION=1.24.2
CATEGORY=.
DESCRIPTION="GStreamer base plugins"
HOMEPAGE="https://gstreamer.freedesktop.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-1.24.2.tar.gz -> gst-plugins-base-1.24.2.tar.gz"
DEPEND="media-sound/gstreamer"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
