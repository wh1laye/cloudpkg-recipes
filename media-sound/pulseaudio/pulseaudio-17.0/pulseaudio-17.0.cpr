PACKAGE=pulseaudio
VERSION=17.0
CATEGORY=.
DESCRIPTION="PulseAudio sound server"
HOMEPAGE="https://www.freedesktop.org/wiki/Software/PulseAudio/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-17.0.tar.gz -> pulseaudio-17.0.tar.gz"
DEPEND="media-sound/alsa-lib libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
