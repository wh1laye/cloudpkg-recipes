PACKAGE=libsndfile
VERSION=1.2.2
CATEGORY=.
DESCRIPTION="Sound file library"
HOMEPAGE="https://libsndfile.github.io/libsndfile/"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.gz -> libsndfile-1.2.2.tar.gz"
DEPEND="media-sound/libogg media-sound/libvorbis"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
