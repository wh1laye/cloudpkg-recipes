PACKAGE=gstreamer
VERSION=1.24.2
CATEGORY=.
DESCRIPTION="Media framework"
HOMEPAGE="https://gstreamer.freedesktop.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-1.24.2.tar.gz -> gstreamer-1.24.2.tar.gz"
DEPEND="libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
