PACKAGE=libogg
VERSION=1.3.5
CATEGORY=.
DESCRIPTION="Ogg bitstream library"
HOMEPAGE="https://xiph.org/ogg/"
LICENSE="BSD-3"
SRC_URI="https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz -> libogg-1.3.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
