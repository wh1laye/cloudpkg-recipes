PACKAGE=audacious
VERSION=4.4
CATEGORY=.
DESCRIPTION="Lightweight audio player"
HOMEPAGE="https://example.com/audacious"
LICENSE="BSD-2"
SRC_URI="https://example.com/audacious/audacious-4.4.tar.gz -> audacious-4.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
