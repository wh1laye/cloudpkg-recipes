PACKAGE=audacious
VERSION=1.4.0
CATEGORY=.
DESCRIPTION="Lightweight audio player"
HOMEPAGE="https://example.com/audacious"
LICENSE=""BSD-2""
SRC_URI="https://example.com/audacious/audacious-1.4.0.tar.gz -> audacious-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
