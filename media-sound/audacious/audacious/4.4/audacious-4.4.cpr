PACKAGE=audacious
VERSION=4.4
CATEGORY=.
DESCRIPTION="Advanced audio player"
HOMEPAGE="https://audacious-media-player.org/"
LICENSE="BSD-2"
SRC_URI="https://github.com/audacious-media-player/audacious/archive/refs/tags/4.4.tar.gz -> audacious-4.4.tar.gz"
DEPEND="dev-libs/glib dev-libs/gtk"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
