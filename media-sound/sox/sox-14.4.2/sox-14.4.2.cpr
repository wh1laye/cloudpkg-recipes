PACKAGE=sox
VERSION=14.4.2
CATEGORY=.
DESCRIPTION="Sound eXchange - audio processing"
HOMEPAGE="https://sourceforge.net/p/sox/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/sox/sox/14.4.2/sox-14.4.2.tar.gz -> sox-14.4.2.tar.gz"
DEPEND="dev-libs/libsndfile dev-libs/libmad"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-mad --with-sndfile"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
