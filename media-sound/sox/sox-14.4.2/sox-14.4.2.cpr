PACKAGE=sox
VERSION=14.4.2
CATEGORY=.
DESCRIPTION="Sound eXchange"
HOMEPAGE="https://sourceforge.net/projects/sox/"
LICENSE="GPL-2"
SRC_URI="https://sourceforge.net/projects/sox/files/sox/14.4.2/sox-14.4.2.tar.gz -> sox-14.4.2.tar.gz"
DEPEND="libs/gsm libs/ladspa"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
