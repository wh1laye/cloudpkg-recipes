PACKAGE=sox
VERSION=14.4.2
CATEGORY=media-sound
DESCRIPTION="Sound eXchange - audio processing"
HOMEPAGE="https://sourceforge.net/p/sox/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/sox/sox/14.4.2/sox-14.4.2.tar.gz -> sox-14.4.2.tar.gz"
DEPEND="dev-libs/libsndfile dev-libs/libmad"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-mad --with-sndfile"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
