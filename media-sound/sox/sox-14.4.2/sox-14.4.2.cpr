PACKAGE=sox
VERSION=14.4.2
CATEGORY=.
DESCRIPTION="Sound eXchange - audio processing"
HOMEPAGE="https://sourceforge.net/p/sox/"
LICENSE="GPL-2"
SRC_URI="https://sourceforge.net/projects/sox/files/sox/14.4.2/sox-14.4.2.tar.gz/download -> sox-14.4.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --disable-static
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
