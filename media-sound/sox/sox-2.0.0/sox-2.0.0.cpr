PACKAGE=sox
VERSION=2.0.0
CATEGORY=.
DESCRIPTION="Sound eXchange - audio processing"
HOMEPAGE="https://example.com/sox"
LICENSE=""GPL-2""
SRC_URI="https://example.com/sox/sox-2.0.0.tar.gz -> sox-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
