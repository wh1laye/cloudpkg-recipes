PACKAGE=alsa-utils
VERSION=1.3.0
CATEGORY=.
DESCRIPTION="ALSA utilities"
HOMEPAGE="https://example.com/alsa-utils"
LICENSE=""GPL-2""
SRC_URI="https://example.com/alsa-utils/alsa-utils-1.3.0.tar.gz -> alsa-utils-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
