PACKAGE=cmus
VERSION=2.11.0
CATEGORY=.
DESCRIPTION="C* Music Player"
HOMEPAGE="https://cmus.github.io/"
LICENSE="GPL-2"
SRC_URI="https://github.com/cmus/cmus/archive/refs/tags/v2.11.0.tar.gz -> cmus-2.11.0.tar.gz"
DEPEND="dev-libs/ncurses"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
