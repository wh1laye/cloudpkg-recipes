PACKAGE=libflac
VERSION=1.4.3
CATEGORY=.
DESCRIPTION="FLAC audio codec"
HOMEPAGE="https://xiph.org/flac/"
LICENSE="BSD-3"
SRC_URI="https://downloads.xiph.org/releases/flac/flac-1.4.3.tar.gz -> libflac-1.4.3.tar.gz"
DEPEND="libs/ogg"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
