PACKAGE=lame
VERSION=3.100
CATEGORY=.
DESCRIPTION="MP3 encoder"
HOMEPAGE="https://lame.sourceforge.io/"
LICENSE="LGPL-2.1"
SRC_URI="https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz -> lame-3.100.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
