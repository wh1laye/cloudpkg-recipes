PACKAGE=htop
VERSION=3.3.0
CATEGORY=.
DESCRIPTION="Interactive process viewer with a friendly interface"
HOMEPAGE="https://htop.dev/"
LICENSE="BSD-2"
SRC_URI="https://github.com/htop-dev/htop/archive/refs/tags/3.3.0.tar.gz -> htop-3.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    autoreconf -fi && ./configure --prefix=/usr --disable-unicode
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
