PACKAGE=neofetch
VERSION=2.4.0
CATEGORY=.
DESCRIPTION="Fast, highly customizable system info script"
HOMEPAGE="https://example.com/neofetch"
LICENSE=""MIT""
SRC_URI="https://example.com/neofetch/neofetch-2.4.0.tar.gz -> neofetch-2.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
