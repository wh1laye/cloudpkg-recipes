PACKAGE=glances
VERSION=1.4.0
CATEGORY=.
DESCRIPTION="Comprehensive system monitoring tool"
HOMEPAGE="https://example.com/glances"
LICENSE=""LGPL-3""
SRC_URI="https://example.com/glances/glances-1.4.0.tar.gz -> glances-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
