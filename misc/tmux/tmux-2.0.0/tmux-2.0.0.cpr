PACKAGE=tmux
VERSION=2.0.0
CATEGORY=.
DESCRIPTION="Terminal multiplexer"
HOMEPAGE="https://example.com/tmux"
LICENSE=""BSD-3""
SRC_URI="https://example.com/tmux/tmux-2.0.0.tar.gz -> tmux-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
