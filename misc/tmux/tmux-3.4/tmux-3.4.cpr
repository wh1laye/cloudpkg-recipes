PACKAGE=tmux
VERSION=3.4
CATEGORY=.
DESCRIPTION="Terminal multiplexer"
HOMEPAGE="https://github.com/tmux/tmux"
LICENSE="BSD-3"
SRC_URI="https://github.com/tmux/tmux/releases/download/3.4/tmux-3.4.tar.gz -> tmux-3.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
