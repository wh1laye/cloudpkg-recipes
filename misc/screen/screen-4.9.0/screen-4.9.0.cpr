PACKAGE=screen
VERSION=4.9.0
CATEGORY=.
DESCRIPTION="Terminal screen multiplexer"
HOMEPAGE="https://www.gnu.org/software/screen/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/screen/screen-4.9.0.tar.gz -> screen-4.9.0.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
