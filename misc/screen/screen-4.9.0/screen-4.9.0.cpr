PACKAGE=screen
VERSION=4.9.0
CATEGORY=.
DESCRIPTION="Terminal screen multiplexer"
HOMEPAGE="https://www.gnu.org/software/screen/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/screen/screen-4.9.0.tar.gz -> screen-4.9.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    autoreconf -fi && ./configure --prefix=/usr --sysconfdir=/etc --disable-pam --disable-selinux
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
