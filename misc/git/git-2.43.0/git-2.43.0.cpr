PACKAGE=git
VERSION=2.43.0
CATEGORY=.
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://git-scm.com/"
LICENSE="GPL-2"
SRC_URI="https://www.kernel.org/pub/software/scm/git/git-2.43.0.tar.xz -> git-2.43.0.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    make -j"${JOBS:-1}" prefix=/usr NO_GETTEXT=1 NO_TCLTK=1
}

src_install() {
    make DESTDIR="${D}" prefix=/usr NO_GETTEXT=1 NO_TCLTK=1 install
}
