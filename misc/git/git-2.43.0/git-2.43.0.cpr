PACKAGE=git
VERSION=2.43.0
CATEGORY=.
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://git-scm.com/"
LICENSE="GPL-2"
SRC_URI="https://www.kernel.org/pub/software/scm/git/git-2.43.0.tar.xz -> git-2.43.0.tar.xz"
DEPEND="dev-libs/openssl sys-libs/zlib dev-libs/expat"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl --with-zlib --with-expat"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
