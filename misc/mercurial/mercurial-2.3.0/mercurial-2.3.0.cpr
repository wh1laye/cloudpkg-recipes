PACKAGE=mercurial
VERSION=2.3.0
CATEGORY=.
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://example.com/mercurial"
LICENSE=""GPL-2""
SRC_URI="https://example.com/mercurial/mercurial-2.3.0.tar.gz -> mercurial-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
