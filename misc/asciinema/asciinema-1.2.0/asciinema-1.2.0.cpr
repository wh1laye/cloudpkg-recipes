PACKAGE=asciinema
VERSION=1.2.0
CATEGORY=.
DESCRIPTION="Terminal session recorder"
HOMEPAGE="https://example.com/asciinema"
LICENSE=""GPL-3""
SRC_URI="https://example.com/asciinema/asciinema-1.2.0.tar.gz -> asciinema-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
