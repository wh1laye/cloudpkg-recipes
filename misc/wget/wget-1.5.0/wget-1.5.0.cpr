PACKAGE=wget
VERSION=1.5.0
CATEGORY=.
DESCRIPTION="Network utility to retrieve files from the WWW"
HOMEPAGE="https://example.com/wget"
LICENSE=""GPL-3""
SRC_URI="https://example.com/wget/wget-1.5.0.tar.gz -> wget-1.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
