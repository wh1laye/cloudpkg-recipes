PACKAGE=wget
VERSION=1.24.5
CATEGORY=.
DESCRIPTION="Network utility to retrieve files from the WWW"
HOMEPAGE="https://www.gnu.org/software/wget/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/wget/wget-1.24.5.tar.gz -> wget-1.24.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --with-ssl=openssl
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
