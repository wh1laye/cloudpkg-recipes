PACKAGE=curl
VERSION=8.5.0
CATEGORY=.
DESCRIPTION="URL retrieval utility and library"
HOMEPAGE="https://curl.se/"
LICENSE="MIT"
SRC_URI="https://curl.se/download/curl-8.5.0.tar.gz -> curl-8.5.0.tar.gz"
DEPEND="sys-libs/openssl sys-libs/zlib"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl --with-zlib"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
