PACKAGE=curl
VERSION=8.5.0
CATEGORY=.
DESCRIPTION="URL retrieval utility and library"
HOMEPAGE="https://curl.se/"
LICENSE="MIT"
SRC_URI="https://curl.se/download/curl-8.5.0.tar.gz -> curl-8.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --with-openssl --with-zlib --disable-static
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
