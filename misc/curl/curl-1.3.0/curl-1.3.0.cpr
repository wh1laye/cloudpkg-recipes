PACKAGE=curl
VERSION=1.3.0
CATEGORY=.
DESCRIPTION="URL retrieval utility and library"
HOMEPAGE="https://example.com/curl"
LICENSE=""MIT""
SRC_URI="https://example.com/curl/curl-1.3.0.tar.gz -> curl-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
