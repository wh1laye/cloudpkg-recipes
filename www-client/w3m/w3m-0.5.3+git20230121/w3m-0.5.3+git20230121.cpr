PACKAGE=w3m
VERSION=0.5.3+git20230121
CATEGORY=www-client
DESCRIPTION="Text-based web browser with tables"
HOMEPAGE="https://w3m.sourceforge.io/"
LICENSE="MIT"
SRC_URI="https://github.com/tats/w3m/archive/refs/heads/master.tar.gz -> w3m-0.5.3+git20230121.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="sys-libs/ncurses"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "w3m installed successfully"
}
