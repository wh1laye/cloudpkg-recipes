PACKAGE=chromium
VERSION=120.0.6099.216
CATEGORY=www-client
DESCRIPTION="Chromium web browser"
HOMEPAGE="https://www.chromium.org/"
LICENSE="BSD-3"
SRC_URI="https://commondatastorage.googleapis.com/chromium-browser-snapshots/Linux_x64/120.0.6099.216/chrome-linux.zip -> chromium-120.0.6099.216.zip"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "chromium installed successfully"
}
