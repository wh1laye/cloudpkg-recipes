PACKAGE=firefox
VERSION=121.0
CATEGORY=www-client
DESCRIPTION="Mozilla Firefox web browser"
HOMEPAGE="https://www.mozilla.org/firefox/"
LICENSE="MPL-2.0"
SRC_URI="https://download-installer.cdn.mozilla.net/pub/firefox/releases/121.0/linux-x86_64/en-US/firefox-121.0.tar.bz2 -> firefox-121.0.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "firefox installed successfully"
}
