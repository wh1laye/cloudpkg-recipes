PACKAGE=libsigc++
VERSION=3.4.0
CATEGORY=.
DESCRIPTION="Signal framework for C++"
HOMEPAGE="https://libsigcplus.github.io/"
LICENSE="LGPL-3"
SRC_URI="https://github.com/libsigcplus/libsigcplus3/releases/download/3.4.0/libsigc++-3.4.0.tar.gz -> libsigc++-3.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
