PACKAGE=ace
VERSION=7.0.2
CATEGORY=dev-libs
DESCRIPTION="ADAPTIVE Communication Environment"
HOMEPAGE="https://example.com/ace"
LICENSE="GPL-2"
SRC_URI="https://example.com/ace/ace-7.0.2.tar.gz -> ace-7.0.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
