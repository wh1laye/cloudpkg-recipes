PACKAGE=libxslt
VERSION=1.1.38
CATEGORY=dev-libs
DESCRIPTION="XSLT library"
HOMEPAGE="https://gitlab.gnome.org/GNOME/libxslt"
LICENSE="MIT"
SRC_URI="https://download.gnome.org/sources/libxslt/1.1.38/libxslt-1.1.38.tar.xz -> libxslt-1.1.38.tar.xz"
DEPEND="dev-libs/libxml2"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
