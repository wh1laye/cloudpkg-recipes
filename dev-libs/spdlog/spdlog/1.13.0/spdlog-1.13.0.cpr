PACKAGE=spdlog
VERSION=1.13.0
CATEGORY=.
DESCRIPTION="Fast C++ logging library"
HOMEPAGE="https://github.com/gabime/spdlog"
LICENSE="MIT"
SRC_URI="https://github.com/gabime/spdlog/archive/refs/tags/v1.13.0.tar.gz -> spdlog-1.13.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
