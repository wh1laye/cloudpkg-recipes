PACKAGE=asyncns
VERSION=0.8
CATEGORY=dev-libs
DESCRIPTION="Asynchronous DNS resolver library"
HOMEPAGE="https://example.com/asyncns"
LICENSE="LGPL-2.1"
SRC_URI="https://example.com/asyncns/asyncns-0.8.tar.gz -> asyncns-0.8.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
