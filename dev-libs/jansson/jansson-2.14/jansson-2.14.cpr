PACKAGE=jansson
VERSION=2.14
CATEGORY=dev-libs
DESCRIPTION="C library for encoding, decoding and manipulating JSON"
HOMEPAGE="https://jansson.readthedocs.io/"
LICENSE="MIT"
SRC_URI="https://github.com/akheron/jansson/releases/download/v2.14/jansson-2.14.tar.gz -> jansson-2.14.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
