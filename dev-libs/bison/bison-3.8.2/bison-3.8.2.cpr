PACKAGE=bison
VERSION=3.8.2
CATEGORY=.
DESCRIPTION="Parser generator"
HOMEPAGE="https://www.gnu.org/software/bison/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.gz -> bison-3.8.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
