PACKAGE=nlohmann-json
VERSION=3.11.2
CATEGORY=.
DESCRIPTION="JSON for Modern C++"
HOMEPAGE="https://github.com/nlohmann/json"
LICENSE="MIT"
SRC_URI="https://github.com/nlohmann/json/archive/refs/tags/v3.11.2.tar.gz -> nlohmann-json-3.11.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
