PACKAGE=libevent
VERSION=2.1.12
CATEGORY=.
DESCRIPTION="Event notification library"
HOMEPAGE="https"
LICENSE="//libevent.org/"
SRC_URI="BSD-3 -> libevent-2.1.12.tar.gz"
DEPEND="https://github.com/libevent/libevent/releases/download/release-2.1.12-stable/libevent-2.1.12-stable.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
