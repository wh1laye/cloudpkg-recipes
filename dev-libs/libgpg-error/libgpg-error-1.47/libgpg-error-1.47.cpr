PACKAGE=libgpg-error
VERSION=1.47
CATEGORY=.
DESCRIPTION="Common error values for GnuPG"
HOMEPAGE="https://www.gnupg.org/software/libgpg-error/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-1.47.tar.gz -> libgpg-error-1.47.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
