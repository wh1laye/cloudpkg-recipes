PACKAGE=libconfig
VERSION=1.7.3
CATEGORY=.
DESCRIPTION="Configuration file library"
HOMEPAGE="https"
LICENSE="//hyperrealm.com/libconfig/"
SRC_URI="LGPL-2.1 -> libconfig-1.7.3.tar.gz"
DEPEND="https://hyperrealm.com/libconfig/libconfig-1.7.3.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
