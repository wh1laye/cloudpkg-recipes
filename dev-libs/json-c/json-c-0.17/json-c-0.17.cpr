PACKAGE=json-c
VERSION=0.17
CATEGORY=dev-libs
DESCRIPTION="JSON manipulation library"
HOMEPAGE="https://github.com/json-c/json-c"
LICENSE="MIT"
SRC_URI="https://github.com/json-c/json-c/archive/refs/tags/json-c-0.17-20230511.tar.gz -> json-c-0.17.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
