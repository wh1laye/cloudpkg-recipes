PACKAGE=npth
VERSION=1.6
CATEGORY=.
DESCRIPTION="New GNU Portable Threads"
HOMEPAGE="https://www.gnupg.org/software/npth/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/ftp/gcrypt/npth/npth-1.6.tar.gz -> npth-1.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
