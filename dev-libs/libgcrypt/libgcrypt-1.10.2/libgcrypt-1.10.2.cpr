PACKAGE=libgcrypt
VERSION=1.10.2
CATEGORY=.
DESCRIPTION="Cryptographic library"
HOMEPAGE="https://www.gnupg.org/software/libgcrypt/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.10.2.tar.gz -> libgcrypt-1.10.2.tar.gz"
DEPEND="dev-libs/libgpg-error"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
