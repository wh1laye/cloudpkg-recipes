PACKAGE=asio
VERSION=1.28.0
CATEGORY=dev-libs
DESCRIPTION="Asynchronous I/O library"
HOMEPAGE="https://example.com/asio"
LICENSE="BSL-1.0"
SRC_URI="https://example.com/asio/asio-1.28.0.tar.gz -> asio-1.28.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
