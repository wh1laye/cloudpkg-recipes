PACKAGE=ann
VERSION=1.1.2
CATEGORY=dev-libs
DESCRIPTION="Approximate Nearest Neighbor"
HOMEPAGE="https://example.com/ann"
LICENSE="LGPL-3"
SRC_URI="https://example.com/ann/ann-1.1.2.tar.gz -> ann-1.1.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
