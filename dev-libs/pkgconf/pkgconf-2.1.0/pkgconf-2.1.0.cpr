PACKAGE=pkgconf
VERSION=2.1.0
CATEGORY=.
DESCRIPTION="Package configuration utility"
HOMEPAGE="https://github.com/pkgconf/pkgconf"
LICENSE="BSD-3"
SRC_URI="https://github.com/pkgconf/pkgconf/archive/refs/tags/pkgconf-2.1.0.tar.gz -> pkgconf-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
