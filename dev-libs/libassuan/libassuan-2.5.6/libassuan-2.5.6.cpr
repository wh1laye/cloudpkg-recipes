PACKAGE=libassuan
VERSION=2.5.6
CATEGORY=.
DESCRIPTION="IPC library for GnuPG"
HOMEPAGE="https://www.gnupg.org/software/libassuan/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/ftp/gcrypt/libassuan/libassuan-2.5.6.tar.gz -> libassuan-2.5.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
