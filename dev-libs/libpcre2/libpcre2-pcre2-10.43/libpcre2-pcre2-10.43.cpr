PACKAGE=libpcre2
VERSION=pcre2-10.43
CATEGORY=.
DESCRIPTION="Perl Compatible Regular Expressions v2"
HOMEPAGE="https"
LICENSE="//www.pcre.org/"
SRC_URI="BSD-3 -> libpcre2-pcre2-10.43.tar.gz"
DEPEND="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
