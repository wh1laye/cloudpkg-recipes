PACKAGE=libuuid
VERSION=1.0.3
CATEGORY=.
DESCRIPTION="UUID library"
HOMEPAGE="https"
LICENSE="//sourceforge.net/projects/libuuid/"
SRC_URI="BSD-3 -> libuuid-1.0.3.tar.gz"
DEPEND="https://sourceforge.net/projects/libuuid/files/libuuid-1.0.3.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
