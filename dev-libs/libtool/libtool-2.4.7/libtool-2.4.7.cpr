PACKAGE=libtool
VERSION=2.4.7
CATEGORY=.
DESCRIPTION="Generic library support script"
HOMEPAGE="https://www.gnu.org/software/libtool/"
LICENSE="GPL-2"
SRC_URI="https://ftp.gnu.org/gnu/libtool/libtool-2.4.7.tar.gz -> libtool-2.4.7.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
