PACKAGE=flex
VERSION=2.6.4
CATEGORY=.
DESCRIPTION="Lexical analyzer generator"
HOMEPAGE="https://www.gnu.org/software/flex/"
LICENSE="BSD-3"
SRC_URI="https://ftp.gnu.org/gnu/flex/flex-2.6.4.tar.gz -> flex-2.6.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
