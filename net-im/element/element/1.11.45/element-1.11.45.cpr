PACKAGE=element
VERSION=1.11.45
CATEGORY=.
DESCRIPTION="Matrix web client"
HOMEPAGE="https://element.io/"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/vector-im/element-web/archive/refs/tags/v1.11.45.tar.gz -> element-1.11.45.tar.gz"
DEPEND="dev-lang/nodejs"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
