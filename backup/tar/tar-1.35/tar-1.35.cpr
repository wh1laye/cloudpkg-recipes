PACKAGE=tar
VERSION=1.35
CATEGORY=.
DESCRIPTION="GNU tar archiver"
HOMEPAGE="https://www.gnu.org/software/tar/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/tar/tar-1.35.tar.gz -> tar-1.35.tar.gz"
DEPEND="sys-libs/acl sys-libs/selinux"
RDEPEND="sys-libs/acl sys-libs/selinux"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "tar installed successfully"
}
