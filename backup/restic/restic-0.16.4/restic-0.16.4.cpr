PACKAGE=restic
VERSION=0.16.4
CATEGORY=.
DESCRIPTION="Backup program with deduplication"
HOMEPAGE="https://restic.net/"
LICENSE="BSD-2"
SRC_URI="https://github.com/restic/restic/releases/download/v0.16.4/restic-0.16.4.tar.gz -> restic-0.16.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "restic installed successfully"
}
