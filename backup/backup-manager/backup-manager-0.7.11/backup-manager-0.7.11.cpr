PACKAGE=backup-manager
VERSION=0.7.11
CATEGORY=.
DESCRIPTION="Command-line backup tool"
HOMEPAGE="https://example.com/backup-manager"
LICENSE="GPL-3"
SRC_URI="https://example.com/backup-manager/backup-manager-0.7.11.tar.gz -> backup-manager-0.7.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
