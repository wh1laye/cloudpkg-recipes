PACKAGE=rsync
VERSION=3.2.7
CATEGORY=.
DESCRIPTION="Fast and versatile file copying tool"
HOMEPAGE="https://rsync.samba.org/"
LICENSE="GPL-3"
SRC_URI="https://github.com/RsyncProject/rsync/archive/refs/tags/v3.2.7.tar.gz -> rsync-3.2.7.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
