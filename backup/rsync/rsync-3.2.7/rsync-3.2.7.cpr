PACKAGE=rsync
VERSION=3.2.7
CATEGORY=.
DESCRIPTION="Fast and versatile file copying tool"
HOMEPAGE="https://rsync.samba.org/"
LICENSE="GPL-3"
SRC_URI="https://download.samba.org/pub/rsync/src/rsync-3.2.7.tar.gz -> rsync-3.2.7.tar.gz"
DEPEND="sys-libs/acl sys-libs/xxhash"
RDEPEND="sys-libs/acl sys-libs/xxhash"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "rsync installed successfully"
}
