PACKAGE=duplicity
VERSION=2.2.0
CATEGORY=.
DESCRIPTION="Encrypted bandwidth-efficient backup"
HOMEPAGE="https://www.nongnu.org/duplicity/"
LICENSE="GPL-3"
SRC_URI="https://launchpad.net/duplicity/2.2-series/2.2.0/+download/duplicity-2.2.0.tar.gz -> duplicity-2.2.0.tar.gz"
DEPEND="dev-lang/python"
RDEPEND="dev-lang/python"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "duplicity installed successfully"
}
