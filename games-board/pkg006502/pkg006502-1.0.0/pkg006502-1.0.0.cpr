PACKAGE=pkg006502
VERSION=1.0.0
CATEGORY=.
DESCRIPTION="Package 6502"
HOMEPAGE="https://pkg006502.org/"
LICENSE="MIT"
SRC_URI="https://downloads.pkg006502.org/pkg006502-1.0.0.tar.gz -> pkg006502-1.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
