PACKAGE=syslog-ng
VERSION=4.5.0
CATEGORY=.
DESCRIPTION="System logging daemon"
HOMEPAGE="https://www.syslog-ng.com/"
LICENSE="GPL-2"
SRC_URI="https://github.com/syslog-ng/syslog-ng/releases/download/syslog-ng-4.5.0/syslog-ng-4.5.0.tar.gz -> syslog-ng-4.5.0.tar.gz"
DEPEND="libs/eventlog"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
