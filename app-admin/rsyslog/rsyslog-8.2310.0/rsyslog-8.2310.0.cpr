PACKAGE=rsyslog
VERSION=8.2310.0
CATEGORY=app-admin
DESCRIPTION="Reliable and extended syslog daemon"
HOMEPAGE="https://www.rsyslog.com/"
LICENSE="Apache-2.0"
SRC_URI="https://www.rsyslog.com/files/download/rsyslog/rsyslog-${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="dev-libs/libestr dev-libs/liblogging sys-libs/zlib"
RDEPEND="${DEPEND}"
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-imfile --enable-imtcp --enable-imudp --enable-mmsnmptrapd --enable-mmjsonparse"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/rsyslog \
        --localstatedir=/var \
        --disable-static \
        ${BUILD_FLAGS}
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    insinto /etc/rsyslog
    doins runtime/rsyslog.conf
    keepdir /var/spool/rsyslog
    insinto /usr/lib/systemd/system
    newins tools/rsyslog.service rsyslog.service
    dodoc README.md CHANGELOG
}
pkg_postinst() {
    einfo "rsyslog installed"
    einfo "Configure /etc/rsyslog/rsyslog.conf"
    einfo "Enable with: rc-update add rsyslog default"
}
