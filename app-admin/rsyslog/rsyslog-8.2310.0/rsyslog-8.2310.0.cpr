PACKAGE=rsyslog
VERSION=8.2310.0
CATEGORY=.
DESCRIPTION="Reliable system logging"
HOMEPAGE="https://www.rsyslog.com/"
LICENSE="GPL-3"
SRC_URI="https://www.rsyslog.com/files/download/rsyslog/rsyslog-8.2310.0.tar.gz -> rsyslog-8.2310.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
