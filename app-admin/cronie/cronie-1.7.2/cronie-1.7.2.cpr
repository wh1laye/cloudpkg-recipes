PACKAGE=cronie
VERSION=1.7.2
CATEGORY=.
DESCRIPTION="Cron daemon"
HOMEPAGE="https://github.com/cronie-crond/cronie"
LICENSE="BSD-3"
SRC_URI="https://github.com/cronie-crond/cronie/releases/download/v1.7.2/cronie-1.7.2.tar.gz -> cronie-1.7.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
