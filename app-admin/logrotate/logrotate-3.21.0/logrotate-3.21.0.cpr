PACKAGE=logrotate
VERSION=3.21.0
CATEGORY=.
DESCRIPTION="Log rotation utility"
HOMEPAGE="https://github.com/logrotate/logrotate"
LICENSE="GPL-2"
SRC_URI="https://github.com/logrotate/logrotate/releases/download/3.21.0/logrotate-3.21.0.tar.gz -> logrotate-3.21.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
