PACKAGE=logrotate
VERSION=3.21.0
CATEGORY=app-admin
DESCRIPTION="Log file rotation utility"
HOMEPAGE="https://github.com/logrotate/logrotate"
LICENSE="MIT"
SRC_URI="https://github.com/logrotate/logrotate/releases/download/${VERSION}/logrotate-${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="sys-libs/popt sys-libs/acl"
RDEPEND="${DEPEND}"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --with-state-file-path=/var/lib/logrotate/status \
        --enable-acl \
        --enable-xz
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    insinto /etc/logrotate.d
    doins tests/logrotate.conf
    keepdir /var/lib/logrotate
    dodoc README.md CHANGELOG.md
}
pkg_postinst() {
    einfo "logrotate installed"
    einfo "Configure /etc/logrotate.conf and /etc/logrotate.d/"
    einfo "Add to cron: daily /usr/sbin/logrotate /etc/logrotate.conf"
}
