PACKAGE=patch
VERSION=2.7.6
CATEGORY=.
DESCRIPTION="GNU Patch - apply diff files to originals"
HOMEPAGE="https://www.gnu.org/software/patch/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/patch/patch-2.7.6.tar.gz -> patch-2.7.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}