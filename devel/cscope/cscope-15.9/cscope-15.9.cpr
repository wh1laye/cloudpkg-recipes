PACKAGE=cscope
VERSION=15.9
CATEGORY=.
DESCRIPTION="Interactive C symbol cross-reference"
HOMEPAGE="http://cscope.sourceforge.net/"
LICENSE="BSD-3"
SRC_URI="https://sourceforge.net/projects/cscope/files/cscope-15.9.tar.gz/download -> cscope-15.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
