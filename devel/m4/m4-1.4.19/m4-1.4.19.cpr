PACKAGE=m4
VERSION=1.4.19
CATEGORY=.
DESCRIPTION="GNU M4 - macro processor"
HOMEPAGE="https://www.gnu.org/software/m4/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/m4/m4-1.4.19.tar.gz -> m4-1.4.19.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}