PACKAGE=astyle
VERSION=2.3.0
CATEGORY=.
DESCRIPTION="Source code beautifier"
HOMEPAGE="https://example.com/astyle"
LICENSE=""LGPL-3""
SRC_URI="https://example.com/astyle/astyle-2.3.0.tar.gz -> astyle-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
