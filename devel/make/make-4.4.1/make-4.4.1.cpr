PACKAGE=make
VERSION=4.4.1
CATEGORY=.
DESCRIPTION="GNU Make build utility"
HOMEPAGE="https://www.gnu.org/software/make/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz -> make-4.4.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}