PACKAGE=autogen
VERSION=1.2.0
CATEGORY=.
DESCRIPTION="Automated text file generator"
HOMEPAGE="https://example.com/autogen"
LICENSE=""GPL-3""
SRC_URI="https://example.com/autogen/autogen-1.2.0.tar.gz -> autogen-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
