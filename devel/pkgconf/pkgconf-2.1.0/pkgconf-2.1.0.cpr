PACKAGE=pkgconf
VERSION=2.1.0
CATEGORY=.
DESCRIPTION="Package configuration utility"
HOMEPAGE="https"
LICENSE="//github.com/pkgconf/pkgconf"
SRC_URI="BSD-3 -> pkgconf-2.1.0.tar.gz"
DEPEND="https://github.com/pkgconf/pkgconf/archive/refs/tags/pkgconf-2.1.0.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
