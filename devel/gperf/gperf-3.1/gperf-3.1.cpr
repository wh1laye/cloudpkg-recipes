PACKAGE=gperf
VERSION=3.1
CATEGORY=.
DESCRIPTION="Perfect hash function generator"
HOMEPAGE="https"
LICENSE="//www.gnu.org/software/gperf/"
SRC_URI="GPL-3 -> gperf-3.1.tar.gz"
DEPEND="https://ftp.gnu.org/gnu/gperf/gperf-3.1.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
