PACKAGE=gdb
VERSION=1.3.0
CATEGORY=.
DESCRIPTION="GNU Debugger"
HOMEPAGE="https://example.com/gdb"
LICENSE=""GPL-3""
SRC_URI="https://example.com/gdb/gdb-1.3.0.tar.gz -> gdb-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
