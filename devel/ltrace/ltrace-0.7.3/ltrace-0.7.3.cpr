PACKAGE=ltrace
VERSION=0.7.3
CATEGORY=.
DESCRIPTION="Library call tracer"
HOMEPAGE="https://www.ltrace.org/"
LICENSE="GPL-2"
SRC_URI="https://www.ltrace.org/files/ltrace-0.7.3.tar.gz -> ltrace-0.7.3.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
