PACKAGE=ltrace
VERSION=0.7.3
CATEGORY=.
DESCRIPTION="Library call tracer"
HOMEPAGE="https://www.ltrace.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/dkogan/ltrace/archive/refs/tags/0.7.3.tar.gz -> ltrace-0.7.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    mkdir -p config/autoconf config/m4 && autoreconf -fi && ./configure --prefix=/usr --disable-werror
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
