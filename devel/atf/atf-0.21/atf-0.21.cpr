PACKAGE=atf
VERSION=0.21
CATEGORY=.
DESCRIPTION="Automated Testing Framework"
HOMEPAGE="https://example.com/atf"
LICENSE="BSD-2"
SRC_URI="https://example.com/atf/atf-0.21.tar.gz -> atf-0.21.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
