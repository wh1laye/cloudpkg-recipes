PACKAGE=ninja
VERSION=1.11.1
CATEGORY=.
DESCRIPTION="Small build system"
HOMEPAGE="https"
LICENSE="//ninja-build.org/"
SRC_URI="Apache-2.0 -> ninja-1.11.1.tar.gz"
DEPEND="https://github.com/ninja-build/ninja/archive/refs/tags/v1.11.1.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
