PACKAGE=automake
VERSION=2.4.0
CATEGORY=.
DESCRIPTION="GNU automake"
HOMEPAGE="https://example.com/automake"
LICENSE=""GPL-2""
SRC_URI="https://example.com/automake/automake-2.4.0.tar.gz -> automake-2.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
