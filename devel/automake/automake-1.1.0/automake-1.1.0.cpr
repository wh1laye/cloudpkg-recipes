PACKAGE=automake
VERSION=1.1.0
CATEGORY=.
DESCRIPTION="GNU automake"
HOMEPAGE="https://example.com/automake"
LICENSE=""GPL-2""
SRC_URI="https://example.com/automake/automake-1.1.0.tar.gz -> automake-1.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
