PACKAGE=valgrind
VERSION=3.21.0
CATEGORY=.
DESCRIPTION="Memory debugging and profiling tool"
HOMEPAGE="https://www.valgrind.org/"
LICENSE="GPL-2"
SRC_URI="https://sourceware.org/pub/valgrind/valgrind-3.21.0.tar.bz2 -> valgrind-3.21.0.tar.bz2"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
