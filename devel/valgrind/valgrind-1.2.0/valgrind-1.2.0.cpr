PACKAGE=valgrind
VERSION=1.2.0
CATEGORY=.
DESCRIPTION="Memory debugging and profiling tool"
HOMEPAGE="https://example.com/valgrind"
LICENSE=""GPL-2""
SRC_URI="https://example.com/valgrind/valgrind-1.2.0.tar.gz -> valgrind-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
