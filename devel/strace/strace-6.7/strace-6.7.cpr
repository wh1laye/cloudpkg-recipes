PACKAGE=strace
VERSION=6.7
CATEGORY=.
DESCRIPTION="System call tracer"
HOMEPAGE="https://strace.io/"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/strace/strace/releases/download/v6.7/strace-6.7.tar.xz -> strace-6.7.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
