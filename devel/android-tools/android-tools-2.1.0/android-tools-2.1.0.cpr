PACKAGE=android-tools
VERSION=2.1.0
CATEGORY=.
DESCRIPTION="Android SDK tools"
HOMEPAGE="https://example.com/android-tools"
LICENSE=""Apache-2.0""
SRC_URI="https://example.com/android-tools/android-tools-2.1.0.tar.gz -> android-tools-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
