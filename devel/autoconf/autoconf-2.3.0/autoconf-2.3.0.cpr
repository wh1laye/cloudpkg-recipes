PACKAGE=autoconf
VERSION=2.3.0
CATEGORY=.
DESCRIPTION="GNU autoconf"
HOMEPAGE="https://example.com/autoconf"
LICENSE=""GPL-3""
SRC_URI="https://example.com/autoconf/autoconf-2.3.0.tar.gz -> autoconf-2.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
