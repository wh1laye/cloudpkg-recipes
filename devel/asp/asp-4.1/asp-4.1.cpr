PACKAGE=asp
VERSION=4.1
CATEGORY=.
DESCRIPTION="Apple Service Provider"
HOMEPAGE="https://example.com/asp"
LICENSE="GPL-2"
SRC_URI="https://example.com/asp/asp-4.1.tar.gz -> asp-4.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
