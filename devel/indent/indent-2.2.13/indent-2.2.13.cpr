PACKAGE=indent
VERSION=2.2.13
CATEGORY=.
DESCRIPTION="C code formatter"
HOMEPAGE="https://www.gnu.org/software/indent/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/indent/indent-2.2.13.tar.gz -> indent-2.2.13.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
