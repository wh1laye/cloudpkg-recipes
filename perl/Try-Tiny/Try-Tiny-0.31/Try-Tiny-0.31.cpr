PACKAGE=Try-Tiny
VERSION=0.31
CATEGORY=.
DESCRIPTION="Minimal try/catch with proper localization"
HOMEPAGE="https://metacpan.org/pod/Try::Tiny"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/E/ET/ETHER/Try-Tiny-0.31.tar.gz -> Try-Tiny-0.31.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    perl Makefile.PL INSTALLDIRS=vendor
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
