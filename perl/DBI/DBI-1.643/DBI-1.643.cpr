PACKAGE=DBI
VERSION=1.643
CATEGORY=.
DESCRIPTION="Perl Database Interface"
HOMEPAGE="https://dbi.perl.org/"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/T/TI/TIMB/DBI-1.643.tar.gz -> DBI-1.643.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "DBI installed successfully"
}
