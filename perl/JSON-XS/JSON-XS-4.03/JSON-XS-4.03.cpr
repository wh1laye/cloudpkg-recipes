PACKAGE=JSON-XS
VERSION=4.03
CATEGORY=.
DESCRIPTION="JSON serialiser/deserialiser"
HOMEPAGE="https://metacpan.org/pod/JSON::XS"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/M/ML/MLEHMANN/JSON-XS-4.03.tar.gz -> JSON-XS-4.03.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "JSON-XS installed successfully"
}
