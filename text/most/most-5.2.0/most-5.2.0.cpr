PACKAGE=most
VERSION=5.2.0
CATEGORY=.
DESCRIPTION="Paging program"
HOMEPAGE="https://www.jedsoft.org/most/"
LICENSE="GPL-2"
SRC_URI="https://www.jedsoft.org/releases/most/most-5.2.0.tar.gz -> most-5.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
