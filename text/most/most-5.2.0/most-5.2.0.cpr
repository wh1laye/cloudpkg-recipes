PACKAGE=most
VERSION=5.2.0
CATEGORY=.
DESCRIPTION="Paging program"
HOMEPAGE="https://www.jedsoft.org/most/"
LICENSE="GPL-2"
SRC_URI="https://www.jedsoft.org/snapshots/most-5.2.0.tar.gz -> most-5.2.0.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="sys-libs/ncurses"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
