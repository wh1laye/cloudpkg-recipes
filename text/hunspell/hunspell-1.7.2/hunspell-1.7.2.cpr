PACKAGE=hunspell
VERSION=1.7.2
CATEGORY=.
DESCRIPTION="Spell checker and morphological analyzer"
HOMEPAGE="https://hunspell.github.io/"
LICENSE="MPL-2.0"
SRC_URI="https://github.com/hunspell/hunspell/archive/refs/tags/v1.7.2.tar.gz -> hunspell-1.7.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    autoreconf -fi && ./configure --prefix=/usr --disable-static
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
