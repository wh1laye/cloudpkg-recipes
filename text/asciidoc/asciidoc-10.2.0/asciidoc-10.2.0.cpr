PACKAGE=asciidoc
VERSION=10.2.0
CATEGORY=.
DESCRIPTION="Text document format for writing documentation"
HOMEPAGE="https://example.com/asciidoc"
LICENSE="GPL-2"
SRC_URI="https://example.com/asciidoc/asciidoc-10.2.0.tar.gz -> asciidoc-10.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
