PACKAGE=less
VERSION=643
CATEGORY=.
DESCRIPTION="GNU pager"
HOMEPAGE="https://www.greenwoodsoftware.com/less/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/less/less-643.tar.gz -> less-643.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
