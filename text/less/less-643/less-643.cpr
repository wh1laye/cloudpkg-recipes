PACKAGE=less
VERSION=643
CATEGORY=.
DESCRIPTION="GNU pager"
HOMEPAGE="https://www.greenwoodsoftware.com/less/"
LICENSE="GPL-3"
SRC_URI="https://www.greenwoodsoftware.com/less/less-643.tar.gz -> less-643.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="sys-libs/ncurses"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
