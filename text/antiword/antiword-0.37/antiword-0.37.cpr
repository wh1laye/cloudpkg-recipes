PACKAGE=antiword
VERSION=0.37
CATEGORY=.
DESCRIPTION="Microsoft Word reader"
HOMEPAGE="https://example.com/antiword"
LICENSE="GPL-2"
SRC_URI="https://example.com/antiword/antiword-0.37.tar.gz -> antiword-0.37.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
