PACKAGE=bonnie++
VERSION=2.00a
CATEGORY=app-benchmark
DESCRIPTION="Hard drive and file system performance test"
HOMEPAGE="https://www.coker.com.au/bonnie++/"
LICENSE="GPL-2"
SRC_URI="http://www.coker.com.au/bonnie++/bonnie++-2.00a.tgz -> bonnie++-2.00a.tgz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
