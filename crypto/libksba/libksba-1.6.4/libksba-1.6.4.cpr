PACKAGE=libksba
VERSION=1.6.4
CATEGORY=.
DESCRIPTION="X.509 library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-3"
SRC_URI="https://gnupg.org/ftp/gcrypt/libksba/libksba-1.6.4.tar.bz2 -> libksba-1.6.4.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --disable-static
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
