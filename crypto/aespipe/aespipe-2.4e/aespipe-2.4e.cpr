PACKAGE=aespipe
VERSION=2.4e
CATEGORY=.
DESCRIPTION="AES pipe"
HOMEPAGE="https://example.com/aespipe"
LICENSE="GPL-2"
SRC_URI="https://example.com/aespipe/aespipe-2.4e.tar.gz -> aespipe-2.4e.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
