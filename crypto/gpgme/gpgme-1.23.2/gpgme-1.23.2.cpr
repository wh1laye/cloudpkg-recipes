PACKAGE=gpgme
VERSION=1.23.2
CATEGORY=.
DESCRIPTION="GnuPG Made Easy library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://gnupg.org/ftp/gcrypt/gpgme/gpgme-1.23.2.tar.bz2 -> gpgme-1.23.2.tar.bz2"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --disable-static --disable-gpgconf-test --disable-gpg-test --disable-gpgsm-test --disable-g13-test
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
