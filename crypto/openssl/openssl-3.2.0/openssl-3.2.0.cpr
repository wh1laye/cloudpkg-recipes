PACKAGE=openssl
VERSION=3.2.0
CATEGORY=.
DESCRIPTION="SSL/TLS toolkit"
HOMEPAGE="https://openssl.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.openssl.org/openssl-3.2.0.tar.gz -> openssl-3.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    true
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
