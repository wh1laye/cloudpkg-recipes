PACKAGE=libgcrypt
VERSION=1.10.2
CATEGORY=.
DESCRIPTION="General purpose cryptographic library"
HOMEPAGE="https://www.gnupg.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.gnupg.org/download/GNUPG/libgcrypt/libgcrypt-1.10.2.tar.bz2 -> libgcrypt-1.10.2.tar.bz2"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
