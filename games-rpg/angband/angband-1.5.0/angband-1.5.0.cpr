PACKAGE=angband
VERSION=1.5.0
CATEGORY=.
DESCRIPTION="Dungeon exploration game"
HOMEPAGE="https://example.com/angband"
LICENSE=""GPL-2""
SRC_URI="https://example.com/angband/angband-1.5.0.tar.gz -> angband-1.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
