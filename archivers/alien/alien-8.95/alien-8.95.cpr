PACKAGE=alien
VERSION=8.95
CATEGORY=.
DESCRIPTION="Convert between different package formats"
HOMEPAGE="https://example.com/alien"
LICENSE="GPL-2"
SRC_URI="https://example.com/alien/alien-8.95.tar.gz -> alien-8.95.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
