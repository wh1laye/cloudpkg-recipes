PACKAGE=unrar
VERSION=6.2.10
CATEGORY=.
DESCRIPTION="Extract files from RAR archives"
HOMEPAGE="https://www.rarlab.com/"
LICENSE="UnRAR"
SRC_URI="https://www.rarlab.com/rar/unrarsrc-6.2.10.tar.gz -> unrar-6.2.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    install -Dm755 unrar "${D}/usr/bin/unrar"
}
