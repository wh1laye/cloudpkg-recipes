PACKAGE=bzip2
VERSION=1.0.8
CATEGORY=.
DESCRIPTION="Compression utility"
HOMEPAGE="https://bzip2.org/"
LICENSE="BSD-4"
SRC_URI="https://fossies.org/linux/misc/bzip2-1.0.8.tar.gz -> bzip2-1.0.8.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    make -j"${JOBS:-1}" -f Makefile-libbz2_so && make -j"${JOBS:-1}"
}

src_install() {
    install -d "${D}/usr/bin" "${D}/usr/lib" "${D}/usr/include"
        install -m755 bzip2 bunzip2 bzcat "${D}/usr/bin"
        install -m755 libbz2.so.1.0.8 "${D}/usr/lib"
        ln -s libbz2.so.1.0.8 "${D}/usr/lib/libbz2.so.1.0"
        ln -s libbz2.so.1.0 "${D}/usr/lib/libbz2.so"
        install -m644 bzlib.h "${D}/usr/include"
}
