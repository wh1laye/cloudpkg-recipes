PACKAGE=bzip2
VERSION=1.0.8
CATEGORY=.
DESCRIPTION="Compression utility"
HOMEPAGE="https://bzip2.org/"
LICENSE="BSD-4"
SRC_URI="https://downloads.bzip2.org/bzip2-1.0.8.tar.gz -> bzip2-1.0.8.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
