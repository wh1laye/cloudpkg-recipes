PACKAGE=php
VERSION=8.3.12
CATEGORY=dev-php
DESCRIPTION="PHP scripting language"
HOMEPAGE="https://www.php.net/"
LICENSE="PHP-3.01"
SRC_URI="https://www.php.net/distributions/php-8.3.12.tar.gz -> php-8.3.12.tar.gz"
DEPEND="sys-libs/zlib dev-libs/openssl"
RDEPEND="sys-libs/zlib dev-libs/openssl"
SLOT=8.3
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "php installed successfully"
}
