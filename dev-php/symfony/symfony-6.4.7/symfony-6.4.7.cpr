PACKAGE=symfony
VERSION=6.4.7
CATEGORY=dev-php
DESCRIPTION="PHP framework for web projects"
HOMEPAGE="https://symfony.com/"
LICENSE="MIT"
SRC_URI="https://github.com/symfony/symfony/archive/refs/tags/v6.4.7.tar.gz -> symfony-6.4.7.tar.gz"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "symfony installed successfully"
}
