PACKAGE=laravel
VERSION=10.48.12
CATEGORY=dev-php
DESCRIPTION="PHP web application framework"
HOMEPAGE="https://laravel.com/"
LICENSE="MIT"
SRC_URI="https://github.com/laravel/laravel/archive/refs/tags/v10.48.12.tar.gz -> laravel-10.48.12.tar.gz"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "laravel installed successfully"
}
