PACKAGE=composer
VERSION=2.6.5
CATEGORY=dev-php
DESCRIPTION="Dependency Manager for PHP"
HOMEPAGE="https://getcomposer.org/"
LICENSE="MIT"
SRC_URI="https://getcomposer.org/download/2.6.5/composer.phar -> composer-2.6.5.phar"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "composer installed successfully"
}
