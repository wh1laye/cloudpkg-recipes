PACKAGE=phpunit
VERSION=10.5.12
CATEGORY=dev-php
DESCRIPTION="PHP testing framework"
HOMEPAGE="https://phpunit.de/"
LICENSE="BSD-3"
SRC_URI="https://phpunit.de/get/phpunit-10.5.12.phar -> phpunit-10.5.12.phar"
DEPEND="dev-lang/php"
RDEPEND="dev-lang/php"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "phpunit installed successfully"
}
