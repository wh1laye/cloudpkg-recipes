PACKAGE=gv
VERSION=3.7.4
CATEGORY=.
DESCRIPTION="PostScript and PDF viewer"
HOMEPAGE="https://www.gnu.org/software/gv/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/gv/gv-3.7.4.tar.gz -> gv-3.7.4.tar.gz"
DEPEND="app-text/ghostscript"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
