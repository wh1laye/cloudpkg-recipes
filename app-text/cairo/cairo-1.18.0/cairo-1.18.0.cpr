PACKAGE=cairo
VERSION=1.18.0
CATEGORY=.
DESCRIPTION="Vector graphics library"
HOMEPAGE="https://cairographics.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.cairographics.org/releases/cairo-1.18.0.tar.gz -> cairo-1.18.0.tar.gz"
DEPEND="libs/pixman libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
