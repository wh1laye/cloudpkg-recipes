PACKAGE=iso-codes
VERSION=4.15.0
CATEGORY=.
DESCRIPTION="ISO country/currency/language codes"
HOMEPAGE="https://salsa.debian.org/iso-codes-team/iso-codes"
LICENSE="LGPL-2.1"
SRC_URI="https://salsa.debian.org/iso-codes-team/iso-codes/-/archive/iso-codes-4.15.0/iso-codes-4.15.0.tar.gz -> iso-codes-4.15.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
