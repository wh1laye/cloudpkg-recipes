PACKAGE=awk
VERSION=5.2.2
CATEGORY=app-text
DESCRIPTION="Pattern scanning and processing language"
HOMEPAGE="https://example.com/awk"
LICENSE="GPL-3"
SRC_URI="https://example.com/awk/awk-5.2.2.tar.gz -> awk-5.2.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
