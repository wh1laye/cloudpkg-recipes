PACKAGE=okular
VERSION=23.08.3
CATEGORY=.
DESCRIPTION="Universal document viewer"
HOMEPAGE="https://okular.kde.org/"
LICENSE="GPL-2"
SRC_URI="https://download.kde.org/stable/okular/23.08.3/okular-23.08.3.tar.xz -> okular-23.08.3.tar.xz"
DEPEND="dev-libs/qt5 app-text/poppler"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
