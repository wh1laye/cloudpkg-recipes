PACKAGE=ansifilter
VERSION=2.19
CATEGORY=app-text
DESCRIPTION="ANSI escape sequence filter"
HOMEPAGE="https://example.com/ansifilter"
LICENSE="GPL-3"
SRC_URI="https://example.com/ansifilter/ansifilter-2.19.tar.gz -> ansifilter-2.19.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
