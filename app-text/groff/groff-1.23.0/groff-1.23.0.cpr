PACKAGE=groff
VERSION=1.23.0
CATEGORY=.
DESCRIPTION="GNU troff document formatting system"
HOMEPAGE="https://www.gnu.org/software/groff/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/groff/groff-1.23.0.tar.gz -> groff-1.23.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}