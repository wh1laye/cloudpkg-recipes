PACKAGE=texinfo
VERSION=7.1
CATEGORY=.
DESCRIPTION="GNU documentation system"
HOMEPAGE="https://www.gnu.org/software/texinfo/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/texinfo/texinfo-7.1.tar.gz -> texinfo-7.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}