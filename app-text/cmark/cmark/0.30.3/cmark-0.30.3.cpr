PACKAGE=cmark
VERSION=0.30.3
CATEGORY=.
DESCRIPTION="CommonMark parsing and rendering library"
HOMEPAGE="https://github.com/commonmark/cmark"
LICENSE="BSD-2"
SRC_URI="https://github.com/commonmark/cmark/archive/refs/tags/0.30.3.tar.gz -> cmark-0.30.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
