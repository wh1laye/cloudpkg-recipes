PACKAGE=aspell
VERSION=0.60.8
CATEGORY=.
DESCRIPTION="GNU spell checker"
HOMEPAGE="http://aspell.net/"
LICENSE="LGPL-2.1"
SRC_URI="https://ftp.gnu.org/gnu/aspell/aspell-0.60.8.tar.gz -> aspell-0.60.8.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
