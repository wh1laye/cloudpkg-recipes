PACKAGE=docbook-xml
VERSION=4.5
CATEGORY=.
DESCRIPTION="DocBook XML DTD"
HOMEPAGE="https://docbook.org/"
LICENSE="MIT"
SRC_URI="https://docbook.org/xml/4.5/docbook-xml-4.5.zip -> docbook-xml-4.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
