PACKAGE=lowdown
VERSION=1.1.0
CATEGORY=.
DESCRIPTION="Simple markdown translator"
HOMEPAGE="https://kristaps.bsd.lv/lowdown/"
LICENSE="BSD-2"
SRC_URI="https://kristaps.bsd.lv/lowdown/snapshots/lowdown-1.1.0.tar.gz -> lowdown-1.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
