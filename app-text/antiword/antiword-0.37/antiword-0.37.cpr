PACKAGE=antiword
VERSION=0.37
CATEGORY=app-text
DESCRIPTION="Microsoft Word reader"
HOMEPAGE="https://example.com/antiword"
LICENSE="GPL-2"
SRC_URI="https://example.com/antiword/antiword-0.37.tar.gz -> antiword-0.37.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
