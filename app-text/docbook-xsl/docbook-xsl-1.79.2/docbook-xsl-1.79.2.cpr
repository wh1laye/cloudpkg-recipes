PACKAGE=docbook-xsl
VERSION=1.79.2
CATEGORY=.
DESCRIPTION="DocBook XSL stylesheets"
HOMEPAGE="https://docbook.org/"
LICENSE="MIT"
SRC_URI="https://github.com/docbook/xslt10-stylesheets/releases/download/release%2F1.79.2/docbook-xsl-1.79.2.tar.gz -> docbook-xsl-1.79.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
