PACKAGE=most
VERSION=5.2.0
CATEGORY=app-text
DESCRIPTION="Paging program"
HOMEPAGE="https://www.jedsoft.org/most/"
LICENSE="GPL-2"
SRC_URI="https://www.jedsoft.org/snapshots/most-5.2.0.tar.gz -> most-5.2.0.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="sys-libs/ncurses"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
