PACKAGE=grep
VERSION=3.11
CATEGORY=sys-utils
DESCRIPTION="Text search utility"
HOMEPAGE="https://www.gnu.org/software/grep/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/grep/grep-3.11.tar.xz -> grep-3.11.tar.xz"
DEPEND="sys-libs/pcre"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
