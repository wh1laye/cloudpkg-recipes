PACKAGE=findutils
VERSION=4.10.0
CATEGORY=sys-utils
DESCRIPTION="File searching utilities"
HOMEPAGE="https://www.gnu.org/software/findutils/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.gz -> findutils-4.10.0.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
