PACKAGE=diffutils
VERSION=3.10
CATEGORY=sys-utils
DESCRIPTION="File comparison utilities"
HOMEPAGE="https://www.gnu.org/software/diffutils/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/diffutils/diffutils-3.10.tar.xz -> diffutils-3.10.tar.xz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
