PACKAGE=coreutils
VERSION=9.4
CATEGORY=sys-utils
DESCRIPTION="GNU core utilities"
HOMEPAGE="https://www.gnu.org/software/coreutils/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/coreutils/coreutils-9.4.tar.xz -> coreutils-9.4.tar.xz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
