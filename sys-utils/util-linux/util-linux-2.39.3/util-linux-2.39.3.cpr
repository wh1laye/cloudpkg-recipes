PACKAGE=util-linux
VERSION=2.39.3
CATEGORY=sys-utils
DESCRIPTION="Miscellaneous system utilities"
HOMEPAGE="https://github.com/util-linux/util-linux"
LICENSE="GPL-2"
SRC_URI="https://github.com/util-linux/util-linux/archive/refs/tags/v2.39.3.tar.gz -> util-linux-2.39.3.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-all"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
