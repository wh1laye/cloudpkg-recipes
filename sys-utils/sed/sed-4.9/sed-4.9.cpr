PACKAGE=sed
VERSION=4.9
CATEGORY=sys-utils
DESCRIPTION="Stream editor"
HOMEPAGE="https://www.gnu.org/software/sed/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/sed/sed-4.9.tar.xz -> sed-4.9.tar.xz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
