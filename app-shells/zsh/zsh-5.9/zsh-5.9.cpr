PACKAGE=zsh
VERSION=5.9
CATEGORY=app-shells
DESCRIPTION="Z Shell - powerful command interpreter"
HOMEPAGE="https://www.zsh.org/"
LICENSE="MIT"
SRC_URI="https://downloads.sourceforge.net/project/zsh/zsh/5.9/zsh-5.9.tar.xz -> zsh-5.9.tar.xz"
DEPEND="sys-libs/ncurses sys-libs/pcre"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-zshenv --enable-multibyte"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
