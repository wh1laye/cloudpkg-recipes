PACKAGE=fish
VERSION=3.7.0
CATEGORY=app-shells
DESCRIPTION="Friendly Interactive SHell"
HOMEPAGE="https://fishshell.com/"
LICENSE="GPL-2"
SRC_URI="https://github.com/fish-shell/fish-shell/releases/download/3.7.0/fish-3.7.0.tar.gz -> fish-3.7.0.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/pcre2"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--disable-gui"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
