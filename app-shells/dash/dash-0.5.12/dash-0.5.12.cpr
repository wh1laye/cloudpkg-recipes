PACKAGE=dash
VERSION=0.5.12
CATEGORY=app-shells
DESCRIPTION="Debian Almquist shell - POSIX compliant shell"
HOMEPAGE="http://gondor.apana.org.au/~herbert/dash/"
LICENSE="BSD-3"
SRC_URI="http://gondor.apana.org.au/~herbert/dash/files/dash-0.5.12.tar.gz -> dash-0.5.12.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
