PACKAGE=polkit
VERSION=124
CATEGORY=sys-auth
DESCRIPTION="PolicyKit authorization framework"
HOMEPAGE="https://www.freedesktop.org/software/polkit/docs/latest/"
LICENSE="LGPL-2"
SRC_URI="https://gitlab.freedesktop.org/polkit/polkit/-/archive/v${VERSION}/polkit-v${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="dev-libs/glib sys-auth/pambase dev-libs/expat"
RDEPEND="${DEPEND}"
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-pam-module-dir=/usr/lib/security --enable-libsystemd-login"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        ${BUILD_FLAGS}
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    insinto /usr/lib/security
    dobin pam/polkit-1.so
    echo "polkit:*:124:" >> "${D}/etc/group"
    dodoc README.md NEWS
}
pkg_postinst() {
    einfo "polkit installed"
    einfo "Add users to 'polkit' group for policy management"
}
