PACKAGE=amule
VERSION=2.3.3
CATEGORY=net-p2p
DESCRIPTION="aMule file sharing client"
HOMEPAGE="https://example.com/amule"
LICENSE="GPL-2"
SRC_URI="https://example.com/amule/amule-2.3.3.tar.gz -> amule-2.3.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
