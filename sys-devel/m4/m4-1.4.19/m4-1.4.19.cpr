PACKAGE=m4
VERSION=1.4.19
CATEGORY=sys-devel
DESCRIPTION="GNU m4 macro processor"
HOMEPAGE="https://m4.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.m4.org/m4-1.4.19.tar.gz -> m4-1.4.19.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
