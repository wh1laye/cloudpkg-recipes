PACKAGE=flex
VERSION=2.6.4
CATEGORY=sys-devel
DESCRIPTION="Fast lexical analyzer"
HOMEPAGE="https://flex.org/"
LICENSE="BSD-2"
SRC_URI="https://downloads.flex.org/flex-2.6.4.tar.gz -> flex-2.6.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
