PACKAGE=binutils
VERSION=2.41
CATEGORY=sys-devel
DESCRIPTION="GNU binary utilities"
HOMEPAGE="https://binutils.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.binutils.org/binutils-2.41.tar.gz -> binutils-2.41.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
