PACKAGE=bison
VERSION=3.8.2
CATEGORY=sys-devel
DESCRIPTION="GNU parser generator"
HOMEPAGE="https://bison.org/"
LICENSE="GPL-3"
SRC_URI="https://downloads.bison.org/bison-3.8.2.tar.gz -> bison-3.8.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
