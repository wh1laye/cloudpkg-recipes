PACKAGE=ar
VERSION=2.39
CATEGORY=sys-devel
DESCRIPTION="GNU ar"
HOMEPAGE="https://example.com/ar"
LICENSE="GPL-3"
SRC_URI="https://example.com/ar/ar-2.39.tar.gz -> ar-2.39.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
