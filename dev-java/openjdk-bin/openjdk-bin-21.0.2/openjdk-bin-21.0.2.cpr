PACKAGE=openjdk-bin
VERSION=21.0.2
CATEGORY=dev-java
DESCRIPTION="OpenJDK binary distribution"
HOMEPAGE="https://openjdk.org/"
LICENSE="GPL-2"
SRC_URI="https://download.java.net/java/GA/jdk21/877d6127e982470ba2a7faa31cc93d04/36/GPL/openjdk-21.0.2_linux-x64_bin.tar.gz -> openjdk-bin-21.0.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=21
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "openjdk-bin installed successfully"
}
