PACKAGE=ant
VERSION=1.10.14
CATEGORY=dev-java
DESCRIPTION="Java build tool"
HOMEPAGE="https://example.com/ant"
LICENSE="Apache-2.0"
SRC_URI="https://example.com/ant/ant-1.10.14.tar.gz -> ant-1.10.14.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
