PACKAGE=jenkins
VERSION=2.440
CATEGORY=dev-java
DESCRIPTION="Extensible continuous integration server"
HOMEPAGE="https://www.jenkins.io/"
LICENSE="MIT"
SRC_URI="https://get.jenkins.io/war-stable/2.440/jenkins.war -> jenkins-2.440.war"
DEPEND="dev-java/openjdk-bin"
RDEPEND="dev-java/openjdk-bin"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "jenkins installed successfully"
}
