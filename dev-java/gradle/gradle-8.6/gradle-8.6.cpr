PACKAGE=gradle
VERSION=8.6
CATEGORY=dev-java
DESCRIPTION="Build automation tool for Java"
HOMEPAGE="https://gradle.org/"
LICENSE="Apache-2.0"
SRC_URI="https://services.gradle.org/distributions/gradle-8.6-bin.zip -> gradle-8.6.zip"
DEPEND="dev-java/openjdk-bin"
RDEPEND="dev-java/openjdk-bin"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "gradle installed successfully"
}
