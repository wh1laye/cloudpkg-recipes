PACKAGE=maven
VERSION=3.9.6
CATEGORY=dev-java
DESCRIPTION="Java project management tool"
HOMEPAGE="https://maven.apache.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.apache.org/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz -> maven-3.9.6.tar.gz"
DEPEND="dev-java/openjdk-bin"
RDEPEND="dev-java/openjdk-bin"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "maven installed successfully"
}
