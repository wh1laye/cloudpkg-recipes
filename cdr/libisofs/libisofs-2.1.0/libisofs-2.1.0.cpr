PACKAGE=libisofs
VERSION=2.1.0
CATEGORY=.
DESCRIPTION="Library for creating ISO9660 filesystems"
HOMEPAGE="https://example.com/libisofs"
LICENSE=""GPL-2""
SRC_URI="https://example.com/libisofs/libisofs-2.1.0.tar.gz -> libisofs-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
