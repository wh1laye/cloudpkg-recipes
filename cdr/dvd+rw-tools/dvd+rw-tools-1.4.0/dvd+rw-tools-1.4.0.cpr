PACKAGE=dvd+rw-tools
VERSION=1.4.0
CATEGORY=.
DESCRIPTION="DVD+RW tools"
HOMEPAGE="https://example.com/dvd+rw-tools"
LICENSE=""GPL-2""
SRC_URI="https://example.com/dvd+rw-tools/dvd+rw-tools-1.4.0.tar.gz -> dvd+rw-tools-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
