PACKAGE=dvd+rw-tools
VERSION=7.1
CATEGORY=.
DESCRIPTION="DVD+RW tools"
HOMEPAGE="https://fy.chalmers.se/~appro/linux/DVD+RW/"
LICENSE="GPL-2"
SRC_URI="https://deb.debian.org/debian/pool/main/d/dvd+rw-tools/dvd+rw-tools_7.1.orig.tar.gz -> dvd+rw-tools-7.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    make -j"${JOBS:-1}" CFLAGS="-O2 -D_LARGEFILE64_SOURCE" CXXFLAGS="-O2 -D_LARGEFILE64_SOURCE"
}

src_install() {
    make prefix="${D}/usr" install
}
