PACKAGE=dvd+rw-tools
VERSION=7.1
CATEGORY=.
DESCRIPTION="DVD+RW tools"
HOMEPAGE="https://fy.chalmers.se/~appro/linux/DVD+RW/"
LICENSE="GPL-2"
SRC_URI="https://fy.chalmers.se/~appro/linux/DVD+RW/dvd+rw-tools-7.1.tar.gz -> dvd+rw-tools-7.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "dvd+rw-tools installed successfully"
}
