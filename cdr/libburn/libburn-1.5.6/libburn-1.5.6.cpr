PACKAGE=libburn
VERSION=1.5.6
CATEGORY=.
DESCRIPTION="Library for reading, mastering and writing optical discs"
HOMEPAGE="https://libburnia-project.org/"
LICENSE="GPL-2"
SRC_URI="https://files.libburnia-project.org/releases/libburn-1.5.6.tar.gz -> libburn-1.5.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "libburn installed successfully"
}
