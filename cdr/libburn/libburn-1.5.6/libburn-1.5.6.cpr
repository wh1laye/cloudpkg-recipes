PACKAGE=libburn
VERSION=1.5.6
CATEGORY=.
DESCRIPTION="Library for reading, mastering and writing optical discs"
HOMEPAGE="https://libburnia-project.org/"
LICENSE="GPL-2"
SRC_URI="https://deb.debian.org/debian/pool/main/libb/libburn/libburn_1.5.6.orig.tar.gz -> libburn-1.5.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --disable-static
}

src_compile() {
    make -j"${JOBS:-1}" libburn/libburn.la
}

src_install() {
    make DESTDIR="${D}" install-libLTLIBRARIES install-libincludeHEADERS install-nodist_pkgconfigDATA
}
