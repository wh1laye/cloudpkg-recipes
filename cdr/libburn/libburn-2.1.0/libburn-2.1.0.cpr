PACKAGE=libburn
VERSION=2.1.0
CATEGORY=.
DESCRIPTION="Library for reading, mastering and writing optical discs"
HOMEPAGE="https://example.com/libburn"
LICENSE=""GPL-2""
SRC_URI="https://example.com/libburn/libburn-2.1.0.tar.gz -> libburn-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || exit 1
}

src_install() {
    make DESTDIR="\(D\)" install || exit 1
}
