PACKAGE=cdrtools
VERSION=1.3.0
CATEGORY=.
DESCRIPTION="CD/DVD recording tools"
HOMEPAGE="https://example.com/cdrtools"
LICENSE=""CDDL-1.0""
SRC_URI="https://example.com/cdrtools/cdrtools-1.3.0.tar.gz -> cdrtools-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}

src_install() {
    make DESTDIR="${D}" install || exit 1
}
