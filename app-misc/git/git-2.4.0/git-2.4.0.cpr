PACKAGE=git
VERSION=2.4.0
CATEGORY=app-misc
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://example.com/git"
LICENSE=""GPL-2""
SRC_URI="https://example.com/git/git-2.4.0.tar.gz -> git-2.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
