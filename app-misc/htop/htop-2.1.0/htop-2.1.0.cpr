PACKAGE=htop
VERSION=2.1.0
CATEGORY=app-misc
DESCRIPTION="Interactive process viewer with a friendly interface"
HOMEPAGE="https://example.com/htop"
LICENSE=""BSD-2""
SRC_URI="https://example.com/htop/htop-2.1.0.tar.gz -> htop-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
