PACKAGE=htop
VERSION=3.3.0
CATEGORY=app-misc
DESCRIPTION="Interactive process viewer with a friendly interface"
HOMEPAGE="https://htop.dev/"
LICENSE="BSD-2"
SRC_URI="https://github.com/htop-dev/htop/archive/refs/tags/${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/libunwind"
RDEPEND="${DEPEND}"
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="-DHAVE_LIBUNWIND -DHAVE_NL_LANGINFO"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-unicode \
        --enable-libunwind \
        ${BUILD_FLAGS}
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README.md CHANGES.md
}
pkg_postinst() {
    einfo "htop installed successfully"
}
