PACKAGE=wget
VERSION=1.24.5
CATEGORY=app-misc
DESCRIPTION="Network utility to retrieve files from the WWW"
HOMEPAGE="https://www.gnu.org/software/wget/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/wget/wget-1.24.5.tar.gz -> wget-1.24.5.tar.gz"
DEPEND="sys-libs/openssl sys-libs/zlib"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-ssl=openssl"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
