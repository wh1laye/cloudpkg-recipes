PACKAGE=wget
VERSION=2.1.0
CATEGORY=app-misc
DESCRIPTION="Network utility to retrieve files from the WWW"
HOMEPAGE="https://example.com/wget"
LICENSE=""GPL-3""
SRC_URI="https://example.com/wget/wget-2.1.0.tar.gz -> wget-2.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
