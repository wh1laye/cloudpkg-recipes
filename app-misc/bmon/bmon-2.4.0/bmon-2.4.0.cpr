PACKAGE=bmon
VERSION=2.4.0
CATEGORY=app-misc
DESCRIPTION="Portable bandwidth monitor and rate estimator"
HOMEPAGE="https://example.com/bmon"
LICENSE=""MIT""
SRC_URI="https://example.com/bmon/bmon-2.4.0.tar.gz -> bmon-2.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
