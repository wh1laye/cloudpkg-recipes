PACKAGE=screen
VERSION=2.0.0
CATEGORY=app-misc
DESCRIPTION="Terminal screen multiplexer"
HOMEPAGE="https://example.com/screen"
LICENSE=""GPL-3""
SRC_URI="https://example.com/screen/screen-2.0.0.tar.gz -> screen-2.0.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
