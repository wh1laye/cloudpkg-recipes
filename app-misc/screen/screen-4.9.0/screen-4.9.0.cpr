PACKAGE=screen
VERSION=4.9.0
CATEGORY=app-misc
DESCRIPTION="Terminal screen multiplexer"
HOMEPAGE="https://www.gnu.org/software/screen/"
LICENSE="GPL-3"
SRC_URI="https://ftp.gnu.org/gnu/screen/screen-4.9.0.tar.gz -> screen-4.9.0.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
