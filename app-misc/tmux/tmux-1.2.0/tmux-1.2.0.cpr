PACKAGE=tmux
VERSION=1.2.0
CATEGORY=app-misc
DESCRIPTION="Terminal multiplexer"
HOMEPAGE="https://example.com/tmux"
LICENSE=""BSD-3""
SRC_URI="https://example.com/tmux/tmux-1.2.0.tar.gz -> tmux-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
