PACKAGE=tmux
VERSION=3.4
CATEGORY=app-misc
DESCRIPTION="Terminal multiplexer"
HOMEPAGE="https://github.com/tmux/tmux"
LICENSE="BSD-3"
SRC_URI="https://github.com/tmux/tmux/releases/download/3.4/tmux-3.4.tar.gz -> tmux-3.4.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/libevent"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
