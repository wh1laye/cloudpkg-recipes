PACKAGE=mercurial
VERSION=2.2.0
CATEGORY=app-misc
DESCRIPTION="Distributed version control system"
HOMEPAGE="https://example.com/mercurial"
LICENSE=""GPL-2""
SRC_URI="https://example.com/mercurial/mercurial-2.2.0.tar.gz -> mercurial-2.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
