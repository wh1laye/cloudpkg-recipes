PACKAGE=curl
VERSION=8.5.0
CATEGORY=app-misc
DESCRIPTION="URL retrieval utility and library"
HOMEPAGE="https://curl.se/"
LICENSE="MIT"
SRC_URI="https://curl.se/download/curl-8.5.0.tar.gz -> curl-8.5.0.tar.gz"
DEPEND="sys-libs/openssl sys-libs/zlib"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl --with-zlib"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
