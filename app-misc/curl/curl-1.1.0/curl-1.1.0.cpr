PACKAGE=curl
VERSION=1.1.0
CATEGORY=app-misc
DESCRIPTION="URL retrieval utility and library"
HOMEPAGE="https://example.com/curl"
LICENSE=""MIT""
SRC_URI="https://example.com/curl/curl-1.1.0.tar.gz -> curl-1.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
