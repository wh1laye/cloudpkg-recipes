PACKAGE=iptables
VERSION=1.8.10
CATEGORY=net-firewall
DESCRIPTION="IP tables administration tool"
HOMEPAGE="https://www.netfilter.org/projects/iptables/"
LICENSE="GPL-2"
SRC_URI="https://www.netfilter.org/projects/iptables/files/iptables-1.8.10.tar.xz -> iptables-1.8.10.tar.xz"
DEPEND="dev-libs/libnfnetlink dev-libs/libnftnl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
