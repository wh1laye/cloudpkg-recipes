PACKAGE=postfix
VERSION=1.2.0
CATEGORY=mail-mta
DESCRIPTION="Postfix mail transfer agent"
HOMEPAGE="https://example.com/postfix"
LICENSE=""IBM""
SRC_URI="https://example.com/postfix/postfix-1.2.0.tar.gz -> postfix-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
