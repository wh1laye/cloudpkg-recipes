PACKAGE=postfix
VERSION=3.8.4
CATEGORY=mail-mta
DESCRIPTION="Postfix mail transfer agent"
HOMEPAGE="http://www.postfix.org/"
LICENSE="IBM"
SRC_URI="http://cdn.postfix.johnriley.me/mirrors/postfix-release/official/postfix-3.8.4.tar.gz -> postfix-3.8.4.tar.gz"
DEPEND="dev-db/sqlite dev-libs/openssl"
RDEPEND="dev-db/sqlite dev-libs/openssl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "postfix installed successfully"
}
