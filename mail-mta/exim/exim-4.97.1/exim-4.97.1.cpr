PACKAGE=exim
VERSION=4.97.1
CATEGORY=mail-mta
DESCRIPTION="Exim mail transfer agent"
HOMEPAGE="https://www.exim.org/"
LICENSE="GPL-2"
SRC_URI="https://ftp.exim.org/pub/exim/exim4/exim-4.97.1.tar.gz -> exim-4.97.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "exim installed successfully"
}
