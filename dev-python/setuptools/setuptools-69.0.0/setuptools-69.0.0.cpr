PACKAGE=setuptools
VERSION=69.0.0
CATEGORY=dev-python
DESCRIPTION="Python package build and distribution tool"
HOMEPAGE="https://pypi.org/project/setuptools/"
LICENSE="MIT"
SRC_URI="https://github.com/pypa/setuptools/archive/refs/tags/v${VERSION}.tar.gz -> ${P}-${VERSION}.tar.gz"
DEPEND="dev-lang/python"
RDEPEND="${DEPEND}"
SLOT=0
KEYWORDS="amd64"
src_compile() {
    python3 setup.py build || die "Build failed"
}
src_install() {
    python3 setup.py install --root="${D}" --prefix=/usr || die "Install failed"
    dodoc README.md CHANGELOG.rst
}
pkg_postinst() {
    einfo "setuptools installed"
}
