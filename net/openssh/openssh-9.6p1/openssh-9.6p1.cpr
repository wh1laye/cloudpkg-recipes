PACKAGE=openssh
VERSION=9.6p1
CATEGORY=.
DESCRIPTION="OpenSSH - secure shell client and server"
HOMEPAGE="https://www.openssh.com/"
LICENSE="BSD-2"
SRC_URI="https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.6p1.tar.gz -> openssh-9.6p1.tar.gz"
DEPEND="libs/zlib libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc/ssh --with-privsep-path=/run/sshd
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}