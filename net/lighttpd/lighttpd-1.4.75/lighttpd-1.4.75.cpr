PACKAGE=lighttpd
VERSION=1.4.75
CATEGORY=.
DESCRIPTION="Lightweight web server"
HOMEPAGE="https://www.lighttpd.net/"
LICENSE="BSD-3"
SRC_URI="https://download.lighttpd.net/lighttpd/releases-1.4.x/lighttpd-1.4.75.tar.gz -> lighttpd-1.4.75.tar.gz"
DEPEND="libs/zlib libs/pcre2 libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc/lighttpd --with-openssl --with-zlib --with-pcre
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}