PACKAGE=iputils
VERSION=20240117
CATEGORY=.
DESCRIPTION="IP utilities (ping, arping, etc.)"
HOMEPAGE="https://github.com/iputils/iputils"
LICENSE="BSD-3"
SRC_URI="https://github.com/iputils/iputils/releases/download/20240117/iputils-20240117.tar.gz -> iputils-20240117.tar.gz"
DEPEND="libs/cap-ng"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --disable-rpath
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}