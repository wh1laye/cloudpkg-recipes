PACKAGE=iproute2
VERSION=6.7.0
CATEGORY=.
DESCRIPTION="IP routing utilities"
HOMEPAGE="https://www.kernel.org/pub/linux/utils/net/iproute2/"
LICENSE="GPL-2"
SRC_URI="https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-6.7.0.tar.gz -> iproute2-6.7.0.tar.gz"
DEPEND="libs/glibc"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    true
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" PREFIX=/usr install || exit 1
}