PACKAGE=netcat
VERSION=0.7.1
CATEGORY=.
DESCRIPTION="TCP/IP swiss army knife"
HOMEPAGE="https://netcat.sourceforge.net/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/netcat/netcat/0.7.1/netcat-0.7.1.tar.gz -> netcat-0.7.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
