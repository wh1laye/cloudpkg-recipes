PACKAGE=rsync
VERSION=3.2.7
CATEGORY=.
DESCRIPTION="Fast file transfer utility"
HOMEPAGE="https"
LICENSE="//rsync.samba.org/"
SRC_URI="GPL-3 -> rsync-3.2.7.tar.gz"
DEPEND="https://rsync.samba.org/ftp/rsync/rsync-3.2.7.tar.gz:libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
