PACKAGE=traceroute
VERSION=2.1.2
CATEGORY=.
DESCRIPTION="Network path tracing"
HOMEPAGE="https"
LICENSE="//traceroute.sourceforge.net/"
SRC_URI="GPL-2 -> traceroute-2.1.2.tar.gz"
DEPEND="https://sourceforge.net/projects/traceroute/files/traceroute-2.1.2.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
