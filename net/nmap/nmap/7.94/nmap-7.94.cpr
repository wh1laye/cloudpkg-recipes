PACKAGE=nmap
VERSION=7.94
CATEGORY=.
DESCRIPTION="Network security scanner"
HOMEPAGE="https://nmap.org/"
LICENSE="GPL-2"
SRC_URI="https://nmap.org/dist/nmap-7.94.tar.bz2 -> nmap-7.94.tar.bz2"
DEPEND="dev-libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
