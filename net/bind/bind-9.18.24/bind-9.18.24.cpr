PACKAGE=bind
VERSION=9.18.24
CATEGORY=.
DESCRIPTION="BIND DNS server"
HOMEPAGE="https://www.isc.org/bind/"
LICENSE="MPL-2.0"
SRC_URI="https://downloads.isc.org/isc/bind9/9.18.24/bind-9.18.24.tar.gz -> bind-9.18.24.tar.gz"
DEPEND="libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc/bind --enable-threads
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}