PACKAGE=wireless-tools
VERSION=30.pre9
CATEGORY=.
DESCRIPTION="Wireless network utilities"
HOMEPAGE="https"
LICENSE="//www.hpl.hp.com/personal/Jean_Tourrilhes/Linux/Tools.html"
SRC_URI="GPL-2 -> wireless-tools-30.pre9.tar.gz"
DEPEND="https://hewlettpackard.com/ddn/Downloads/Software/Networking/wireless-tools-30.pre9.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
