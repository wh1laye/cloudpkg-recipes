PACKAGE=libpcap
VERSION=1.10.4
CATEGORY=.
DESCRIPTION="Packet capture library"
HOMEPAGE="https"
LICENSE="//www.tcpdump.org/"
SRC_URI="BSD-3 -> libpcap-1.10.4.tar.gz"
DEPEND="https://www.tcpdump.org/release/libpcap-1.10.4.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
