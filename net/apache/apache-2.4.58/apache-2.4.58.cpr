PACKAGE=apache
VERSION=2.4.58
CATEGORY=.
DESCRIPTION="Apache HTTP Server"
HOMEPAGE="https"
LICENSE="//httpd.apache.org/"
SRC_URI="Apache-2.0 -> apache-2.4.58.tar.gz"
DEPEND="https://downloads.apache.org/httpd/httpd-2.4.58.tar.gz:libs/apr libs/apr-util"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
