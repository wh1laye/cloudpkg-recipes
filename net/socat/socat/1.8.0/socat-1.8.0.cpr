PACKAGE=socat
VERSION=1.8.0
CATEGORY=.
DESCRIPTION="Multipurpose relay for bidirectional data transfer"
HOMEPAGE="http://www.dest-unreach.org/socat/"
LICENSE="GPL-2"
SRC_URI="http://www.dest-unreach.org/socat/download/socat-1.8.0.tar.gz -> socat-1.8.0.tar.gz"
DEPEND="dev-libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
