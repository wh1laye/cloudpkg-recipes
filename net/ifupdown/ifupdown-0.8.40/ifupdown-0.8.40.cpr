PACKAGE=ifupdown
VERSION=0.8.40
CATEGORY=.
DESCRIPTION="Network interface configuration"
HOMEPAGE="https"
LICENSE="//packages.debian.org/sid/ifupdown"
SRC_URI="BSD-3 -> ifupdown-0.8.40.tar.gz"
DEPEND="https://deb.debian.org/debian/pool/main/i/ifupdown/ifupdown_0.8.40.tar.gz:"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
