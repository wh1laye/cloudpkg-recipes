PACKAGE=qemu
VERSION=8.1.5
CATEGORY=.
DESCRIPTION="Machine emulator and virtualizer"
HOMEPAGE="https://www.qemu.org/"
LICENSE="GPL-2"
SRC_URI="https://download.qemu.org/qemu-8.1.5.tar.xz -> qemu-8.1.5.tar.xz"
DEPEND="dev-libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
