PACKAGE=i3
VERSION=4.23
CATEGORY=x11-wm
DESCRIPTION="Improved tiling window manager"
HOMEPAGE="https://i3wm.org/"
LICENSE="BSD-3"
SRC_URI="https://github.com/i3/i3/archive/refs/tags/4.23.tar.gz -> i3-4.23.tar.gz"
DEPEND="x11-base/xcb-util"
RDEPEND="x11-base/xcb-util"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "i3 installed successfully"
}
