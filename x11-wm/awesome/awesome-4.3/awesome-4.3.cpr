PACKAGE=awesome
VERSION=4.3
CATEGORY=x11-wm
DESCRIPTION="Highly configurable window manager"
HOMEPAGE="https://awesomewm.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/awesomeWM/awesome/archive/refs/tags/v4.3.tar.gz -> awesome-4.3.tar.gz"
DEPEND="x11-base/xcb-util"
RDEPEND="x11-base/xcb-util"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "awesome installed successfully"
}
