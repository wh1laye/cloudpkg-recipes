PACKAGE=openbox
VERSION=1.4.0
CATEGORY=x11-wm
DESCRIPTION="Highly configurable window manager"
HOMEPAGE="https://example.com/openbox"
LICENSE=""GPL-2""
SRC_URI="https://example.com/openbox/openbox-1.4.0.tar.gz -> openbox-1.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
