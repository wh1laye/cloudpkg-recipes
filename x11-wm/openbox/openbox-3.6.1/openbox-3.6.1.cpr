PACKAGE=openbox
VERSION=3.6.1
CATEGORY=x11-wm
DESCRIPTION="Highly configurable window manager"
HOMEPAGE="https://openbox.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/openbox/openbox/3.6.1/openbox-3.6.1.tar.gz -> openbox-3.6.1.tar.gz"
DEPEND="x11-base/xcb-util"
RDEPEND="x11-base/xcb-util"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "openbox installed successfully"
}
