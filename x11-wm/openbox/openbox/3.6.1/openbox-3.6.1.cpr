PACKAGE=openbox
VERSION=3.6.1
CATEGORY=.
DESCRIPTION="Lightweight X11 window manager"
HOMEPAGE="http://openbox.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/danyspin97/openbox/archive/refs/tags/3.6.1.tar.gz -> openbox-3.6.1.tar.gz"
DEPEND="x11-libs/libX11"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
