PACKAGE=fluxbox
VERSION=1.3.7
CATEGORY=x11-wm
DESCRIPTION="Lightweight tabbing window manager"
HOMEPAGE="https://fluxbox.org/"
LICENSE="MIT"
SRC_URI="https://downloads.sourceforge.net/project/fluxbox/fluxbox/1.3.7/fluxbox-1.3.7.tar.gz -> fluxbox-1.3.7.tar.gz"
DEPEND="x11-base/xcb-util"
RDEPEND="x11-base/xcb-util"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "fluxbox installed successfully"
}
