PACKAGE=fluxbox
VERSION=1.2.0
CATEGORY=x11-wm
DESCRIPTION="Lightweight tabbing window manager"
HOMEPAGE="https://example.com/fluxbox"
LICENSE=""MIT""
SRC_URI="https://example.com/fluxbox/fluxbox-1.2.0.tar.gz -> fluxbox-1.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
