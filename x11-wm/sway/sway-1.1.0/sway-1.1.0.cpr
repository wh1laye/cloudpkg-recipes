PACKAGE=sway
VERSION=1.1.0
CATEGORY=x11-wm
DESCRIPTION="i3-compatible Wayland compositor"
HOMEPAGE="https://example.com/sway"
LICENSE=""MIT""
SRC_URI="https://example.com/sway/sway-1.1.0.tar.gz -> sway-1.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
