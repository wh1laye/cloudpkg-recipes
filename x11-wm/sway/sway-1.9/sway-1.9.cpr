PACKAGE=sway
VERSION=1.9
CATEGORY=x11-wm
DESCRIPTION="i3-compatible Wayland compositor"
HOMEPAGE="https://swaywm.org/"
LICENSE="MIT"
SRC_URI="https://github.com/swaywm/sway/archive/refs/tags/1.9.tar.gz -> sway-1.9.tar.gz"
DEPEND="x11-base/xcb-util"
RDEPEND="x11-base/xcb-util"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "sway installed successfully"
}
