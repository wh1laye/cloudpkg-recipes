PACKAGE=freetype
VERSION=2.13.2
CATEGORY=media-fonts
DESCRIPTION="FreeType font rendering library"
HOMEPAGE="https://www.freetype.org/"
LICENSE="FTL"
SRC_URI="https://download.savannah.gnu.org/releases/freetype/freetype-2.13.2.tar.gz -> freetype-2.13.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=2
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "freetype installed successfully"
}
