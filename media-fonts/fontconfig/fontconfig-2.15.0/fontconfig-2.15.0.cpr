PACKAGE=fontconfig
VERSION=2.15.0
CATEGORY=media-fonts
DESCRIPTION="Font configuration and customization library"
HOMEPAGE="https://www.freedesktop.org/software/fontconfig/"
LICENSE="MIT"
SRC_URI="https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.15.0.tar.gz -> fontconfig-2.15.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "fontconfig installed successfully"
}
