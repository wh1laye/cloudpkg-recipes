PACKAGE=dejavu
VERSION=2.37
CATEGORY=media-fonts
DESCRIPTION="DejaVu fonts"
HOMEPAGE="https://dejavu-fonts.github.io/"
LICENSE="Public-Domain"
SRC_URI="https://downloads.sourceforge.net/project/dejavu/dejavu/2.37/dejavu-fonts-ttf-2.37.tar.gz -> dejavu-2.37.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "dejavu installed successfully"
}
