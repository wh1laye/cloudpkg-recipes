PACKAGE=systemd
VERSION=255
CATEGORY=sys-process
DESCRIPTION="System and service manager"
HOMEPAGE="https://systemd.io/"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/systemd/systemd/archive/refs/tags/v255.tar.gz -> systemd-255.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "systemd installed successfully"
}
