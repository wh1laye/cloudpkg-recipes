PACKAGE=psmisc
VERSION=23.6
CATEGORY=sys-process
DESCRIPTION="Process utilities (pstree, killall, etc.)"
HOMEPAGE="https://gitlab.com/psmisc/psmisc"
LICENSE="GPL-2"
SRC_URI="https://gitlab.com/psmisc/psmisc/-/archive/v23.6/psmisc-v23.6.tar.gz -> psmisc-23.6.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
