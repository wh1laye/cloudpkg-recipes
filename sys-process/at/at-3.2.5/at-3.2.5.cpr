PACKAGE=at
VERSION=3.2.5
CATEGORY=sys-process
DESCRIPTION="Job scheduling utility"
HOMEPAGE="https://example.com/at"
LICENSE="GPL-3"
SRC_URI="https://example.com/at/at-3.2.5.tar.gz -> at-3.2.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
