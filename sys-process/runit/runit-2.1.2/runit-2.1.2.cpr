PACKAGE=runit
VERSION=2.1.2
CATEGORY=sys-process
DESCRIPTION="UNIX service supervision"
HOMEPAGE="http://smarden.org/runit/"
LICENSE="BSD-3"
SRC_URI="http://smarden.org/runit/runit-2.1.2.tar.gz -> runit-2.1.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "runit installed successfully"
}
