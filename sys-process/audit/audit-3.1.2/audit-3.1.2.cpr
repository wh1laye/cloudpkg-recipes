PACKAGE=audit
VERSION=3.1.2
CATEGORY=sys-process
DESCRIPTION="Linux audit framework"
HOMEPAGE="https://example.com/audit"
LICENSE="GPL-2"
SRC_URI="https://example.com/audit/audit-3.1.2.tar.gz -> audit-3.1.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
