PACKAGE=godot
VERSION=0.15.0
CATEGORY=sys-process
DESCRIPTION="Process manager for containerized applications"
HOMEPAGE="https://github.com/looplab/godot"
LICENSE="MIT"
SRC_URI="https://github.com/looplab/godot/archive/refs/tags/v0.15.0.tar.gz -> godot-0.15.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "godot installed successfully"
}
