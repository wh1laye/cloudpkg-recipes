PACKAGE=supervisord
VERSION=4.2.5
CATEGORY=sys-process
DESCRIPTION="Process control system"
HOMEPAGE="http://supervisord.org/"
LICENSE="BSD-3"
SRC_URI="https://github.com/Supervisor/supervisor/archive/refs/tags/4.2.5.tar.gz -> supervisord-4.2.5.tar.gz"
DEPEND="dev-lang/python"
RDEPEND="dev-lang/python"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "supervisord installed successfully"
}
