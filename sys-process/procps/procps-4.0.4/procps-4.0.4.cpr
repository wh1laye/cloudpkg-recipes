PACKAGE=procps
VERSION=4.0.4
CATEGORY=sys-process
DESCRIPTION="Process utilities (ps, top, etc.)"
HOMEPAGE="https://gitlab.com/procps-ng/procps"
LICENSE="GPL-2"
SRC_URI="https://gitlab.com/procps-ng/procps/-/archive/v4.0.4/procps-v4.0.4.tar.gz -> procps-4.0.4.tar.gz"
DEPEND="sys-libs/ncurses"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
