PACKAGE=monit
VERSION=5.34.0
CATEGORY=sys-process
DESCRIPTION="Process monitoring and management"
HOMEPAGE="https://mmonit.com/monit/"
LICENSE="AGPL-3"
SRC_URI="https://mmonit.com/monit/dist/monit-5.34.0.tar.gz -> monit-5.34.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "monit installed successfully"
}
