PACKAGE=cmake
VERSION=3.28.0
CATEGORY=dev-build
DESCRIPTION="Cross-platform make system"
HOMEPAGE="https://cmake.org/"
LICENSE="BSD-3"
SRC_URI="https://github.com/Kitware/CMake/releases/download/v3.28.0/cmake-3.28.0.tar.gz -> cmake-3.28.0.tar.gz"
DEPEND="dev-lang/python dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--parallel=6"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
