PACKAGE=ninja
VERSION=1.11.1
CATEGORY=dev-build
DESCRIPTION="Small build system with a focus on speed"
HOMEPAGE="https://ninja-build.org/"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/ninja-build/ninja/archive/refs/tags/v1.11.1.tar.gz -> ninja-1.11.1.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
