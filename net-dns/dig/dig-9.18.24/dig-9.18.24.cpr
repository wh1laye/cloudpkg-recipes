PACKAGE=dig
VERSION=9.18.24
CATEGORY=net-dns
DESCRIPTION="DNS lookup utility (part of BIND)"
HOMEPAGE="https://www.isc.org/bind/"
LICENSE="MPL-2.0"
SRC_URI="https://downloads.isc.org/isc/bind9/9.18.24/bind-9.18.24.tar.xz -> bind-9.18.24.tar.xz"
DEPEND="dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--disable-server --enable-dig"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
