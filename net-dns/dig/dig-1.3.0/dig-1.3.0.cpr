PACKAGE=dig
VERSION=1.3.0
CATEGORY=net-dns
DESCRIPTION="DNS lookup utility (part of BIND)"
HOMEPAGE="https://example.com/dig"
LICENSE=""MPL-2.0""
SRC_URI="https://example.com/dig/dig-1.3.0.tar.gz -> dig-1.3.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
