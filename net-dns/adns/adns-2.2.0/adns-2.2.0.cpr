PACKAGE=adns
VERSION=2.2.0
CATEGORY=net-dns
DESCRIPTION="Asynchronous DNS client library"
HOMEPAGE="https://example.com/adns"
LICENSE=""GPL-2""
SRC_URI="https://example.com/adns/adns-2.2.0.tar.gz -> adns-2.2.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
