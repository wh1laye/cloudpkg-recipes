PACKAGE=dnsmasq
VERSION=1.5.0
CATEGORY=net-dns
DESCRIPTION="Lightweight DNS forwarder and DHCP server"
HOMEPAGE="https://example.com/dnsmasq"
LICENSE=""GPL-2""
SRC_URI="https://example.com/dnsmasq/dnsmasq-1.5.0.tar.gz -> dnsmasq-1.5.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
