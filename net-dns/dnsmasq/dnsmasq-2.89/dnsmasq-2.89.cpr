PACKAGE=dnsmasq
VERSION=2.89
CATEGORY=net-dns
DESCRIPTION="Lightweight DNS forwarder and DHCP server"
HOMEPAGE="http://www.thekelleys.org.uk/dnsmasq/doc.html"
LICENSE="GPL-2"
SRC_URI="http://www.thekelleys.org.uk/dnsmasq/dnsmasq-2.89.tar.gz -> dnsmasq-2.89.tar.gz"
DEPEND=""
RDEPEND="
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
