PACKAGE=ldns
VERSION=1.8.3
CATEGORY=.
DESCRIPTION="DNS library"
HOMEPAGE="https://www.nlnetlabs.nl/projects/ldns/"
LICENSE="BSD"
SRC_URI="https://www.nlnetlabs.nl/downloads/ldns/ldns-1.8.3.tar.gz -> ldns-1.8.3.tar.gz"
DEPEND="dev-libs/openssl"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
