PACKAGE=stellarium
VERSION=1.2
CATEGORY=.
DESCRIPTION="Planetarium software"
HOMEPAGE="https://stellarium.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/Stellarium/stellarium/archive/refs/tags/v1.2.tar.gz -> stellarium-1.2.tar.gz"
DEPEND="dev-libs/qt5"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
