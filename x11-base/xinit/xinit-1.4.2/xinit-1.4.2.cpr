PACKAGE=xinit
VERSION=1.4.2
CATEGORY=x11-base
DESCRIPTION="X Window System initializer"
HOMEPAGE="https://www.x.org/"
LICENSE="MIT"
SRC_URI="https://xorg.freedesktop.org/archive/individual/app/xinit-1.4.2.tar.gz -> xinit-1.4.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "xinit installed successfully"
}
