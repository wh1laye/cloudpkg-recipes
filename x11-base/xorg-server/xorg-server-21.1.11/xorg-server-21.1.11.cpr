PACKAGE=xorg-server
VERSION=21.1.11
CATEGORY=x11-base
DESCRIPTION="X.Org X server"
HOMEPAGE="https://www.x.org/"
LICENSE="MIT"
SRC_URI="https://xorg.freedesktop.org/archive/individual/xserver/xorg-server-21.1.11.tar.gz -> xorg-server-21.1.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "xorg-server installed successfully"
}
