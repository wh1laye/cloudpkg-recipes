PACKAGE=xrdb
VERSION=1.2.2
CATEGORY=x11-base
DESCRIPTION="X server resource database utility"
HOMEPAGE="https://www.x.org/"
LICENSE="MIT"
SRC_URI="https://xorg.freedesktop.org/archive/individual/app/xrdb-1.2.2.tar.gz -> xrdb-1.2.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "xrdb installed successfully"
}
