PACKAGE=gtk3
VERSION=3.24.41
CATEGORY=.
DESCRIPTION="GTK+ 3 library"
HOMEPAGE="https://www.gtk.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://download.gnome.org/sources/gtk+/3.24/gtk+-3.24.41.tar.gz -> gtk3-3.24.41.tar.gz"
DEPEND="app-text/pango app-text/cairo app-text/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
