PACKAGE=assimp
VERSION=5.4.0
CATEGORY=media-libs
DESCRIPTION="Open Asset Import Library"
HOMEPAGE="https://example.com/assimp"
LICENSE="BSD-3"
SRC_URI="https://example.com/assimp/assimp-5.4.0.tar.gz -> assimp-5.4.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
