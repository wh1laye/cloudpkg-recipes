PACKAGE=libjpeg-turbo
VERSION=3.0.1
CATEGORY=media-libs
DESCRIPTION="JPEG image codec library"
HOMEPAGE="https://libjpeg-turbo.org/"
LICENSE="IJG"
SRC_URI="https://github.com/libjpeg-turbo/libjpeg-turbo/archive/refs/tags/3.0.1.tar.gz -> libjpeg-turbo-3.0.1.tar.gz"
DEPEND="sys-libs/nasm"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-jpeg8"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
