PACKAGE=libjpeg-turbo
VERSION=3.0.2
CATEGORY=.
DESCRIPTION="JPEG library (turbo)"
HOMEPAGE="https://libjpeg-turbo.org/"
LICENSE="BSD-3"
SRC_URI="https://github.com/libjpeg-turbo/libjpeg-turbo/archive/refs/tags/3.0.2.tar.gz -> libjpeg-turbo-3.0.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
