PACKAGE=gtk2
VERSION=2.24.33
CATEGORY=.
DESCRIPTION="GTK+ 2 library"
HOMEPAGE="https://www.gtk.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://download.gnome.org/sources/gtk+/2.24/gtk+-2.24.33.tar.gz -> gtk2-2.24.33.tar.gz"
DEPEND="app-text/pango app-text/cairo app-text/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
