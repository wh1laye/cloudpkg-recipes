PACKAGE=libexif
VERSION=0.6.24
CATEGORY=.
DESCRIPTION="EXIF library"
HOMEPAGE="https://libexif.github.io/"
LICENSE="LGPL-2.1"
SRC_URI="https://github.com/libexif/libexif/releases/download/libexif-0_6_24-release/libexif-0.6.24.tar.gz -> libexif-0.6.24.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
