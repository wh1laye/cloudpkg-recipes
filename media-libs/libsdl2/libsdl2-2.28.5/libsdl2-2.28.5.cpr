PACKAGE=libsdl2
VERSION=2.28.5
CATEGORY=.
DESCRIPTION="Simple DirectMedia Layer"
HOMEPAGE="https://www.libsdl.org/"
LICENSE="ZLIB"
SRC_URI="https://www.libsdl.org/release/SDL2-2.28.5.tar.gz -> libsdl2-2.28.5.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
