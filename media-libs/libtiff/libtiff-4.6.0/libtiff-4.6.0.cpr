PACKAGE=libtiff
VERSION=4.6.0
CATEGORY=.
DESCRIPTION="TIFF library"
HOMEPAGE="https://libtiff.gitlab.io/libtiff/"
LICENSE="BSD-3"
SRC_URI="https://download.osgeo.org/libtiff/tiff-4.6.0.tar.gz -> libtiff-4.6.0.tar.gz"
DEPEND="libs/jpeg libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
