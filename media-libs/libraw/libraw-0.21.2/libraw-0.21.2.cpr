PACKAGE=libraw
VERSION=0.21.2
CATEGORY=.
DESCRIPTION="Raw image decoder"
HOMEPAGE="https://www.libraw.org/"
LICENSE="LGPL-2.1"
SRC_URI="https://www.libraw.org/data/LibRaw-0.21.2.tar.gz -> libraw-0.21.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
