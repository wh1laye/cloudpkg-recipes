PACKAGE=libpng
VERSION=1.6.40
CATEGORY=media-libs
DESCRIPTION="PNG reference library"
HOMEPAGE="http://www.libpng.org/"
LICENSE="zlib"
SRC_URI="https://downloads.sourceforge.net/project/libpng/libpng16/1.6.40/libpng-1.6.40.tar.gz -> libpng-1.6.40.tar.gz"
DEPEND="sys-libs/zlib"
RDEPEND="
SLOT=16
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
