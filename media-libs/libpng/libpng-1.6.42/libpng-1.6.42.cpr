PACKAGE=libpng
VERSION=1.6.42
CATEGORY=.
DESCRIPTION="PNG library"
HOMEPAGE="http://www.libpng.org/"
LICENSE="ZLIB"
SRC_URI="https://download.sourceforge.net/libpng/libpng-1.6.42.tar.gz -> libpng-1.6.42.tar.gz"
DEPEND="libs/zlib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
