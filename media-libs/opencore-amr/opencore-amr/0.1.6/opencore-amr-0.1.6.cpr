PACKAGE=opencore-amr
VERSION=0.1.6
CATEGORY=.
DESCRIPTION="AMR audio codec library"
HOMEPAGE="https://sourceforge.net/projects/opencore-amr/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.sourceforge.net/project/opencore-amr/opencore-amr/opencore-amr-0.1.6.tar.gz -> opencore-amr-0.1.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
