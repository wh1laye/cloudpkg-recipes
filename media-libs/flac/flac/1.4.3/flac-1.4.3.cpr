PACKAGE=flac
VERSION=1.4.3
CATEGORY=.
DESCRIPTION="Free Lossless Audio Codec"
HOMEPAGE="https://xiph.org/flac/"
LICENSE="BSD"
SRC_URI="https://downloads.xiph.org/releases/flac/flac-1.4.3.tar.gz -> flac-1.4.3.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
