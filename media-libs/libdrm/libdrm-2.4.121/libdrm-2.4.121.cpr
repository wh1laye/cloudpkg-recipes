PACKAGE=libdrm
VERSION=2.4.121
CATEGORY=.
DESCRIPTION="Direct Rendering Manager"
HOMEPAGE="https://dri.freedesktop.org/"
LICENSE="MIT"
SRC_URI="https://dri.freedesktop.org/libdrm/libdrm-2.4.121.tar.gz -> libdrm-2.4.121.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
