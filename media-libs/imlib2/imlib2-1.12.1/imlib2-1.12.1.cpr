PACKAGE=imlib2
VERSION=1.12.1
CATEGORY=.
DESCRIPTION="Image loading library"
HOMEPAGE="https://sourceforge.net/projects/enlightenment/"
LICENSE="LGPL-2.1"
SRC_URI="https://sourceforge.net/projects/enlightenment/files/imlib2-src/1.12.1/imlib2-1.12.1.tar.gz -> imlib2-1.12.1.tar.gz"
DEPEND="media-libs/libpng media-libs/libjpeg-turbo"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
