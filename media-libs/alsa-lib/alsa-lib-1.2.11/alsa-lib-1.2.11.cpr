PACKAGE=alsa-lib
VERSION=1.2.11
CATEGORY=media-libs
DESCRIPTION="Advanced Linux Sound Architecture"
HOMEPAGE="https://example.com/alsa-lib"
LICENSE="LGPL-2.1"
SRC_URI="https://example.com/alsa-lib/alsa-lib-1.2.11.tar.gz -> alsa-lib-1.2.11.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
