PACKAGE=libtheora
VERSION=1.1.1
CATEGORY=.
DESCRIPTION="Theora video codec"
HOMEPAGE="https://theora.org/"
LICENSE="BSD-3"
SRC_URI="https://downloads.xiph.org/releases/theora/libtheora-1.1.1.tar.gz -> libtheora-1.1.1.tar.gz"
DEPEND="libs/ogg"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
