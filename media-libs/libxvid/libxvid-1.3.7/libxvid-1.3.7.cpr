PACKAGE=libxvid
VERSION=1.3.7
CATEGORY=.
DESCRIPTION="XviD video codec"
HOMEPAGE="https://labs.xvid.com/"
LICENSE="GPL-2"
SRC_URI="https://downloads.xvid.org/downloads/xvidcore-1.3.7.tar.gz -> libxvid-1.3.7.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
