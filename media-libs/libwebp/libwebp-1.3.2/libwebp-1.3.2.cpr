PACKAGE=libwebp
VERSION=1.3.2
CATEGORY=.
DESCRIPTION="WebP library"
HOMEPAGE="https://developers.google.com/speed/webp/"
LICENSE="BSD-3"
SRC_URI="https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.3.2.tar.gz -> libwebp-1.3.2.tar.gz"
DEPEND="libs/jpeg libs/png"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
