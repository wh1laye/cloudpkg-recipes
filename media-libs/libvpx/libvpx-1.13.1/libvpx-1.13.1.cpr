PACKAGE=libvpx
VERSION=1.13.1
CATEGORY=.
DESCRIPTION="VP8/VP9 video codec"
HOMEPAGE="https://www.webmproject.org/code/"
LICENSE="BSD-3"
SRC_URI="https://github.com/webmproject/libvpx/archive/refs/tags/v1.13.1.tar.gz -> libvpx-1.13.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
