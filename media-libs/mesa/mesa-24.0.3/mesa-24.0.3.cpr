PACKAGE=mesa
VERSION=24.0.3
CATEGORY=.
DESCRIPTION="OpenGL implementation"
HOMEPAGE="https://www.mesa3d.org/"
LICENSE="MIT"
SRC_URI="https://mesa.freedesktop.org/archive/mesa-24.0.3.tar.gz -> mesa-24.0.3.tar.gz"
DEPEND="libs/expat libs/glib"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
