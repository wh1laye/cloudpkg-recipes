PACKAGE=libsdl2-image
VERSION=2.8.2
CATEGORY=.
DESCRIPTION="SDL2 image library"
HOMEPAGE="https://www.libsdl.org/projects/SDL_image/"
LICENSE="ZLIB"
SRC_URI="https://www.libsdl.org/projects/SDL_image/release/SDL2_image-2.8.2.tar.gz -> libsdl2-image-2.8.2.tar.gz"
DEPEND="media-libs/libsdl2 libs/jpeg libs/png"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
