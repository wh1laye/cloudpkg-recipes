PACKAGE=squid
VERSION=6.7
CATEGORY=net-proxy
DESCRIPTION="Caching proxy server"
HOMEPAGE="http://www.squid-cache.org/"
LICENSE="GPL-2"
SRC_URI="http://www.squid-cache.org/Versions/v6/squid-6.7.tar.gz -> squid-6.7.tar.gz"
DEPEND="dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
