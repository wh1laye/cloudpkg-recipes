PACKAGE=sysbench
VERSION=1.1.0
CATEGORY=.
DESCRIPTION="System performance benchmark tool"
HOMEPAGE="https://github.com/akopytov/sysbench"
LICENSE="GPL-2"
SRC_URI="https://github.com/akopytov/sysbench/archive/refs/tags/1.1.0.tar.gz -> sysbench-1.1.0.tar.gz"
DEPEND="dev-libs/openssl sys-libs/mysql"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-mysql"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
