PACKAGE=openjdk-bin
VERSION=21.0.2
CATEGORY=.
DESCRIPTION="OpenJDK binary distribution"
HOMEPAGE="https://openjdk.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.2%2B13/OpenJDK21U-jdk_x64_linux_hotspot_21.0.2_13.tar.gz -> openjdk-bin-21.0.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    true
}

src_install() {
    install -d "${D}/usr/lib/jvm" "${D}/usr/bin"
        cp -a . "${D}/usr/lib/jvm/openjdk-21.0.2"
        for b in java javac jar javadoc jcmd jconsole jdb jps jshell keytool; do
            [ -x "${D}/usr/lib/jvm/openjdk-21.0.2/bin/$b" ] && ln -s /usr/lib/jvm/openjdk-21.0.2/bin/$b "${D}/usr/bin/$b"
        done
}
