PACKAGE=gradle
VERSION=8.6
CATEGORY=.
DESCRIPTION="Build automation tool for Java"
HOMEPAGE="https://gradle.org/"
LICENSE="Apache-2.0"
SRC_URI="https://services.gradle.org/distributions/gradle-8.6-bin.zip -> gradle-8.6.zip"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    true
}
src_compile() {
    true
}
src_install() {
    install -d "${D}/opt" "${D}/usr/bin" && cp -a . "${D}/opt/gradle-8.6" && ln -s /opt/gradle-8.6/bin/gradle "${D}/usr/bin/gradle"
}
