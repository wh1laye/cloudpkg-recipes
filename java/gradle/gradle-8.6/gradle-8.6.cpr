PACKAGE=gradle
VERSION=8.6
CATEGORY=.
DESCRIPTION="Build automation tool for Java"
HOMEPAGE="https://gradle.org/"
LICENSE="Apache-2.0"
SRC_URI="https://services.gradle.org/distributions/gradle-8.6-bin.zip -> gradle-8.6.zip"
DEPEND="dev-java/openjdk-bin"
RDEPEND="dev-java/openjdk-bin"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "gradle installed successfully"
}
