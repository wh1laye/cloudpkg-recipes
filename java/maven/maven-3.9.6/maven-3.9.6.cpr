PACKAGE=maven
VERSION=3.9.6
CATEGORY=.
DESCRIPTION="Java project management tool"
HOMEPAGE="https://maven.apache.org/"
LICENSE="Apache-2.0"
SRC_URI="https://archive.apache.org/dist/maven/maven-3/3.9.6/binaries/apache-maven-3.9.6-bin.tar.gz -> maven-3.9.6.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    true
}

src_install() {
    install -d "${D}/opt" "${D}/usr/bin" && cp -a . "${D}/opt/apache-maven-3.9.6" && ln -s /opt/apache-maven-3.9.6/bin/mvn "${D}/usr/bin/mvn"
}
