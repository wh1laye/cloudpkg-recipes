PACKAGE=dash
VERSION=0.5.12
CATEGORY=.
DESCRIPTION="Debian Almquist shell - POSIX compliant shell"
HOMEPAGE="http://gondor.apana.org.au/~herbert/dash/"
LICENSE="BSD-3"
SRC_URI="https://gondor.apana.org.au/~herbert/dash/files/dash-0.5.12.tar.gz -> dash-0.5.12.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
