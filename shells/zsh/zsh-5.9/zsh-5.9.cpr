PACKAGE=zsh
VERSION=5.9
CATEGORY=.
DESCRIPTION="Z Shell - powerful command interpreter"
HOMEPAGE="https://www.zsh.org/"
LICENSE="MIT"
SRC_URI="https://downloads.sourceforge.net/project/zsh/zsh/5.9/zsh-5.9.tar.xz -> zsh-5.9.tar.xz"
DEPEND="sys-libs/ncurses sys-libs/pcre"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-zshenv --enable-multibyte"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j$(nproc) || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
