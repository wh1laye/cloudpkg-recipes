PACKAGE=zsh
VERSION=5.9
CATEGORY=.
DESCRIPTION="Z Shell - powerful command interpreter"
HOMEPAGE="https://www.zsh.org/"
LICENSE="MIT"
SRC_URI="https://www.zsh.org/pub/zsh-5.9.tar.xz -> zsh-5.9.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --enable-etcdir=/etc --with-tcsetpgrp
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
