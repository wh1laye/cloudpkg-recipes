PACKAGE=fish
VERSION=3.7.0
CATEGORY=.
DESCRIPTION="Friendly Interactive SHell"
HOMEPAGE="https://fishshell.com/"
LICENSE="GPL-2"
SRC_URI="https://github.com/fish-shell/fish-shell/releases/download/3.7.0/fish-3.7.0.tar.gz -> fish-3.7.0.tar.gz"
DEPEND="sys-libs/ncurses dev-libs/pcre2"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--disable-gui"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfDESTDIR=/etc \
        --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo " installed successfully"
}
