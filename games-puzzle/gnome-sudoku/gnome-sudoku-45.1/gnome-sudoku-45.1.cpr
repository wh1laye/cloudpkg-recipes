PACKAGE=gnome-sudoku
VERSION=45.1
CATEGORY=games-puzzle
DESCRIPTION="GNOME Sudoku game"
HOMEPAGE="https://wiki.gnome.org/Apps/Sudoku"
LICENSE="GPL-3"
SRC_URI="https://download.gnome.org/sources/gnome-sudoku/45/gnome-sudoku-45.1.tar.xz -> gnome-sudoku-45.1.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "gnome-sudoku installed successfully"
}
