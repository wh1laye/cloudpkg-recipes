PACKAGE=gnome-chess
VERSION=45.2
CATEGORY=games-puzzle
DESCRIPTION="GNOME Chess game"
HOMEPAGE="https://wiki.gnome.org/Apps/Chess"
LICENSE="GPL-3"
SRC_URI="https://download.gnome.org/sources/gnome-chess/45/gnome-chess-45.2.tar.xz -> gnome-chess-45.2.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "gnome-chess installed successfully"
}
