PACKAGE=gnome-chess
VERSION=45.2
CATEGORY=.
DESCRIPTION="GNOME Chess game"
HOMEPAGE="https://wiki.gnome.org/Apps/Chess"
LICENSE="GPL-3"
SRC_URI="https://download.gnome.org/sources/gnome-chess/45/gnome-chess-45.2.tar.xz -> gnome-chess-45.2.tar.xz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "gnome-chess installed successfully"
}
