PACKAGE=amavisd
VERSION=2.13.0
CATEGORY=mail-filter
DESCRIPTION="Interface between MTA and virus scanners"
HOMEPAGE="https://example.com/amavisd"
LICENSE="GPL-2"
SRC_URI="https://example.com/amavisd/amavisd-2.13.0.tar.gz -> amavisd-2.13.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
