PACKAGE=vim
VERSION=9.1.0
CATEGORY=.
DESCRIPTION="Vi IMproved text editor"
HOMEPAGE="https://www.vim.org/"
LICENSE="Vim"
SRC_URI="https://github.com/vim/vim/archive/refs/tags/v9.1.0.tar.gz -> vim-9.1.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --with-features=huge --enable-multibyte --disable-gui --without-x
}

src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make DESTDIR="${D}" install
}
