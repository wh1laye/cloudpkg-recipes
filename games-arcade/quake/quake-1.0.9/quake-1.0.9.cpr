PACKAGE=quake
VERSION=1.0.9
CATEGORY=.
DESCRIPTION="Quake game engine"
HOMEPAGE="https://quake.fandom.com/"
LICENSE="GPL-2"
SRC_URI="https://downloads.sourceforge.net/project/quake/quake/1.0.9/quake-1.0.9.tar.gz -> quake-1.0.9.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
