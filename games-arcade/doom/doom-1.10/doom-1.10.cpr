PACKAGE=doom
VERSION=1.10
CATEGORY=.
DESCRIPTION="The classic DOOM game"
HOMEPAGE="https://www.doomworld.com/"
LICENSE="GPL-2"
SRC_URI="https://sourceforge.net/projects/prboom/files/prboom/2.5.0/prboom-2.5.0.tar.gz -> doom-1.10.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "doom installed successfully"
}
