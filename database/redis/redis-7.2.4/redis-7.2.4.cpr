PACKAGE=redis
VERSION=7.2.4
CATEGORY=.
DESCRIPTION="In-memory data structure store"
HOMEPAGE="https://redis.io/"
LICENSE="BSD-3"
SRC_URI="https://download.redis.io/releases/redis-7.2.4.tar.gz -> redis-7.2.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "redis installed successfully"
}
