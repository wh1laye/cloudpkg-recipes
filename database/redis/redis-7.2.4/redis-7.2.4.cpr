PACKAGE=redis
VERSION=7.2.4
CATEGORY=.
DESCRIPTION="In-memory data structure store"
HOMEPAGE="https://redis.io/"
LICENSE="BSD-3"
SRC_URI="https://github.com/redis/redis/archive/refs/tags/7.2.4.tar.gz -> redis-7.2.4.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"


src_compile() {
    make -j"${JOBS:-1}"
}

src_install() {
    make PREFIX="${D}/usr" install
}
