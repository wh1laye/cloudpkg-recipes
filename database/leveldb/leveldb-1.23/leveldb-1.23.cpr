PACKAGE=leveldb
VERSION=1.23
CATEGORY=.
DESCRIPTION="Fast key-value storage library"
HOMEPAGE="https"
LICENSE="//github.com/google/leveldb"
SRC_URI="BSD-3 -> leveldb-1.23.tar.gz"
DEPEND="https://github.com/google/leveldb/archive/refs/tags/1.23.tar.gz:libs/snappy"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
