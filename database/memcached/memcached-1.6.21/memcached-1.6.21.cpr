PACKAGE=memcached
VERSION=1.6.21
CATEGORY=.
DESCRIPTION="Memory caching system"
HOMEPAGE="https"
LICENSE="//memcached.org/"
SRC_URI="BSD-2 -> memcached-1.6.21.tar.gz"
DEPEND="https://github.com/memcached/memcached/archive/refs/tags/1.6.21.tar.gz:libs/libevent"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
