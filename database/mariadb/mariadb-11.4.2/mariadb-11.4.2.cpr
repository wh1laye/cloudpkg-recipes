PACKAGE=mariadb
VERSION=11.4.2
CATEGORY=.
DESCRIPTION="MariaDB database server"
HOMEPAGE="https://mariadb.org/"
LICENSE="GPL-2"
SRC_URI="https://downloads.mariadb.org/f/mariadb-11.4.2/source/mariadb-11.4.2.tar.gz -> mariadb-11.4.2.tar.gz"
DEPEND="sys-libs/zlib dev-libs/openssl"
RDEPEND="sys-libs/zlib dev-libs/openssl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "mariadb installed successfully"
}
