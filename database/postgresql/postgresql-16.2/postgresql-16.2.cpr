PACKAGE=postgresql
VERSION=16.2
CATEGORY=.
DESCRIPTION="PostgreSQL database server"
HOMEPAGE="https://www.postgresql.org/"
LICENSE="PostgreSQL"
SRC_URI="https://ftp.postgresql.org/pub/source/v16.2/postgresql-16.2.tar.gz -> postgresql-16.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var/lib/postgresql --enable-thread-safety --without-icu
}
src_compile() {
    make -j"${JOBS:-1}"
}
src_install() {
    make DESTDIR="${D}" install
}
