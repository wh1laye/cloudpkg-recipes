PACKAGE=mongodb
VERSION=7.0.4
CATEGORY=.
DESCRIPTION="MongoDB document database"
HOMEPAGE="https"
LICENSE="//www.mongodb.org/"
SRC_URI="AGPL-3.0 -> mongodb-7.0.4.tar.gz"
DEPEND="https://fastdl.mongodb.org/src/mongodb-src-r7.0.4.tar.gz:libs/openssl libs/boost"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
