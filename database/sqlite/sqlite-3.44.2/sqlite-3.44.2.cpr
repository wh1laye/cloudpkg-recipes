PACKAGE=sqlite
VERSION=3.44.2
CATEGORY=.
DESCRIPTION="SQL database engine in a C library"
HOMEPAGE="https://www.sqlite.org/"
LICENSE="Public-Domain"
SRC_URI="https://www.sqlite.org/2024/sqlite-autoconf-3440200.tar.gz -> sqlite-3.44.2.tar.gz"
DEPEND="dev-libs/readline"
RDEPEND="dev-libs/readline"
SLOT=3
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "sqlite installed successfully"
}
