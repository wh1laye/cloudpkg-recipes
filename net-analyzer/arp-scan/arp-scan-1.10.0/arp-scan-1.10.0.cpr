PACKAGE=arp-scan
VERSION=1.10.0
CATEGORY=net-analyzer
DESCRIPTION="ARP scanning tool"
HOMEPAGE="https://example.com/arp-scan"
LICENSE="GPL-3"
SRC_URI="https://example.com/arp-scan/arp-scan-1.10.0.tar.gz -> arp-scan-1.10.0.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"

src_compile() {
    make -j\(nproc\) || die
}

src_install() {
    make DESTDIR="\(D\)" install || die
}
