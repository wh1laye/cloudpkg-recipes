PACKAGE=nmap
VERSION=7.95
CATEGORY=net-analyzer
DESCRIPTION="Network mapper and port scanner"
HOMEPAGE="https://nmap.org/"
LICENSE="GPL-2"
SRC_URI="https://nmap.org/dist/nmap-7.95.tar.bz2 -> nmap-7.95.tar.bz2"
DEPEND="dev-libs/openssl dev-libs/libpcre"
RDEPEND="dev-libs/openssl dev-libs/libpcre"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "nmap installed successfully"
}
