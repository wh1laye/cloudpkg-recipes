PACKAGE=zmap
VERSION=2.1.1
CATEGORY=net-analyzer
DESCRIPTION="Internet-wide network scanner"
HOMEPAGE="https://zmap.io/"
LICENSE="Apache-2.0"
SRC_URI="https://github.com/zmap/zmap/archive/refs/tags/v2.1.1.tar.gz -> zmap-2.1.1.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "zmap installed successfully"
}
