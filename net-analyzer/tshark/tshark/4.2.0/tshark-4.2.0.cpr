PACKAGE=tshark
VERSION=4.2.0
CATEGORY=.
DESCRIPTION="Network protocol analyzer"
HOMEPAGE="https://www.wireshark.org/"
LICENSE="GPL-2"
SRC_URI="https://1.as.dl.wireshark.org/src/wireshark-4.2.0.tar.gz -> tshark-4.2.0.tar.gz"
DEPEND="net-analyzer/wireshark"
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j"${JOBS:-$(nproc)}" || exit 1
}
src_install() {
    make DESTDIR="${D}" install || exit 1
}
