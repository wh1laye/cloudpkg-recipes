PACKAGE=masscan
VERSION=1.3.2
CATEGORY=net-analyzer
DESCRIPTION="TCP port scanner"
HOMEPAGE="https://github.com/robertdavidgraham/masscan"
LICENSE="AGPL-3"
SRC_URI="https://github.com/robertdavidgraham/masscan/archive/refs/tags/1.3.2.tar.gz -> masscan-1.3.2.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "masscan installed successfully"
}
