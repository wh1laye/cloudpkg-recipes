PACKAGE=ioquake3
VERSION=1.36
CATEGORY=.
DESCRIPTION="Open source FPS engine"
HOMEPAGE="https://ioquake3.org/"
LICENSE="GPL-2"
SRC_URI="https://github.com/ioquake/ioq3/archive/refs/tags/1.36.tar.gz -> ioquake3-1.36.tar.gz"
DEPEND=""
RDEPEND=""
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfDESTDIR=/etc --localstateDESTDIR=/var
}
src_compile() {
    make -j\(nproc\) || exit 1
}
src_install() {
    make DESTDIR="\(D\)" install || exit 1
    install -Dm644 README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    echo "ioquake3 installed successfully"
}
