PACKAGE=lighttpd
VERSION=1.4.75
CATEGORY=net-http
DESCRIPTION="Lightweight web server"
HOMEPAGE="https://www.lighttpd.net/"
LICENSE="BSD-3"
SRC_URI="https://download.lighttpd.net/lighttpd/releases-1.4.x/lighttpd-1.4.75.tar.gz -> lighttpd-1.4.75.tar.gz"
DEPEND="sys-libs/zlib sys-libs/pcre dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-openssl --with-zlib --with-pcre"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
