PACKAGE=nginx
VERSION=1.25.3
CATEGORY=net-http
DESCRIPTION="High-performance web server"
HOMEPAGE="https://nginx.org/"
LICENSE="BSD-2"
SRC_URI="https://nginx.org/download/nginx-1.25.3.tar.gz -> nginx-1.25.3.tar.gz"
DEPEND="sys-libs/zlib sys-libs/pcre dev-libs/openssl"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--with-http_ssl_module --with-http_gzip_static_module"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
