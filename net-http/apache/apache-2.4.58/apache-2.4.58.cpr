PACKAGE=apache
VERSION=2.4.58
CATEGORY=net-http
DESCRIPTION="Apache HTTP Server"
HOMEPAGE="https://httpd.apache.org/"
LICENSE="Apache-2.0"
SRC_URI="https://downloads.apache.org/httpd/httpd-2.4.58.tar.gz -> apache-2.4.58.tar.gz"
DEPEND="dev-libs/apr dev-libs/apr-util"
RDEPEND="
SLOT=0
KEYWORDS="amd64"
BUILD_FLAGS="--enable-mods-shared=most --enable-mpms-shared=all"
src_configure() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var
}
src_compile() {
    make -j$(nproc) || die "Compilation failed"
}
src_install() {
    make DESTDIR="${D}" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo " installed successfully"
}
