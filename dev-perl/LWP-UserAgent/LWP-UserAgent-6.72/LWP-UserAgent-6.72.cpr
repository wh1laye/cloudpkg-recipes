PACKAGE=LWP-UserAgent
VERSION=6.72
CATEGORY=dev-perl
DESCRIPTION="Simple HTTP user agent"
HOMEPAGE="https://metacpan.org/pod/LWP::UserAgent"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/E/ET/ETHER/LWP-UserAgent-6.72.tar.gz -> LWP-UserAgent-6.72.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "LWP-UserAgent installed successfully"
}
