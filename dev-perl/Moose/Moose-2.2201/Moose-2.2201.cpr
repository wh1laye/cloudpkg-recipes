PACKAGE=Moose
VERSION=2.2201
CATEGORY=dev-perl
DESCRIPTION="Postmodern object system for Perl"
HOMEPAGE="https://metacpan.org/pod/Moose"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/E/ET/ETHER/Moose-2.2201.tar.gz -> Moose-2.2201.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "Moose installed successfully"
}
