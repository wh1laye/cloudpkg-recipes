PACKAGE=Try-Tiny
VERSION=0.31
CATEGORY=dev-perl
DESCRIPTION="Minimal try/catch with proper localization"
HOMEPAGE="https://metacpan.org/pod/Try::Tiny"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/E/ET/ETHER/Try-Tiny-0.31.tar.gz -> Try-Tiny-0.31.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "Try-Tiny installed successfully"
}
