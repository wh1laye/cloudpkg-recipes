PACKAGE=DBI
VERSION=1.643
CATEGORY=dev-perl
DESCRIPTION="Perl Database Interface"
HOMEPAGE="https://dbi.perl.org/"
LICENSE="Artistic GPL-1"
SRC_URI="https://cpan.metacpan.org/authors/id/T/TI/TIMB/DBI-1.643.tar.gz -> DBI-1.643.tar.gz"
DEPEND="dev-lang/perl"
RDEPEND="dev-lang/perl"
SLOT=0
KEYWORDS="amd64"
src_configure() {
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
}
src_compile() {
    make -j\(nproc\) || die "Compilation failed"
}
src_install() {
    make DESTDIR="\(D\)" install || die "Installation failed"
    dodoc README* CHANGELOG* LICENSE*
}
pkg_postinst() {
    einfo "DBI installed successfully"
}
